{
  "id": "ch03_s01_shuge",
  "chapter": 3,
  "act": 3,
  "scene": "shuge",
  "palette": "gold",
  "cast": [
    "wuze",
    "shenheng",
    "tangjian"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "决定自己的不利材料是否和荐文一同交给复核人",
  "lines": [
    {
      "id": "ch03_s01_shuge.l1",
      "who": "tiji",
      "kind": "aside",
      "text": "候选名单送下后的次晨，书阁又开了门。"
    },
    {
      "id": "ch03_s01_shuge.l2",
      "who": "tiji",
      "kind": "aside",
      "text": "非宗室的名字列进来了；与它并列的，是李令仪。"
    },
    {
      "id": "ch03_s01_shuge.l3",
      "who": "narr",
      "kind": "aside",
      "text": "荐卷少了一页。窗纸透着白光，抽出的那页压在镇尺底下。"
    },
    {
      "id": "ch03_s01_shuge.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "谁抽的？"
    },
    {
      "id": "ch03_s01_shuge.l5",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "管荐卷的人想先抽掉这一页。她写了来由，也署了名。"
    },
    {
      "id": "ch03_s01_shuge.l6",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "她为什么要抽掉？"
    },
    {
      "id": "ch03_s01_shuge.l7",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "她说，放进这页，复查的人看见了会迟疑。"
    },
    {
      "id": "ch03_s01_shuge.l8",
      "who": "narr",
      "kind": "aside",
      "text": "唐简翻开她送来的说明，指着落款。沈衡没有挪开镇尺。"
    },
    {
      "id": "ch03_s01_shuge.l9",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这一页写了我什么？"
    },
    {
      "id": "ch03_s01_shuge.l10",
      "who": "shenheng",
      "expr": "guarded",
      "kind": "say",
      "text": "你没问过阿荻，就把她的私话写进呈文；补的说明也迟了。"
    },
    {
      "id": "ch03_s01_shuge.l11",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "我急着递上去，没等她答应。"
    },
    {
      "id": "ch03_s01_shuge.l12",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "这段反对的话，是你写的？"
    },
    {
      "id": "ch03_s01_shuge.l13",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "是。"
    },
    {
      "id": "ch03_s01_shuge.l14",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "反对的话里，也留了我办错的那一处。"
    },
    {
      "id": "ch03_s01_shuge.l15",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那就不能只删掉对我不利的。"
    },
    {
      "id": "ch03_s01_shuge.l16",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "原件必须留下，不能撤走。"
    },
    {
      "id": "ch03_s01_shuge.l17",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "留下原件，这回先不送呢？"
    },
    {
      "id": "ch03_s01_shuge.l18",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我还想补些——"
    },
    {
      "id": "ch03_s01_shuge.l19",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "先听完。"
    },
    {
      "id": "ch03_s01_shuge.l20",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "可以连着荐卷一起送，也可等你补证，注明还没查清。"
    },
    {
      "id": "ch03_s01_shuge.l21",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "补证以后再送？"
    },
    {
      "id": "ch03_s01_shuge.l22",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "要等多久？"
    },
    {
      "id": "ch03_s01_shuge.l23",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "查证的人明日就离开衙署。"
    },
    {
      "id": "ch03_s01_shuge.l24",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "今天不送，就赶不上她们？"
    },
    {
      "id": "ch03_s01_shuge.l25",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "等你补齐，只来得及收件，最后议定前查不完。"
    },
    {
      "id": "ch03_s01_shuge.l26",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "证人的私事已隐去。她没准公开的，我没写进去。"
    },
    {
      "id": "ch03_s01_shuge.l27",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这部分别再动。"
    },
    {
      "id": "ch03_s01_shuge.l28",
      "who": "self",
      "kind": "inner",
      "text": "（留下这页，她们会犹豫。抽走，就只看见夸我的话。）"
    },
    {
      "id": "ch03_s01_shuge.l29",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我想……补一段，说清当时为何急。"
    },
    {
      "id": "ch03_s01_shuge.l30",
      "who": "shenheng",
      "expr": "guarded",
      "kind": "say",
      "text": "可以另补一段，不能拿它换掉这页反对的话。"
    },
    {
      "id": "ch03_s01_shuge.l31",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "两份都得让她们看见。"
    },
    {
      "id": "ch03_s01_shuge.l32",
      "who": "narr",
      "kind": "aside",
      "text": "镇尺底下露着一个“晚”字。你把拇指从字上拿开。"
    },
    {
      "id": "ch03_s01_shuge.l33",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "提出抽页的人，要在经手簿上留下名字。"
    },
    {
      "id": "ch03_s01_shuge.l34",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我也得答复她。"
    },
    {
      "id": "ch03_s01_shuge.l35",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "这页留不留，你也要签名。不能只让她担着。"
    },
    {
      "id": "ch03_s01_shuge.l36",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "两份都给我。"
    },
    {
      "id": "ch03_s01_shuge.l37",
      "who": "empty",
      "kind": "aside",
      "text": "旧景·上巳。水边一只柳圈搁在石上，细浪沾湿了梢头。",
      "image": "wu_shangsi_liuquan"
    },
    {
      "id": "ch03_s01_shuge.l38",
      "who": "narr",
      "kind": "aside",
      "text": "眼前，你把解释当时缘由的补答放到原页旁，等着决定何时送查。"
    }
  ],
  "choices": [
    {
      "id": "ch03_s01_shuge.cA",
      "text": "反对的话和我的说明一起送查",
      "effects": {
        "flag.ch03_objection_public": true
      },
      "irreversible": true,
      "goto": "ch03_s02_shuge"
    },
    {
      "id": "ch03_s01_shuge.cB",
      "text": "先补证再公开，错过本轮查证",
      "effects": {
        "flag.ch03_objection_deferred": true
      },
      "irreversible": true,
      "goto": "ch03_s02_shuge"
    }
  ]
}
