{
  "id": "ch03_s01_shuge",
  "chapter": 3,
  "act": 3,
  "scene": "shuge",
  "palette": "gold",
  "cast": [
    "wuze",
    "shenheng",
    "tangjian"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "决定自己的不利材料是否和荐文一同交给复核人",
  "lines": [
    {
      "id": "ch03_s01_shuge.l1",
      "who": "tiji",
      "kind": "aside",
      "text": "候选名单送下后的次晨，书阁又开了门。"
    },
    {
      "id": "ch03_s01_shuge.l2",
      "who": "tiji",
      "kind": "aside",
      "text": "非宗室的名字列进来了；与它并列的，是李令仪。"
    },
    {
      "id": "ch03_s01_shuge.l3",
      "who": "narr",
      "kind": "aside",
      "text": "荐卷少了一页。窗纸透着白光，抽出的那页压在镇尺底下。"
    },
    {
      "id": "ch03_s01_shuge.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "谁抽的？"
    },
    {
      "id": "ch03_s01_shuge.l5",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "荐署掌案请求暂撤这一页，来牒上署了她自己的名。"
    },
    {
      "id": "ch03_s01_shuge.l6",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "暂撤？"
    },
    {
      "id": "ch03_s01_shuge.l7",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "说是放进这一页，复核的人会迟疑。"
    },
    {
      "id": "ch03_s01_shuge.l8",
      "who": "narr",
      "kind": "aside",
      "text": "唐把来牒翻到落款。沈没有替你把镇尺挪开。"
    },
    {
      "id": "ch03_s01_shuge.l9",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "她替我省了哪一句？"
    },
    {
      "id": "ch03_s01_shuge.l10",
      "who": "shenheng",
      "expr": "guarded",
      "kind": "say",
      "text": "擅引未获许可的私话，补牒又晚了。"
    },
    {
      "id": "ch03_s01_shuge.l11",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "晚了。"
    },
    {
      "id": "ch03_s01_shuge.l12",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "字是你的。"
    },
    {
      "id": "ch03_s01_shuge.l13",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "是。"
    },
    {
      "id": "ch03_s01_shuge.l14",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "驳语里也留了我的错。"
    },
    {
      "id": "ch03_s01_shuge.l15",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你的错。"
    },
    {
      "id": "ch03_s01_shuge.l16",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "原件不能撤。"
    },
    {
      "id": "ch03_s01_shuge.l17",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不能撤。"
    },
    {
      "id": "ch03_s01_shuge.l18",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我再——"
    },
    {
      "id": "ch03_s01_shuge.l19",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "先听完。"
    },
    {
      "id": "ch03_s01_shuge.l20",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "可以附入本轮，也可补证，留待核标记。"
    },
    {
      "id": "ch03_s01_shuge.l21",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s01_shuge.l22",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "后一种要等多久？"
    },
    {
      "id": "ch03_s01_shuge.l23",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "核证人明日出署。"
    },
    {
      "id": "ch03_s01_shuge.l24",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "明日。"
    },
    {
      "id": "ch03_s01_shuge.l25",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "这回不送，终议前只够收件，核不完签。"
    },
    {
      "id": "ch03_s01_shuge.l26",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "证人的细节已隐去，没准公开的都没写。"
    },
    {
      "id": "ch03_s01_shuge.l27",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch03_s01_shuge.l28",
      "who": "self",
      "kind": "inner",
      "text": "（留下会迟疑。抽走，他们先读的就是荐我的话。）"
    },
    {
      "id": "ch03_s01_shuge.l29",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我想……补一段，说清当时为何急。"
    },
    {
      "id": "ch03_s01_shuge.l30",
      "who": "shenheng",
      "expr": "guarded",
      "kind": "say",
      "text": "可以补，不能拿它换这一页。"
    },
    {
      "id": "ch03_s01_shuge.l31",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "这一页。"
    },
    {
      "id": "ch03_s01_shuge.l32",
      "who": "narr",
      "kind": "aside",
      "text": "镇尺底下露着一个“晚”字。你把拇指从字上拿开。"
    },
    {
      "id": "ch03_s01_shuge.l33",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "掌案须留在经手簿上。"
    },
    {
      "id": "ch03_s01_shuge.l34",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "是。"
    },
    {
      "id": "ch03_s01_shuge.l35",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "准不准她抽，你也得署答，不能只记她。"
    },
    {
      "id": "ch03_s01_shuge.l36",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "两份都给我。"
    },
    {
      "id": "ch03_s01_shuge.l37",
      "who": "narr",
      "kind": "aside",
      "text": "你把补答与原页并放，等着定下交核之时。"
    }
  ],
  "choices": [
    {
      "id": "ch03_s01_shuge.cA",
      "text": "不利页与补答一同交核",
      "effects": {
        "flag.ch03_objection_public": true
      },
      "irreversible": true,
      "goto": "ch03_s02_shuge"
    },
    {
      "id": "ch03_s01_shuge.cB",
      "text": "暂缓公开，先补证",
      "effects": {
        "flag.ch03_objection_deferred": true
      },
      "irreversible": true,
      "goto": "ch03_s02_shuge"
    }
  ]
}
