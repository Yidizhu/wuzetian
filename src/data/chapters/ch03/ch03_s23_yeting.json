{
  "id": "ch03_s23_yeting",
  "chapter": 3,
  "act": 3,
  "scene": "yeting",
  "palette": "ink",
  "cast": [
    "liuchenghuan"
  ],
  "weightless": true,
  "leavesLetter": [],
  "purpose": "柳一人挪动鞋尖，没有人等她做成什么",
  "lines": [
    {
      "id": "ch03_s23_yeting.l1",
      "who": "narr",
      "kind": "aside",
      "text": "窗格漏下一块方光，照在柳的鞋边。"
    },
    {
      "id": "ch03_s23_yeting.l2",
      "who": "narr",
      "kind": "aside",
      "text": "她把脚往前伸了一点。"
    },
    {
      "id": "ch03_s23_yeting.l3",
      "who": "narr",
      "kind": "aside",
      "text": "光落到鞋尖上，缺了一角。她转过脚踝，又转回去。"
    },
    {
      "id": "ch03_s23_yeting.l4",
      "who": "narr",
      "kind": "aside",
      "text": "另一只鞋碰到了凳脚。"
    },
    {
      "id": "ch03_s23_yeting.l5",
      "who": "narr",
      "kind": "aside",
      "text": "她收回那只脚，让两只鞋分开，光只照着左边。"
    },
    {
      "id": "ch03_s23_yeting.l6",
      "who": "narr",
      "kind": "aside",
      "text": "过了一会儿，方光偏了。"
    },
    {
      "id": "ch03_s23_yeting.l7",
      "who": "narr",
      "kind": "aside",
      "text": "柳把鞋尖挪过去，凳子没有动。"
    }
  ],
  "goto": "ch03_s24_shuge"
}
