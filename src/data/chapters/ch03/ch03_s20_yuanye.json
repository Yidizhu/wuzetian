{
  "id": "ch03_s20_yuanye",
  "chapter": 3,
  "act": 3,
  "scene": "yuanye",
  "palette": "ink",
  "cast": [
    "wuze",
    "liqinghe"
  ],
  "require": {
    "affinity.liqinghe": {
      "gte": 14
    },
    "flag.li_meng_real_competition": true
  },
  "weightless": true,
  "leavesLetter": [],
  "purpose": "两人只说果子的酸甜，不回看谁赢了",
  "lines": [
    {
      "id": "ch03_s20_yuanye.l1",
      "who": "narr",
      "kind": "aside",
      "text": "差务单交清，你坐到李令仪的果碟旁。"
    },
    {
      "id": "ch03_s20_yuanye.l2",
      "who": "narr",
      "kind": "aside",
      "text": "李用帕子擦掉果上的水。擦完一面又转半圈，果底的一个小凹处仍留着水珠。"
    },
    {
      "id": "ch03_s20_yuanye.l3",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那边颜色深。"
    },
    {
      "id": "ch03_s20_yuanye.l4",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "颜色。"
    },
    {
      "id": "ch03_s20_yuanye.l5",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "别先说甜，咬了再说。"
    },
    {
      "id": "ch03_s20_yuanye.l6",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch03_s20_yuanye.l7",
      "who": "narr",
      "kind": "aside",
      "text": "你挑了一只小的，咬到果肉才发现皮厚。李把自己那只转向另一面。"
    },
    {
      "id": "ch03_s20_yuanye.l8",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "还没尝出味，先碰到核。"
    },
    {
      "id": "ch03_s20_yuanye.l9",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "核？"
    },
    {
      "id": "ch03_s20_yuanye.l10",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "你那只……借我看看。"
    },
    {
      "id": "ch03_s20_yuanye.l11",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "看罢，别照颜色断。"
    },
    {
      "id": "ch03_s20_yuanye.l12",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "这边亮——"
    },
    {
      "id": "ch03_s20_yuanye.l13",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "刚擦过。"
    },
    {
      "id": "ch03_s20_yuanye.l14",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s20_yuanye.l15",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "换个面就不亮了。"
    },
    {
      "id": "ch03_s20_yuanye.l16",
      "who": "narr",
      "kind": "aside",
      "text": "她把果举到你面前，自己又咬了一小口。汁沾在手指上，她拿帕角擦掉。"
    },
    {
      "id": "ch03_s20_yuanye.l17",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "怎样？"
    },
    {
      "id": "ch03_s20_yuanye.l18",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "酸。"
    },
    {
      "id": "ch03_s20_yuanye.l19",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "我也是。"
    },
    {
      "id": "ch03_s20_yuanye.l20",
      "who": "narr",
      "kind": "aside",
      "text": "两枚果核并排落在帕角。你们又各拿了一只，谁都没有挑颜色。"
    },
    {
      "id": "ch03_s20_yuanye.l21",
      "who": "narr",
      "kind": "aside",
      "text": "你擦干手上的果汁，起身回观里。"
    }
  ],
  "goto": "ch03_s22_nvguan"
}
