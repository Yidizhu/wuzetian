{
  "id": "ch03_s20_yuanye",
  "chapter": 3,
  "act": 3,
  "scene": "yuanye",
  "palette": "ink",
  "cast": [
    "wuze",
    "liqinghe"
  ],
  "require": {
    "affinity.liqinghe": {
      "gte": 16
    },
    "flag.li_meng_real_competition": true
  },
  "weightless": true,
  "leavesLetter": [],
  "purpose": "两人只说果子的酸甜，不回看谁赢了",
  "lines": [
    {
      "id": "ch03_s20_yuanye.l1",
      "who": "narr",
      "kind": "aside",
      "text": "李用帕子擦掉果上的水。擦完一面又转半圈，果底的一个小凹处仍留着水珠。"
    },
    {
      "id": "ch03_s20_yuanye.l2",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那边颜色深。"
    },
    {
      "id": "ch03_s20_yuanye.l3",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "不先说甜不甜。咬了再说。"
    },
    {
      "id": "ch03_s20_yuanye.l4",
      "who": "narr",
      "kind": "aside",
      "text": "你挑了一只小的，咬到果肉才发现皮厚。李把自己那只转向另一面。"
    },
    {
      "id": "ch03_s20_yuanye.l5",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "我这一口还没咬出味，牙先碰到核。你那只借我看一眼，不换，也不咬你的。"
    },
    {
      "id": "ch03_s20_yuanye.l6",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "看罢。别又照着颜色替它下断语，这边是我刚擦过，换个面也许就不那么亮。"
    },
    {
      "id": "ch03_s20_yuanye.l7",
      "who": "narr",
      "kind": "aside",
      "text": "她把果举到你面前，自己又咬了一小口。汁沾在手指上，她拿帕角擦掉。"
    },
    {
      "id": "ch03_s20_yuanye.l8",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "怎样？"
    },
    {
      "id": "ch03_s20_yuanye.l9",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "酸。"
    },
    {
      "id": "ch03_s20_yuanye.l10",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "我也是。"
    },
    {
      "id": "ch03_s20_yuanye.l11",
      "who": "narr",
      "kind": "aside",
      "text": "两枚果核并排落在帕角。你们又各拿了一只，谁都没有挑颜色。"
    }
  ],
  "goto": "ch03_s22_nvguan"
}
