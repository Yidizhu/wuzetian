{
  "id": "ch03_s18_yuanye",
  "chapter": 3,
  "act": 3,
  "scene": "yuanye",
  "palette": "ink",
  "cast": [
    "wuze",
    "peizhaoye"
  ],
  "require": {
    "affinity.peizhaoye": {
      "gte": 14
    },
    "flag.pei_meng_no_troops": true
  },
  "weightless": true,
  "leavesLetter": [],
  "purpose": "两人各自打盹，争一声鸟叫与一次翻身的先后",
  "lines": [
    {
      "id": "ch03_s18_yuanye.l1",
      "who": "narr",
      "kind": "aside",
      "text": "差务单交清，你去苑里与裴照夜各坐一头。"
    },
    {
      "id": "ch03_s18_yuanye.l2",
      "who": "narr",
      "kind": "aside",
      "text": "苑中树影盖住半条长凳。裴坐一头，你坐一头，中间落了两枚干果壳。"
    },
    {
      "id": "ch03_s18_yuanye.l3",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "你先动的。"
    },
    {
      "id": "ch03_s18_yuanye.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我？"
    },
    {
      "id": "ch03_s18_yuanye.l5",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "鸟先叫的。"
    },
    {
      "id": "ch03_s18_yuanye.l6",
      "who": "narr",
      "kind": "aside",
      "text": "裴抬头找了一会儿，鸟在她头顶换了根枝。她把头靠回树干上。"
    },
    {
      "id": "ch03_s18_yuanye.l7",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "先响凳子，后叫鸟。"
    },
    {
      "id": "ch03_s18_yuanye.l8",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "凳子。"
    },
    {
      "id": "ch03_s18_yuanye.l9",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "你没翻身，就是它睡不稳。"
    },
    {
      "id": "ch03_s18_yuanye.l10",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "那算它。我梦见一根枝，够不着。"
    },
    {
      "id": "ch03_s18_yuanye.l11",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "枝？"
    },
    {
      "id": "ch03_s18_yuanye.l12",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "还以为……不在这儿。"
    },
    {
      "id": "ch03_s18_yuanye.l13",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "还够不够？"
    },
    {
      "id": "ch03_s18_yuanye.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch03_s18_yuanye.l15",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不够了，脖子酸。我再——"
    },
    {
      "id": "ch03_s18_yuanye.l16",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "换这边。"
    },
    {
      "id": "ch03_s18_yuanye.l17",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s18_yuanye.l18",
      "who": "narr",
      "kind": "aside",
      "text": "你换了个朝向。裴伸腿避开凳脚，又将靴跟落回草里。"
    },
    {
      "id": "ch03_s18_yuanye.l19",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "这回是你。"
    },
    {
      "id": "ch03_s18_yuanye.l20",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "是。"
    },
    {
      "id": "ch03_s18_yuanye.l21",
      "who": "narr",
      "kind": "aside",
      "text": "树上的鸟叫了一声。你们都没有抬头。"
    },
    {
      "id": "ch03_s18_yuanye.l22",
      "who": "narr",
      "kind": "aside",
      "text": "你把手拢在袖里，坐到该回观里的时候。"
    }
  ],
  "goto": "ch03_s22_nvguan"
}
