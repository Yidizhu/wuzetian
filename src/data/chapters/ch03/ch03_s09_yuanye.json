{
  "id": "ch03_s09_yuanye",
  "chapter": 3,
  "act": 3,
  "scene": "yuanye",
  "palette": "ink",
  "cast": [
    "wuze",
    "liqinghe"
  ],
  "weightless": false,
  "leavesLetter": [
    "liqinghe"
  ],
  "purpose": "李不撤选也不求让位，今夜的同行另问一次",
  "lines": [
    {
      "id": "ch03_s09_yuanye.l1",
      "who": "narr",
      "kind": "aside",
      "text": "几份支出留在案上，你走到苑中的石凳前。"
    },
    {
      "id": "ch03_s09_yuanye.l2",
      "who": "narr",
      "kind": "aside",
      "text": "苑中枯叶堆在石凳一端。李坐另一端，双脚踩着自己的外袍下摆。"
    },
    {
      "id": "ch03_s09_yuanye.l3",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "衣裳要被你踩坏了。"
    },
    {
      "id": "ch03_s09_yuanye.l4",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "松开灌风。今日不讲究。"
    },
    {
      "id": "ch03_s09_yuanye.l5",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch03_s09_yuanye.l6",
      "who": "narr",
      "kind": "aside",
      "text": "你替她拣去一片带刺的叶梗。她抬脚，袍角被你抽出来半寸。"
    },
    {
      "id": "ch03_s09_yuanye.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "方才你替我说了代递的长处。"
    },
    {
      "id": "ch03_s09_yuanye.l8",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "账上有，隐去也在。"
    },
    {
      "id": "ch03_s09_yuanye.l9",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s09_yuanye.l10",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "明日我还是要争，我的两处轮值也确实已经开门。"
    },
    {
      "id": "ch03_s09_yuanye.l11",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我没有请你撤。"
    },
    {
      "id": "ch03_s09_yuanye.l12",
      "who": "liqinghe",
      "expr": "guarded",
      "kind": "say",
      "text": "我知道。"
    },
    {
      "id": "ch03_s09_yuanye.l13",
      "who": "liqinghe",
      "expr": "guarded",
      "kind": "say",
      "text": "怕今晚走完，明日听我争，你又疼一下。"
    },
    {
      "id": "ch03_s09_yuanye.l14",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "争。"
    },
    {
      "id": "ch03_s09_yuanye.l15",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你若输了，最舍不得什么？"
    },
    {
      "id": "ch03_s09_yuanye.l16",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "肯先来当值的人。"
    },
    {
      "id": "ch03_s09_yuanye.l17",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "当值的？"
    },
    {
      "id": "ch03_s09_yuanye.l18",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "合署的钱批了，她们才辞旧差，如今又悬着。"
    },
    {
      "id": "ch03_s09_yuanye.l19",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "你答应过她们？"
    },
    {
      "id": "ch03_s09_yuanye.l20",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "说我能争下来。说得太满。"
    },
    {
      "id": "ch03_s09_yuanye.l21",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch03_s09_yuanye.l22",
      "who": "narr",
      "kind": "aside",
      "text": "她从袍角抽出一截松线，绕了一圈，没有扯断。"
    },
    {
      "id": "ch03_s09_yuanye.l23",
      "who": "liqinghe",
      "expr": "guarded",
      "kind": "say",
      "text": "上回撤署那人，替我藏过一只坏风筝。"
    },
    {
      "id": "ch03_s09_yuanye.l24",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "风筝。"
    },
    {
      "id": "ch03_s09_yuanye.l25",
      "who": "liqinghe",
      "expr": "guarded",
      "kind": "say",
      "text": "小时候的，我还没还她。"
    },
    {
      "id": "ch03_s09_yuanye.l26",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "还回去，她也未必回头。"
    },
    {
      "id": "ch03_s09_yuanye.l27",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "嗯。线早补好了。"
    },
    {
      "id": "ch03_s09_yuanye.l28",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "补好了。"
    },
    {
      "id": "ch03_s09_yuanye.l29",
      "who": "self",
      "kind": "inner",
      "text": "（她也有一件东西，修好了，仍送不出去。）"
    },
    {
      "id": "ch03_s09_yuanye.l30",
      "who": "narr",
      "kind": "aside",
      "text": "李起身，把外袍重新披在自己肩上。衣领被风卷进去，她伸手理了两次。"
    },
    {
      "id": "ch03_s09_yuanye.l31",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我以为这袍子——"
    },
    {
      "id": "ch03_s09_yuanye.l32",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "我也冷。"
    },
    {
      "id": "ch03_s09_yuanye.l33",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "也是。"
    },
    {
      "id": "ch03_s09_yuanye.l34",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "你冷不冷？"
    },
    {
      "id": "ch03_s09_yuanye.l35",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "冷。"
    },
    {
      "id": "ch03_s09_yuanye.l36",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "冷。"
    },
    {
      "id": "ch03_s09_yuanye.l37",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "各自穿好，走到有灯的地方。"
    },
    {
      "id": "ch03_s09_yuanye.l38",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s09_yuanye.l39",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "路上不问答卷。"
    },
    {
      "id": "ch03_s09_yuanye.l40",
      "who": "narr",
      "kind": "aside",
      "text": "她将自己的领口扣好，站在两步以外。那条松线留在你刚才坐过的石上。"
    },
    {
      "id": "ch03_s09_yuanye.l41",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "旧邀照旧答。今夜……另问。"
    },
    {
      "id": "ch03_s09_yuanye.l42",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "另问。"
    },
    {
      "id": "ch03_s09_yuanye.l43",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "你不走，也不拿它答明日。"
    },
    {
      "id": "ch03_s09_yuanye.l44",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "明日各争各的。赢不算更肯爱，输不用赔。"
    }
  ],
  "choices": [
    {
      "id": "ch03_s09_yuanye.cA",
      "text": "一起走。明日照实争",
      "effects": {
        "affinity.liqinghe": 3,
        "flag.li_meng_real_competition": true,
        "flag.li_ch03_walk": true
      },
      "irreversible": false,
      "goto": "ch03_s10_nvguan"
    },
    {
      "id": "ch03_s09_yuanye.cB",
      "text": "今夜各回。明日照实争",
      "effects": {
        "affinity.liqinghe": 3,
        "flag.li_meng_real_competition": true,
        "flag.li_ch03_apart": true
      },
      "irreversible": false,
      "goto": "ch03_s10_nvguan"
    }
  ]
}
