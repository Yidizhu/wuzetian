      "when": {
        "flag.ch03_plan_full": true,
        "flag.ch03_objection_public": true
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "今次是我得了两项。"
    },
    {
      "id": "ch03_s11_hanyuan.l79",
      "when": {
        "flag.ch03_plan_full": true,
