    {
      "id": "ch03_s11_hanyuan.l81",
      "when": {
        "flag.ch03_plan_full": true,
        "flag.ch03_objection_deferred": true
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "三项都支持我，没办完的仍要记。"
    },
    {
      "id": "ch03_s11_hanyuan.l82",
      "when": {
        "flag.ch03_plan_full": true,
        "flag.ch03_objection_deferred": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "三位已署名奏请授位，陛下看过了。"
    },
    {
      "id": "ch03_s11_hanyuan.l83",
      "who": "narr",
      "kind": "aside",
      "text": "御席前的授位制书交到唐手里。殿中静下来，只有展开纸卷的响声。"
    },
    {
      "id": "ch03_s11_hanyuan.l84",
      "when": {
        "flag.ch03_evidence_majority": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "奉诏授{名}承位。请亲口答，受不受。"
    },
    {
      "id": "ch03_s11_hanyuan.l85",
      "when": {
        "flag.ch03_evidence_majority": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我……"
