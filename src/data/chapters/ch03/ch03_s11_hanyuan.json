      "id": "ch03_s11_hanyuan.l88",
      "when": {
        "flag.ch03_evidence_majority": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "你收回手，将差牌系回腰间，抬眼等下一句。"
    },
    {
      "id": "ch03_s11_hanyuan.l89",
      "when": {
        "flag.ch03_evidence_majority": false
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "奉诏授李令仪承位。请亲口答，受不受。"
    },
    {
      "id": "ch03_s11_hanyuan.l90",
      "when": {
        "flag.ch03_evidence_majority": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
