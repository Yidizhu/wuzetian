    {
      "id": "ch03_s11_hanyuan.l91",
      "when": {
        "flag.ch03_evidence_majority": false
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "受。钱还没拨到、查错还没试完的，照今日说的继续办。"
    },
    {
      "id": "ch03_s11_hanyuan.l92",
      "when": {
        "flag.ch03_evidence_majority": true
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "我输的那项照样记。你受不受位，都不能改掉这次比较。"
    },
    {
      "id": "ch03_s11_hanyuan.l93",
      "when": {
        "flag.ch03_evidence_majority": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "赢输的理由，都留下。"
    },
    {
      "id": "ch03_s11_hanyuan.l94",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "授位之名读出了。"
    },
    {
      "id": "ch03_s11_hanyuan.l95",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch03_s11_hanyuan.l96",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "受不受，请——"
    },
    {
      "id": "ch03_s11_hanyuan.l97",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "让她自己答。"
    },
    {
      "id": "ch03_s11_hanyuan.l98",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "旁人不能替她说愿意。"
    },
    {
      "id": "ch03_s11_hanyuan.l99",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "是。"
    },
    {
      "id": "ch03_s11_hanyuan.l100",
      "when": {
        "flag.ch03_evidence_majority": true
      },
      "who": "self",
      "kind": "inner",
      "text": "（名已到我这里。还有一个字，要从我口里出去。）"
    },
    {
      "id": "ch03_s11_hanyuan.l101",
      "when": {
        "flag.ch03_evidence_majority": false
      },
      "who": "self",
      "kind": "inner",
      "text": "（她答得很稳。我的手为什么还压着那份提案。）"
    },
    {
      "id": "ch03_s11_hanyuan.l102",
      "who": "narr",
      "kind": "aside",
      "text": "你按住提案，起身等唐问你是否受位。"
    }
