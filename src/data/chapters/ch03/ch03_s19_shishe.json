{
  "id": "ch03_s19_shishe",
  "chapter": 3,
  "act": 3,
  "scene": "shishe",
  "palette": "ink",
  "cast": [
    "wuze",
    "wenqiao"
  ],
  "require": {
    "affinity.wenqiao": {
      "gte": 14
    },
    "flag.wen_meng_no_praise": true
  },
  "weightless": true,
  "leavesLetter": [],
  "purpose": "换几次坐垫找风，不用坐出一句诗",
  "lines": [
    {
      "id": "ch03_s19_shishe.l1",
      "who": "narr",
      "kind": "aside",
      "text": "差务单交清，你到温荞后窗找风。"
    },
    {
      "id": "ch03_s19_shishe.l2",
      "who": "narr",
      "kind": "aside",
      "text": "诗社后窗半开着。温坐到窗边，你搬过另一只坐垫，垫角卷进裙底。"
    },
    {
      "id": "ch03_s19_shishe.l3",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "你那边有风么？"
    },
    {
      "id": "ch03_s19_shishe.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "刚才有。"
    },
    {
      "id": "ch03_s19_shishe.l5",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "刚才。"
    },
    {
      "id": "ch03_s19_shishe.l6",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "我来就没了。"
    },
    {
      "id": "ch03_s19_shishe.l7",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "没了。"
    },
    {
      "id": "ch03_s19_shishe.l8",
      "who": "narr",
      "kind": "aside",
      "text": "温挪到另一边，把半扇窗又推开一些。窗外的晾布鼓起，风没进来。"
    },
    {
      "id": "ch03_s19_shishe.l9",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "别动，我这边又有一点。"
    },
    {
      "id": "ch03_s19_shishe.l10",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "一点？"
    },
    {
      "id": "ch03_s19_shishe.l11",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "等它……吹过来。"
    },
    {
      "id": "ch03_s19_shishe.l12",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s19_shishe.l13",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "还得候它？垫子都挪热了。"
    },
    {
      "id": "ch03_s19_shishe.l14",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "那搬——"
    },
    {
      "id": "ch03_s19_shishe.l15",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "搬回也是热的。"
    },
    {
      "id": "ch03_s19_shishe.l16",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "也是。"
    },
    {
      "id": "ch03_s19_shishe.l17",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "翻一面。"
    },
    {
      "id": "ch03_s19_shishe.l18",
      "who": "narr",
      "kind": "aside",
      "text": "她翻过坐垫。你从窗边取一张废纸，折了两折，朝她扇。"
    },
    {
      "id": "ch03_s19_shishe.l19",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "你不热？"
    },
    {
      "id": "ch03_s19_shishe.l20",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "热。先给你。"
    },
    {
      "id": "ch03_s19_shishe.l21",
      "who": "narr",
      "kind": "aside",
      "text": "温荞没坐回去，先把自己的垫子拖到你身旁。"
    },
    {
      "id": "ch03_s19_shishe.l22",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "往这边偏，一起吹。"
    },
    {
      "id": "ch03_s19_shishe.l23",
      "who": "narr",
      "kind": "aside",
      "text": "你偏过纸扇。风掀开她颊边一缕发，她望着你，等你扇下一下。"
    },
    {
      "id": "ch03_s19_shishe.l24",
      "who": "self",
      "kind": "inner",
      "text": "（她等着。我还想慢慢看一会儿。）"
    },
    {
      "id": "ch03_s19_shishe.l25",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "手酸了。"
    },
    {
      "id": "ch03_s19_shishe.l26",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "给我，别逞能。"
    },
    {
      "id": "ch03_s19_shishe.l27",
      "who": "narr",
      "kind": "aside",
      "text": "她接过去，没扇两下，纸腰先塌了。"
    },
    {
      "id": "ch03_s19_shishe.l28",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "还说我。"
    },
    {
      "id": "ch03_s19_shishe.l29",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "纸不争气。"
    },
    {
      "id": "ch03_s19_shishe.l30",
      "who": "narr",
      "kind": "aside",
      "text": "你替她撑开纸角，两人各捏一边，扇起一点风。"
    },
    {
      "id": "ch03_s19_shishe.l31",
      "who": "narr",
      "kind": "aside",
      "text": "窗扇碰了木框。温拿空鞋抵住，脚收回垫上，纸仍在你们手里。"
    },
    {
      "id": "ch03_s19_shishe.l32",
      "who": "narr",
      "kind": "aside",
      "text": "临走你把纸放回窗边，压平两只坐垫的卷角。"
    }
  ],
  "goto": "ch03_s22_nvguan"
}
