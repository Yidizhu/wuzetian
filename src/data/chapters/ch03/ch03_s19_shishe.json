{
  "id": "ch03_s19_shishe",
  "chapter": 3,
  "act": 3,
  "scene": "shishe",
  "palette": "ink",
  "cast": [
    "wuze",
    "wenqiao"
  ],
  "require": {
    "affinity.wenqiao": {
      "gte": 14
    },
    "flag.wen_meng_no_praise": true
  },
  "weightless": true,
  "leavesLetter": [],
  "purpose": "换几次坐垫找风，不用坐出一句诗",
  "lines": [
    {
      "id": "ch03_s19_shishe.l1",
      "who": "narr",
      "kind": "aside",
      "text": "差务单交清，你到温荞后窗找风。"
    },
    {
      "id": "ch03_s19_shishe.l2",
      "who": "narr",
      "kind": "aside",
      "text": "诗社后窗半开着。温坐到窗边，你搬过另一只坐垫，垫角卷进裙底。"
    },
    {
      "id": "ch03_s19_shishe.l3",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "你那边有风么？"
    },
    {
      "id": "ch03_s19_shishe.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "刚才有。"
    },
    {
      "id": "ch03_s19_shishe.l5",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "刚才。"
    },
    {
      "id": "ch03_s19_shishe.l6",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "我来就没了。"
    },
    {
      "id": "ch03_s19_shishe.l7",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "没了。"
    },
    {
      "id": "ch03_s19_shishe.l8",
      "who": "narr",
      "kind": "aside",
      "text": "温挪到另一边，把半扇窗又推开一些。窗外的晾布鼓起，风没进来。"
    },
    {
      "id": "ch03_s19_shishe.l9",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "别动，我这边又有一点。"
    },
    {
      "id": "ch03_s19_shishe.l10",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "一点？"
    },
    {
      "id": "ch03_s19_shishe.l11",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "等它……吹过来。"
    },
    {
      "id": "ch03_s19_shishe.l12",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s19_shishe.l13",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "还得候它？垫子都挪热了。"
    },
    {
      "id": "ch03_s19_shishe.l14",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "那搬——"
    },
    {
      "id": "ch03_s19_shishe.l15",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "搬回也是热的。"
    },
    {
      "id": "ch03_s19_shishe.l16",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "也是。"
    },
    {
      "id": "ch03_s19_shishe.l17",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "翻一面。"
    },
    {
      "id": "ch03_s19_shishe.l18",
      "who": "narr",
      "kind": "aside",
      "text": "她伸手翻过坐垫，坐回去。你也翻了一面，卷角仍硌着腿。"
    },
    {
      "id": "ch03_s19_shishe.l19",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "还是这里。"
    },
    {
      "id": "ch03_s19_shishe.l20",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "这里。"
    },
    {
      "id": "ch03_s19_shishe.l21",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "嗯，不用搬了。"
    },
    {
      "id": "ch03_s19_shishe.l22",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch03_s19_shishe.l23",
      "who": "narr",
      "kind": "aside",
      "text": "窗扇碰了一下木框。温用一只空鞋抵住，脚收回垫子上。"
    },
    {
      "id": "ch03_s19_shishe.l24",
      "who": "narr",
      "kind": "aside",
      "text": "你压平手边的垫角，才起身回观里。"
    }
  ],
  "goto": "ch03_s22_nvguan"
}
