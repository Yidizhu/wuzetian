{
  "id": "ch03_s17_shuge",
  "chapter": 3,
  "act": 3,
  "scene": "shuge",
  "palette": "ink",
  "cast": [
    "wuze",
    "shenheng"
  ],
  "require": {
    "affinity.shenheng": {
      "gte": 14
    },
    "flag.shen_meng_boundary": true
  },
  "weightless": true,
  "leavesLetter": [],
  "purpose": "两人听雨，不从水声里听出一封新答卷",
  "lines": [
    {
      "id": "ch03_s17_shuge.l1",
      "who": "narr",
      "kind": "aside",
      "text": "差务交清，入夜你留在书阁陪沈衡听雨。"
    },
    {
      "id": "ch03_s17_shuge.l2",
      "who": "narr",
      "kind": "aside",
      "text": "檐下一片瓦翘起，雨从两边落。沈挪开凳子，凳脚留下两个湿印。",
      "image": "e39_ch03_s17_l2"
    },
    {
      "id": "ch03_s17_shuge.l3",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "坐里边，那滴横着来。"
    },
    {
      "id": "ch03_s17_shuge.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "里边？"
    },
    {
      "id": "ch03_s17_shuge.l5",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "你看准了？"
    },
    {
      "id": "ch03_s17_shuge.l6",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "三回了，都落这儿。"
    },
    {
      "id": "ch03_s17_shuge.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "三回。"
    },
    {
      "id": "ch03_s17_shuge.l8",
      "who": "narr",
      "kind": "aside",
      "text": "你照她指的地方伸手，一滴没接到。指背挨上窗框，沾了一条灰。",
      "image": "shenheng_7_jieyu"
    },
    {
      "id": "ch03_s17_shuge.l9",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "它知道我要接，就……换一边。"
    },
    {
      "id": "ch03_s17_shuge.l10",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch03_s17_shuge.l11",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "你不说，我未必伸手。"
    },
    {
      "id": "ch03_s17_shuge.l12",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "手拿回来，擦这块。"
    },
    {
      "id": "ch03_s17_shuge.l13",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "另一块——"
    },
    {
      "id": "ch03_s17_shuge.l14",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "刚洗过。"
    },
    {
      "id": "ch03_s17_shuge.l15",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch03_s17_shuge.l16",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "给你擦了，又得洗。"
    },
    {
      "id": "ch03_s17_shuge.l17",
      "who": "narr",
      "kind": "aside",
      "text": "你擦掉灰，布还给她。一滴水落在空出的凳角，她用指尖抹了一下。"
    },
    {
      "id": "ch03_s17_shuge.l18",
      "who": "narr",
      "kind": "aside",
      "text": "你看她抹凳角的手，水珠沿着指节往下淌。"
    },
    {
      "id": "ch03_s17_shuge.l19",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "手给我暖暖。"
    },
    {
      "id": "ch03_s17_shuge.l20",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "你的也凉。"
    },
    {
      "id": "ch03_s17_shuge.l21",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "那就一起。"
    },
    {
      "id": "ch03_s17_shuge.l22",
      "who": "narr",
      "kind": "aside",
      "text": "沈衡伸过手来。你用两只手拢住，低头贴了贴她的指背。"
    },
    {
      "id": "ch03_s17_shuge.l23",
      "when": {
        "flag.enthroned": false
      },
      "who": "narr",
      "kind": "aside",
      "text": "你抬眼看沈衡，她低着头，指节还贴在你唇边。",
      "image": "shenheng_3_zhibei"
    },
    {
      "id": "ch03_s17_shuge.l24",
      "when": {
        "flag.enthroned": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "你抬眼看沈衡，她低着头，指节还贴在你唇边。",
      "image": "shenheng_3_zhibei"
    },
    {
      "id": "ch03_s17_shuge.l25",
      "who": "self",
      "kind": "inner",
      "text": "（她肯让我这样拿着。还有一只手呢。）"
    },
    {
      "id": "ch03_s17_shuge.l26",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "握太紧了。"
    },
    {
      "id": "ch03_s17_shuge.l27",
      "who": "narr",
      "kind": "aside",
      "text": "你松开一点。她另一只手覆到你手背上，把你的袖口压住。"
    },
    {
      "id": "ch03_s17_shuge.l28",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "这样？"
    },
    {
      "id": "ch03_s17_shuge.l29",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s17_shuge.l30",
      "who": "narr",
      "kind": "aside",
      "text": "檐水接成了线。你们的手搁在膝间，等雨小下来才分开。",
      "image": "e39_ch03_s17_l30"
    },
    {
      "id": "ch03_s17_shuge.l31",
      "who": "narr",
      "kind": "aside",
      "text": "你将擦手布叠好放在她凳边，起身回观里。"
    }
  ],
  "goto": "ch03_s22_nvguan"
}
