{
  "id": "ch03_s17_shuge",
  "chapter": 3,
  "act": 3,
  "scene": "shuge",
  "palette": "ink",
  "cast": [
    "wuze",
    "shenheng"
  ],
  "require": {
    "affinity.shenheng": {
      "gte": 14
    },
    "flag.shen_meng_boundary": true
  },
  "weightless": true,
  "leavesLetter": [],
  "purpose": "两人听雨，不从水声里听出一封新答卷",
  "lines": [
    {
      "id": "ch03_s17_shuge.l1",
      "who": "narr",
      "kind": "aside",
      "text": "差务单交清，你留在书阁陪沈衡听雨。"
    },
    {
      "id": "ch03_s17_shuge.l2",
      "who": "narr",
      "kind": "aside",
      "text": "檐下一片瓦往外翘，雨从两边落。沈把凳子挪开，凳脚在地上留了两个湿印。"
    },
    {
      "id": "ch03_s17_shuge.l3",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "坐里边，那滴横着来。"
    },
    {
      "id": "ch03_s17_shuge.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "里边？"
    },
    {
      "id": "ch03_s17_shuge.l5",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "你看准了？"
    },
    {
      "id": "ch03_s17_shuge.l6",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "三回了，都落这儿。"
    },
    {
      "id": "ch03_s17_shuge.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "三回。"
    },
    {
      "id": "ch03_s17_shuge.l8",
      "who": "narr",
      "kind": "aside",
      "text": "你照她指的地方伸手，一滴没接到。指背挨上窗框，沾了一条灰。"
    },
    {
      "id": "ch03_s17_shuge.l9",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "它知道我要接，就……换一边。"
    },
    {
      "id": "ch03_s17_shuge.l10",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch03_s17_shuge.l11",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "你不说，我未必伸手。"
    },
    {
      "id": "ch03_s17_shuge.l12",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "手拿回来，擦这块。"
    },
    {
      "id": "ch03_s17_shuge.l13",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "另一块——"
    },
    {
      "id": "ch03_s17_shuge.l14",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "刚洗过。"
    },
    {
      "id": "ch03_s17_shuge.l15",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch03_s17_shuge.l16",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "给你擦了，又得洗。"
    },
    {
      "id": "ch03_s17_shuge.l17",
      "who": "narr",
      "kind": "aside",
      "text": "你擦掉灰，布还给她。一滴水落在空出的凳角，她用指尖抹了一下。"
    },
    {
      "id": "ch03_s17_shuge.l18",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这回是直的。"
    },
    {
      "id": "ch03_s17_shuge.l19",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s17_shuge.l20",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "这一回。"
    },
    {
      "id": "ch03_s17_shuge.l21",
      "who": "narr",
      "kind": "aside",
      "text": "檐水又接成了线。两张凳子都没再挪。"
    },
    {
      "id": "ch03_s17_shuge.l22",
      "who": "narr",
      "kind": "aside",
      "text": "你把擦过手的布放稳，准备回观里。"
    }
  ],
  "goto": "ch03_s22_nvguan"
}
