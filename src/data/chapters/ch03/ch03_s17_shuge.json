{
  "id": "ch03_s17_shuge",
  "chapter": 3,
  "act": 3,
  "scene": "shuge",
  "palette": "ink",
  "cast": [
    "wuze",
    "shenheng"
  ],
  "require": {
    "affinity.shenheng": {
      "gte": 14
    },
    "flag.shen_meng_boundary": true
  },
  "weightless": true,
  "leavesLetter": [],
  "purpose": "两人听雨，不从水声里听出一封新答卷",
  "lines": [
    {
      "id": "ch03_s17_shuge.l1",
      "who": "narr",
      "kind": "aside",
      "text": "檐下一片瓦往外翘，雨从两边落。沈把凳子挪开，凳脚在地上留了两个湿印。"
    },
    {
      "id": "ch03_s17_shuge.l2",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "坐里边。那滴是横着来的。"
    },
    {
      "id": "ch03_s17_shuge.l3",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "你看准了？"
    },
    {
      "id": "ch03_s17_shuge.l4",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "三回了，都落在这儿。"
    },
    {
      "id": "ch03_s17_shuge.l5",
      "who": "narr",
      "kind": "aside",
      "text": "你照她指的地方伸手，一滴没接到。指背挨上窗框，沾了一条灰。"
    },
    {
      "id": "ch03_s17_shuge.l6",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "它知道我要接，便换了一边。方才你不说，我也未必非得伸这只手出去。"
    },
    {
      "id": "ch03_s17_shuge.l7",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "手拿回来，擦在这块布上。另一块刚洗过，给你擦了，我又得洗一遍。"
    },
    {
      "id": "ch03_s17_shuge.l8",
      "who": "narr",
      "kind": "aside",
      "text": "你擦掉灰，布还给她。一滴水落在空出的凳角，她用指尖抹了一下。"
    },
    {
      "id": "ch03_s17_shuge.l9",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这一回是直的。"
    },
    {
      "id": "ch03_s17_shuge.l10",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "嗯。这一回。"
    },
    {
      "id": "ch03_s17_shuge.l11",
      "who": "narr",
      "kind": "aside",
      "text": "檐水又接成了线。两张凳子都没再挪。"
    }
  ],
  "goto": "ch03_s22_nvguan"
}
