{
  "id": "ch03_s21_nvguan",
  "chapter": 3,
  "act": 3,
  "scene": "nvguan",
  "palette": "ink",
  "cast": [
    "wuze",
    "xujinghe"
  ],
  "weightless": true,
  "leavesLetter": [],
  "purpose": "找一小片落下的灯花，没找到便不找了",
  "lines": [
    {
      "id": "ch03_s21_nvguan.l1",
      "who": "narr",
      "kind": "aside",
      "text": "内屋白日也点着小灯。许拨下灯花，刚落进碟里，被袖口带到了桌沿。"
    },
    {
      "id": "ch03_s21_nvguan.l2",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "掉到哪边了？"
    },
    {
      "id": "ch03_s21_nvguan.l3",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你的袖子底下。"
    },
    {
      "id": "ch03_s21_nvguan.l4",
      "who": "narr",
      "kind": "aside",
      "text": "许提起袖口，桌上只有一个旧烫痕。你俯身去看，发梢碰到了碟子。"
    },
    {
      "id": "ch03_s21_nvguan.l5",
      "who": "xujinghe",
      "expr": "open",
      "kind": "say",
      "text": "别再往前，碟子也要下去了。我刚捡起一片，这回可不想连整只碟一起找。"
    },
    {
      "id": "ch03_s21_nvguan.l6",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "方才明明看见它落在这边，找的时候又都是黑点。桌子什么时候烫了这么多处？"
    },
    {
      "id": "ch03_s21_nvguan.l7",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "不记得。以前的也有。"
    },
    {
      "id": "ch03_s21_nvguan.l8",
      "who": "narr",
      "kind": "aside",
      "text": "你们将碟子移回桌中。许松开袖口，那片灯花仍不见踪影。"
    },
    {
      "id": "ch03_s21_nvguan.l9",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不找了？"
    },
    {
      "id": "ch03_s21_nvguan.l10",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "不找了。"
    },
    {
      "id": "ch03_s21_nvguan.l11",
      "who": "narr",
      "kind": "aside",
      "text": "小灯烧得稳。你靠回椅背，许把空着的灯签搁在碟边。"
    }
  ],
  "goto": "ch03_s22_nvguan"
}
