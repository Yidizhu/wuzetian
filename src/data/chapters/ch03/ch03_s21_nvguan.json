{
  "id": "ch03_s21_nvguan",
  "chapter": 3,
  "act": 3,
  "scene": "nvguan",
  "palette": "ink",
  "cast": [
    "wuze",
    "xujinghe"
  ],
  "weightless": true,
  "leavesLetter": [],
  "purpose": "找一小片落下的灯花，没找到便不找了",
  "lines": [
    {
      "id": "ch03_s21_nvguan.l1",
      "who": "narr",
      "kind": "aside",
      "text": "差务单交清，你走到许静和的小灯前。"
    },
    {
      "id": "ch03_s21_nvguan.l2",
      "who": "narr",
      "kind": "aside",
      "text": "内屋白日也点着小灯。许拨下灯花，刚落进碟里，被袖口带到了桌沿。"
    },
    {
      "id": "ch03_s21_nvguan.l3",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "掉到哪边了？"
    },
    {
      "id": "ch03_s21_nvguan.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "袖子底下。"
    },
    {
      "id": "ch03_s21_nvguan.l5",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "袖子？"
    },
    {
      "id": "ch03_s21_nvguan.l6",
      "who": "narr",
      "kind": "aside",
      "text": "许提起袖口，桌上只有一个旧烫痕。你俯身去看，发梢碰到了碟子。"
    },
    {
      "id": "ch03_s21_nvguan.l7",
      "who": "xujinghe",
      "expr": "open",
      "kind": "say",
      "text": "别再往前，碟子要掉了。"
    },
    {
      "id": "ch03_s21_nvguan.l8",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "碟子。"
    },
    {
      "id": "ch03_s21_nvguan.l9",
      "who": "xujinghe",
      "expr": "open",
      "kind": "say",
      "text": "不想再找整只。"
    },
    {
      "id": "ch03_s21_nvguan.l10",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "方才明明……落这边了。"
    },
    {
      "id": "ch03_s21_nvguan.l11",
      "who": "xujinghe",
      "expr": "open",
      "kind": "say",
      "text": "这边。"
    },
    {
      "id": "ch03_s21_nvguan.l12",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "现在全是黑点。我再——"
    },
    {
      "id": "ch03_s21_nvguan.l13",
      "who": "xujinghe",
      "expr": "open",
      "kind": "say",
      "text": "别碰了。"
    },
    {
      "id": "ch03_s21_nvguan.l14",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s21_nvguan.l15",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "何时烫了这么多处？"
    },
    {
      "id": "ch03_s21_nvguan.l16",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "不记得，有以前的。"
    },
    {
      "id": "ch03_s21_nvguan.l17",
      "who": "narr",
      "kind": "aside",
      "text": "你们将碟子移回桌中。许松开袖口，那片灯花仍不见踪影。"
    },
    {
      "id": "ch03_s21_nvguan.l18",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不找了？"
    },
    {
      "id": "ch03_s21_nvguan.l19",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "不找了。"
    },
    {
      "id": "ch03_s21_nvguan.l20",
      "who": "narr",
      "kind": "aside",
      "text": "小灯烧得稳。你靠回椅背，许把空着的灯签搁在碟边。"
    },
    {
      "id": "ch03_s21_nvguan.l21",
      "who": "narr",
      "kind": "aside",
      "text": "你收回扶碟的手，仍留在观里。"
    }
  ],
  "goto": "ch03_s22_nvguan"
}
