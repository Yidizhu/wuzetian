{
  "id": "ch03_s16_shuge",
  "chapter": 3,
  "act": 3,
  "scene": "shuge",
  "palette": "gold",
  "cast": [
    "wuze",
    "tangjian",
    "xujinghe"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "结清旧私人差务的授权，给往后的考察与闲处留出空白",
  "lines": [
    {
      "id": "ch03_s16_shuge.l1",
      "who": "narr",
      "kind": "aside",
      "text": "收好朱绳，你回书阁交最后一张差务单。"
    },
    {
      "id": "ch03_s16_shuge.l2",
      "who": "narr",
      "kind": "aside",
      "text": "唐把最后一张差务单展开，许送还借阅的薄册。册角翘着，压在砚旁才伏下去。"
    },
    {
      "id": "ch03_s16_shuge.l3",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "各人各有差，这张只解旧约。"
    },
    {
      "id": "ch03_s16_shuge.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "旧约。"
    },
    {
      "id": "ch03_s16_shuge.l5",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "别顺手替她们领新差。"
    },
    {
      "id": "ch03_s16_shuge.l6",
      "when": {
        "flag.enthroned": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "离开的照给钱。入新署另问，另受差。"
    },
    {
      "id": "ch03_s16_shuge.l7",
      "when": {
        "flag.enthroned": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "只列这班旧人，余下还须议，不能算人人有份。"
    },
    {
      "id": "ch03_s16_shuge.l8",
      "when": {
        "flag.enthroned": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "是。"
    },
    {
      "id": "ch03_s16_shuge.l9",
      "when": {
        "flag.declined_crown": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "重推开了，我不等再劝，这几张也别续。"
    },
    {
      "id": "ch03_s16_shuge.l10",
      "when": {
        "flag.declined_crown": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "辞受照录，旧俸结足，居处未定也不断供给。"
    },
    {
      "id": "ch03_s16_shuge.l11",
      "when": {
        "flag.declined_crown": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "旧俸。"
    },
    {
      "id": "ch03_s16_shuge.l12",
      "when": {
        "flag.liqinghe_won": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我续补案，借抄另问，不能用旧牌传人。"
    },
    {
      "id": "ch03_s16_shuge.l13",
      "when": {
        "flag.liqinghe_won": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "另问。"
    },
    {
      "id": "ch03_s16_shuge.l14",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "来看教字可以，开课先问纸钱和谁肯教。"
    },
    {
      "id": "ch03_s16_shuge.l15",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "纸钱。"
    },
    {
      "id": "ch03_s16_shuge.l16",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "桌子已经——"
    },
    {
      "id": "ch03_s16_shuge.l17",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "摆过三回了。"
    },
    {
      "id": "ch03_s16_shuge.l18",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "三回。"
    },
    {
      "id": "ch03_s16_shuge.l19",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "温只借三个午后，没搬来。"
    },
    {
      "id": "ch03_s16_shuge.l20",
      "who": "narr",
      "kind": "aside",
      "text": "唐念完工价与各自回署的日子，把笔递过来。你在旧约终止处署名。"
    },
    {
      "id": "ch03_s16_shuge.l21",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "各人留了份，余款不扣，签后不能按旧约传。"
    },
    {
      "id": "ch03_s16_shuge.l22",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s16_shuge.l23",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "记明白。"
    },
    {
      "id": "ch03_s16_shuge.l24",
      "who": "xujinghe",
      "expr": "open",
      "kind": "say",
      "text": "今日想去哪儿？只问今日。"
    },
    {
      "id": "ch03_s16_shuge.l25",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "今日……"
    },
    {
      "id": "ch03_s16_shuge.l26",
      "who": "narr",
      "kind": "aside",
      "text": "门外木轮碾过石缝。许把还来的薄册推入架中，没有替你空出一栏名字。"
    },
    {
      "id": "ch03_s16_shuge.l27",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "先找地方坐。看课、问路，都不替明年落笔。"
    },
    {
      "id": "ch03_s16_shuge.l28",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch03_s16_shuge.l29",
      "who": "narr",
      "kind": "aside",
      "text": "唐将差务单合起，你在门边停了一停。"
    }
  ],
