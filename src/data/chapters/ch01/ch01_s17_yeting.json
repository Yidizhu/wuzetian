{
  "id": "ch01_s17_yeting",
  "chapter": 1,
  "act": 1,
  "scene": "yeting",
  "palette": "ink",
  "cast": [
    "wuze",
    "adi",
    "songhuizhen"
  ],
  "require": {
    "flag.petition_sent": true
  },
  "weightless": false,
  "leavesLetter": [],
  "purpose": "玩家先看见阿荻认出细节，再看主角发现善意并没有取得许可",
  "lines": [
    {
      "id": "ch01_s17_yeting.l1",
      "who": "narr",
      "kind": "aside",
      "text": "袖口扫过门框，你回到阿荻的案边。"
    },
    {
      "id": "ch01_s17_yeting.l2",
      "who": "narr",
      "kind": "aside",
      "text": "天又落起细雨，宋蕙贞把半扇窗关上，留下案边一点亮光。",
      "image": "e39_ch01_s17_l2"
    },
    {
      "id": "ch01_s17_yeting.l3",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "阿荻。"
    },
    {
      "id": "ch01_s17_yeting.l4",
      "who": "adi",
      "expr": "open",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch01_s17_yeting.l5",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "我带了件东西。"
    },
    {
      "id": "ch01_s17_yeting.l6",
      "who": "narr",
      "kind": "aside",
      "text": "抄件展开。阿荻先看见“十一”，握针的手停住了。"
    },
    {
      "id": "ch01_s17_yeting.l7",
      "who": "narr",
      "kind": "aside",
      "text": "你还在解外层的干布，没有看见她把针放进篮底。"
    },
    {
      "id": "ch01_s17_yeting.l8",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "这处让宋才人替你看也好。"
    },
    {
      "id": "ch01_s17_yeting.l9",
      "who": "adi",
      "expr": "open",
      "kind": "say",
      "text": "哪处？"
    },
    {
      "id": "ch01_s17_yeting.l10",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "已请他们查旧欠，不必只等西库了。"
    },
    {
      "id": "ch01_s17_yeting.l11",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "你念。"
    },
    {
      "id": "ch01_s17_yeting.l12",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "初八，西库，旧衣十一件。"
    },
    {
      "id": "ch01_s17_yeting.l13",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "工钱未付，还得查原账。"
    },
    {
      "id": "ch01_s17_yeting.l14",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "这就要查到我了？"
    },
    {
      "id": "ch01_s17_yeting.l15",
      "who": "narr",
      "kind": "aside",
      "text": "阿荻把自己的袖口翻下来，盖住掌心。"
    },
    {
      "id": "ch01_s17_yeting.l16",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "没写你的名字，我——"
    },
    {
      "id": "ch01_s17_yeting.l17",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "十一件都是我送的。"
    },
    {
      "id": "ch01_s17_yeting.l18",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch01_s17_yeting.l19",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "他们会不知道是谁？"
    },
    {
      "id": "ch01_s17_yeting.l20",
      "who": "narr",
      "kind": "aside",
      "text": "你准备好的后半句话没说出来。"
    },
    {
      "id": "ch01_s17_yeting.l21",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "呈文签的是我的名，问起来我去。"
    },
    {
      "id": "ch01_s17_yeting.l22",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "你署你的名。"
    },
    {
      "id": "ch01_s17_yeting.l23",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "是。"
    },
    {
      "id": "ch01_s17_yeting.l24",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "衣是我缝的，那天的事你答得出？"
    },
    {
      "id": "ch01_s17_yeting.l25",
      "who": "songhuizhen",
      "expr": "guarded",
      "kind": "say",
      "text": "递了没有？"
    },
    {
      "id": "ch01_s17_yeting.l26",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "递了。"
    },
    {
      "id": "ch01_s17_yeting.l27",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch01_s17_yeting.l28",
      "who": "narr",
      "kind": "aside",
      "text": "雨点从窗隙打进来，抄件一角慢慢洇湿。",
      "image": "e39_ch01_s17_l28"
    },
    {
      "id": "ch01_s17_yeting.l29",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "我只说给你听。"
    },
    {
      "id": "ch01_s17_yeting.l30",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "我以为，能帮你领到。"
    },
    {
      "id": "ch01_s17_yeting.l31",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "你以为……"
    },
    {
      "id": "ch01_s17_yeting.l32",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "我也想领。"
    },
    {
      "id": "ch01_s17_yeting.l33",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "我……"
    },
    {
      "id": "ch01_s17_yeting.l34",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "何时去问，你都不问我？"
    },
    {
      "id": "ch01_s17_yeting.l35",
      "who": "narr",
      "kind": "aside",
      "text": "宋蕙贞把湿纸移开，没替任何一个人接话。"
    },
    {
      "id": "ch01_s17_yeting.l36",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "是我先替你定了。"
    },
    {
      "id": "ch01_s17_yeting.l37",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch01_s17_yeting.l38",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "不是你没说清。"
    },
    {
      "id": "ch01_s17_yeting.l39",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "现在到哪里了？"
    },
    {
      "id": "ch01_s17_yeting.l40",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "封好送出去后，我就不知道传到哪儿了。"
    },
    {
      "id": "ch01_s17_yeting.l41",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "宋才人。"
    },
    {
      "id": "ch01_s17_yeting.l42",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "要追呈文，得去衙署门口；留下，就先给阿荻讲清楚。"
    },
    {
      "id": "ch01_s17_yeting.l43",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "她得知道我写了什么。"
    },
    {
      "id": "ch01_s17_yeting.l44",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "别再说“有我”就走。"
    },
    {
      "id": "ch01_s17_yeting.l45",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "我听着。"
    },
    {
      "id": "ch01_s17_yeting.l46",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "他们会问什么，我得知道。"
    },
    {
      "id": "ch01_s17_yeting.l47",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "纸追不追得上，也得知道。"
    },
    {
      "id": "ch01_s17_yeting.l48",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "我不能两处一起赶。"
    },
    {
      "id": "ch01_s17_yeting.l49",
      "who": "songhuizhen",
      "expr": "guarded",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch01_s17_yeting.l50",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "先做哪处，误了另一处也由我认。"
    },
    {
      "id": "ch01_s17_yeting.l51",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "我在这里，她不会一个人等。"
    },
    {
      "id": "ch01_s17_yeting.l52",
      "who": "narr",
      "kind": "aside",
      "text": "你走到门边，冷水已顺着阶沿往下流。"
    }
  ],
  "choices": [
    {
      "id": "ch01_s17_yeting.cA",
      "text": "先追呈文，请宋才人陪你",
      "effects": {
        "shi": 1,
        "xin": -1,
        "flag.petition_chase_first": true
      },
      "irreversible": false,
      "goto": "ch01_s18_zhaoyang"
    },
    {
      "id": "ch01_s17_yeting.cB",
      "text": "先把话说全，再带补说明去",
      "effects": {
        "xin": 1,
        "shi": -1,
        "flag.petition_explain_first": true
      },
      "irreversible": false,
      "goto": "ch01_s18_zhaoyang"
    }
  ]
}
