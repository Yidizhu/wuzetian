{
  "id": "ch01_s14_yuanye",
  "chapter": 1,
  "act": 1,
  "scene": "yuanye",
  "palette": "ink",
  "cast": [
    "wuze",
    "peizhaoye"
  ],
  "require": {
    "affinity.peizhaoye": {
      "gte": 4
    }
  },
  "weightless": true,
  "leavesLetter": [],
  "purpose": "两人慢慢拆开一个越帮越紧的衣带结",
  "lines": [
    {
      "id": "ch01_s14_yuanye.l1",
      "who": "narr",
      "kind": "aside",
      "text": "从书阁走到苑里，你在裴照夜身旁蹲下。"
    },
    {
      "id": "ch01_s14_yuanye.l2",
      "who": "narr",
      "kind": "aside",
      "text": "风把树上的水珠吹下来，落在裴照夜膝头的衣带上。"
    },
    {
      "id": "ch01_s14_yuanye.l3",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "别拉。"
    },
    {
      "id": "ch01_s14_yuanye.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我没——"
    },
    {
      "id": "ch01_s14_yuanye.l5",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "你手里。"
    },
    {
      "id": "ch01_s14_yuanye.l6",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你也在拉。"
    },
    {
      "id": "ch01_s14_yuanye.l7",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "我在稳住它。"
    },
    {
      "id": "ch01_s14_yuanye.l8",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "稳住。"
    },
    {
      "id": "ch01_s14_yuanye.l9",
      "who": "narr",
      "kind": "aside",
      "text": "两人同时松手。结仍老老实实待在原处。"
    },
    {
      "id": "ch01_s14_yuanye.l10",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "它倒比我们稳。"
    },
    {
      "id": "ch01_s14_yuanye.l11",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "你捏这头。"
    },
    {
      "id": "ch01_s14_yuanye.l12",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "这头？"
    },
    {
      "id": "ch01_s14_yuanye.l13",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "对。"
    },
    {
      "id": "ch01_s14_yuanye.l14",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "别替我使劲，方才一起拉，反而更紧。"
    },
    {
      "id": "ch01_s14_yuanye.l15",
      "who": "narr",
      "kind": "aside",
      "text": "你用指尖挑出一点松隙，裴低头凑近来看。"
    },
    {
      "id": "ch01_s14_yuanye.l16",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "这里。"
    },
    {
      "id": "ch01_s14_yuanye.l17",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "再挑一点。"
    },
    {
      "id": "ch01_s14_yuanye.l18",
      "who": "narr",
      "kind": "aside",
      "text": "她一手稳着衣带，腕骨露在袖口外。"
    },
    {
      "id": "ch01_s14_yuanye.l19",
      "who": "narr",
      "kind": "aside",
      "text": "你停了挑结的手，翻过来，掌心朝她。"
    },
    {
      "id": "ch01_s14_yuanye.l20",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "这只手，给我握一会儿。"
    },
    {
      "id": "ch01_s14_yuanye.l21",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "结不解了？"
    },
    {
      "id": "ch01_s14_yuanye.l22",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "等会儿解。"
    },
    {
      "id": "ch01_s14_yuanye.l23",
      "who": "narr",
      "kind": "aside",
      "text": "裴看了一眼你的空手，把衣带搁到膝上，手递进你掌心。"
    },
    {
      "id": "ch01_s14_yuanye.l24",
      "who": "narr",
      "kind": "aside",
      "text": "她掌根贴过来，指节有一层薄茧。你合拢手指，去看她的脸。"
    },
    {
      "id": "ch01_s14_yuanye.l25",
      "who": "self",
      "kind": "inner",
      "text": "（还真给我了。先不松。）"
    },
    {
      "id": "ch01_s14_yuanye.l26",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "方才怎么不说？"
    },
    {
      "id": "ch01_s14_yuanye.l27",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "方才还想把结解开。"
    },
    {
      "id": "ch01_s14_yuanye.l28",
      "who": "narr",
      "kind": "aside",
      "text": "她拇指在你虎口停着。树上的水又滴下来，落在她膝头。"
    },
    {
      "id": "ch01_s14_yuanye.l29",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "这回倒不拉了。"
    },
    {
      "id": "ch01_s14_yuanye.l30",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "不拉。"
    },
    {
      "id": "ch01_s14_yuanye.l31",
      "who": "narr",
      "kind": "aside",
      "text": "你们握着手，衣带放在两人膝间。"
    }
  ],
  "goto": "ch01_s17_yeting"
}
