{
  "id": "ch01_s14_yuanye",
  "chapter": 1,
  "act": 1,
  "scene": "yuanye",
  "palette": "ink",
  "cast": [
    "wuze",
    "peizhaoye"
  ],
  "require": {
    "affinity.peizhaoye": {
      "gte": 4
    }
  },
  "weightless": true,
  "leavesLetter": [],
  "purpose": "两人慢慢拆开一个越帮越紧的衣带结",
  "lines": [
    {
      "id": "ch01_s14_yuanye.l1",
      "who": "narr",
      "kind": "aside",
      "text": "从书阁走到苑里，你在裴照夜身旁蹲下。"
    },
    {
      "id": "ch01_s14_yuanye.l2",
      "who": "narr",
      "kind": "aside",
      "text": "风把树上的水珠吹下来，落在裴照夜膝头的衣带上。"
    },
    {
      "id": "ch01_s14_yuanye.l3",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "别拉。"
    },
    {
      "id": "ch01_s14_yuanye.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我没——"
    },
    {
      "id": "ch01_s14_yuanye.l5",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "你手里。"
    },
    {
      "id": "ch01_s14_yuanye.l6",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你也在拉。"
    },
    {
      "id": "ch01_s14_yuanye.l7",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "我在稳住它。"
    },
    {
      "id": "ch01_s14_yuanye.l8",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "稳住。"
    },
    {
      "id": "ch01_s14_yuanye.l9",
      "who": "narr",
      "kind": "aside",
      "text": "两人同时松手。结仍老老实实待在原处。"
    },
    {
      "id": "ch01_s14_yuanye.l10",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "它倒比我们稳。"
    },
    {
      "id": "ch01_s14_yuanye.l11",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "你捏这头。"
    },
    {
      "id": "ch01_s14_yuanye.l12",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "这头？"
    },
    {
      "id": "ch01_s14_yuanye.l13",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "对。"
    },
    {
      "id": "ch01_s14_yuanye.l14",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "别替我使劲，方才一起拉，反而更紧。"
    },
    {
      "id": "ch01_s14_yuanye.l15",
      "who": "narr",
      "kind": "aside",
      "text": "你用指尖挑出一点松隙，衣带边缘有些发痒。"
    },
    {
      "id": "ch01_s14_yuanye.l16",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这里……"
    },
    {
      "id": "ch01_s14_yuanye.l17",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "我看看。"
    },
    {
      "id": "ch01_s14_yuanye.l18",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "松一点了。"
    },
    {
      "id": "ch01_s14_yuanye.l19",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "看见了，再一点。"
    },
    {
      "id": "ch01_s14_yuanye.l20",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch01_s14_yuanye.l21",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "解不开，就让它再坐一会儿。"
    },
    {
      "id": "ch01_s14_yuanye.l22",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "坐一会儿。"
    },
    {
      "id": "ch01_s14_yuanye.l23",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "还没同一个结耗过这么久。"
    },
    {
      "id": "ch01_s14_yuanye.l24",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "它也没有。"
    },
    {
      "id": "ch01_s14_yuanye.l25",
      "who": "narr",
      "kind": "aside",
      "text": "你们又停了一会儿，才从刚才那点松隙继续。"
    },
    {
      "id": "ch01_s14_yuanye.l26",
      "who": "narr",
      "kind": "aside",
      "text": "你拉起袖口，捏稳她递来的衣带一端。"
    }
  ],
  "goto": "ch01_s17_yeting"
}
