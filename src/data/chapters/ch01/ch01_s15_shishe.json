{
  "id": "ch01_s15_shishe",
  "chapter": 1,
  "act": 1,
  "scene": "shishe",
  "palette": "ink",
  "cast": [
    "wuze",
    "wenqiao"
  ],
  "require": {
    "affinity.wenqiao": {
      "gte": 4
    }
  },
  "weightless": true,
  "leavesLetter": [],
  "purpose": "只听两张纸的声音，猜错也可以笑",
  "lines": [
    {
      "id": "ch01_s15_shishe.l1",
      "who": "narr",
      "kind": "aside",
      "text": "从书阁折回诗社，你坐到温荞手边。"
    },
    {
      "id": "ch01_s15_shishe.l2",
      "who": "narr",
      "kind": "aside",
      "text": "诗社纸槽的湿草气还没散，温荞拿两张干废纸，在你耳边抖。"
    },
    {
      "id": "ch01_s15_shishe.l3",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "闭眼。"
    },
    {
      "id": "ch01_s15_shishe.l4",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch01_s15_shishe.l5",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "哪张薄？"
    },
    {
      "id": "ch01_s15_shishe.l6",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "近的。"
    },
    {
      "id": "ch01_s15_shishe.l7",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "近的？"
    },
    {
      "id": "ch01_s15_shishe.l8",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "就是——"
    },
    {
      "id": "ch01_s15_shishe.l9",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "两张一样近。"
    },
    {
      "id": "ch01_s15_shishe.l10",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "那就响的。"
    },
    {
      "id": "ch01_s15_shishe.l11",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "含糊成这样，我递哪张你都能说对。"
    },
    {
      "id": "ch01_s15_shishe.l12",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch01_s15_shishe.l13",
      "who": "narr",
      "kind": "aside",
      "text": "你睁开一只眼，她立刻把两张纸都藏到身后。"
    },
    {
      "id": "ch01_s15_shishe.l14",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "这还用偷看？"
    },
    {
      "id": "ch01_s15_shishe.l15",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "温荞。"
    },
    {
      "id": "ch01_s15_shishe.l16",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "怎么？"
    },
    {
      "id": "ch01_s15_shishe.l17",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "换我抖，你闭眼。"
    },
    {
      "id": "ch01_s15_shishe.l18",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "若你也猜错……"
    },
    {
      "id": "ch01_s15_shishe.l19",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "如何？"
    },
    {
      "id": "ch01_s15_shishe.l20",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "这两张就都算厚的。"
    },
    {
      "id": "ch01_s15_shishe.l21",
      "who": "narr",
      "kind": "aside",
      "text": "她把纸递给你，闭眼前还特意将头偏向另一边。"
    },
    {
      "id": "ch01_s15_shishe.l22",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "现在呢？"
    },
    {
      "id": "ch01_s15_shishe.l23",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "现在……"
    },
    {
      "id": "ch01_s15_shishe.l24",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "你笑得比纸响。"
    },
    {
      "id": "ch01_s15_shishe.l25",
      "who": "narr",
      "kind": "aside",
      "text": "你只好等自己不笑了，再抖一次。"
    },
    {
      "id": "ch01_s15_shishe.l26",
      "who": "narr",
      "kind": "aside",
      "text": "你拢住袖口，再把两张纸抖给她听。"
    }
  ],
  "goto": "ch01_s17_yeting"
}
