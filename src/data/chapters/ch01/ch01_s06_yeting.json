{
  "id": "ch01_s06_yeting",
  "chapter": 1,
  "act": 1,
  "scene": "yeting",
  "palette": "ink",
  "cast": [
    "wuze",
    "tangjian",
    "songhuizhen",
    "adi"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "改掉缺一人便扣整组领物的办法，并分担核账成本",
  "lines": [
    {
      "id": "ch01_s06_yeting.l1",
      "who": "narr",
      "kind": "aside",
      "text": "离开苑墙，你与阿荻一道回掖庭领物。"
    },
    {
      "id": "ch01_s06_yeting.l2",
      "who": "narr",
      "kind": "aside",
      "text": "掖庭库门只进一线斜光，陈布味闷在门内，阿荻托了两次才抽出底包。"
    },
    {
      "id": "ch01_s06_yeting.l3",
      "who": "songhuizhen",
      "expr": "guarded",
      "kind": "say",
      "text": "她病着，不能为签字走这一趟。"
    },
    {
      "id": "ch01_s06_yeting.l4",
      "who": "narr",
      "kind": "aside",
      "text": "唐简戴幞头，圆领袍的前襟抵住案沿，身子倾过来压纸。"
    },
    {
      "id": "ch01_s06_yeting.l5",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "旧簿要整组的人都签字，少一人，谁也领不了。"
    },
    {
      "id": "ch01_s06_yeting.l6",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "一个人病了，整组都等？"
    },
    {
      "id": "ch01_s06_yeting.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "来的不能各领各的么？"
    },
    {
      "id": "ch01_s06_yeting.l8",
      "who": "tangjian",
      "expr": "guarded",
      "kind": "say",
      "text": "原来整组合记一笔，分开领就得重新抄、逐人对账。"
    },
    {
      "id": "ch01_s06_yeting.l9",
      "who": "tangjian",
      "expr": "guarded",
      "kind": "say",
      "text": "你看看这案上。"
    },
    {
      "id": "ch01_s06_yeting.l10",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "我看着。"
    },
    {
      "id": "ch01_s06_yeting.l11",
      "who": "tangjian",
      "expr": "guarded",
      "kind": "say",
      "text": "案前只有我一个，搬出来的东西还得逐样核清。"
    },
    {
      "id": "ch01_s06_yeting.l12",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "实物我来点，这批我点过。"
    },
    {
      "id": "ch01_s06_yeting.l13",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "我听见了。"
    },
    {
      "id": "ch01_s06_yeting.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我来抄，每个人单记一行。"
    },
    {
      "id": "ch01_s06_yeting.l15",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "旧账也得一同留着。"
    },
    {
      "id": "ch01_s06_yeting.l16",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "留着，对得上才知道谁领了多少。"
    },
    {
      "id": "ch01_s06_yeting.l17",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "你抄，我核。"
    },
    {
      "id": "ch01_s06_yeting.l18",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch01_s06_yeting.l19",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "布堆在——"
    },
    {
      "id": "ch01_s06_yeting.l20",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "别堆门口。"
    },
    {
      "id": "ch01_s06_yeting.l21",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "病着的人明日来，也得有处落脚。"
    },
    {
      "id": "ch01_s06_yeting.l22",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "那她那份呢？"
    },
    {
      "id": "ch01_s06_yeting.l23",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "她那份记着没领。明日去病舍问清，不能替她签。"
    },
    {
      "id": "ch01_s06_yeting.l24",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch01_s06_yeting.l25",
      "who": "narr",
      "kind": "aside",
      "text": "唐简将合领簿摊开，另纸分出人名。"
    },
    {
      "id": "ch01_s06_yeting.l26",
      "who": "narr",
      "kind": "aside",
      "text": "粗麻包布磨着腕骨，你手臂一沉，和宋蕙贞一同把布包挪上空架。"
    },
    {
      "id": "ch01_s06_yeting.l27",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "架上空了。"
    },
    {
      "id": "ch01_s06_yeting.l28",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这簿子……"
    },
    {
      "id": "ch01_s06_yeting.l29",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "给我看。"
    },
    {
      "id": "ch01_s06_yeting.l30",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这样抄，可以么？"
    },
    {
      "id": "ch01_s06_yeting.l31",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "可以，再留一栏，写还欠她多少。"
    },
    {
      "id": "ch01_s06_yeting.l32",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这一栏？"
    },
    {
      "id": "ch01_s06_yeting.l33",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "布对了，线还差一束。"
    },
    {
      "id": "ch01_s06_yeting.l34",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "得开内箱。"
    },
    {
      "id": "ch01_s06_yeting.l35",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "内箱？"
    },
    {
      "id": "ch01_s06_yeting.l36",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "那只箱子要等掌灯时，才有人来一同清点。"
    },
    {
      "id": "ch01_s06_yeting.l37",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "掌灯？"
    },
    {
      "id": "ch01_s06_yeting.l38",
      "who": "songhuizhen",
      "expr": "guarded",
      "kind": "say",
      "text": "有人等着回去开裁。"
    },
    {
      "id": "ch01_s06_yeting.l39",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "可以先领已点清的布，线记着欠数，改日再领。"
    },
    {
      "id": "ch01_s06_yeting.l40",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "再来一趟……"
    },
    {
      "id": "ch01_s06_yeting.l41",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "也要工夫。"
    },
    {
      "id": "ch01_s06_yeting.l42",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "或等掌灯，核齐了各领一份。"
    },
    {
      "id": "ch01_s06_yeting.l43",
      "who": "songhuizhen",
      "expr": "guarded",
      "kind": "say",
      "text": "今日的亮光也就等没了。"
    },
    {
      "id": "ch01_s06_yeting.l44",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch01_s06_yeting.l45",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "两个办法都写明，让领的人知道。"
    },
    {
      "id": "ch01_s06_yeting.l46",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "眼下只能先办一种。你打算怎么做？"
    },
    {
      "id": "ch01_s06_yeting.l47",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我想想。"
    },
    {
      "id": "ch01_s06_yeting.l48",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "缺的我追，夜里的抄工也分我一段。"
    },
    {
      "id": "ch01_s06_yeting.l49",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch01_s06_yeting.l50",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不能谁改规矩，都让你熬夜。"
    },
    {
      "id": "ch01_s06_yeting.l51",
      "who": "narr",
      "kind": "aside",
      "text": "唐简把空白簿页推到你手边。"
    },
    {
      "id": "ch01_s06_yeting.l52",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "那就留下这一页，做完再走。"
    }
  ],
  "choices": [
    {
      "id": "ch01_s06_yeting.cA",
      "text": "先领布，我记下缺线再追领",
      "effects": {
        "shi": 1,
        "ming": -1,
        "flag.supply_issue_now": true
      },
      "irreversible": false,
      "goto": "ch01_s07_yuanye"
    },
    {
      "id": "ch01_s06_yeting.cB",
      "text": "等布线齐了，我留下补抄",
      "effects": {
        "ming": 1,
        "shi": -1,
        "flag.supply_wait_full": true
      },
      "irreversible": false,
      "goto": "ch01_s07_yuanye"
    }
  ]
}
