{
  "id": "ch01_s05_yuanye",
  "chapter": 1,
  "act": 1,
  "scene": "yuanye",
  "palette": "ink",
  "cast": [
    "wuze",
    "adi"
  ],
  "weightless": true,
  "leavesLetter": [],
  "purpose": "两个人容许自己什么也不做成",
  "lines": [
    {
      "id": "ch01_s05_yuanye.l1",
      "who": "narr",
      "kind": "aside",
      "text": "隔日从书阁出来，你绕到苑墙下找阿荻。"
    },
    {
      "id": "ch01_s05_yuanye.l2",
      "who": "narr",
      "kind": "aside",
      "text": "苑墙挡住了北风，落叶晒出干草味，阿荻在树下仰着脸。"
    },
    {
      "id": "ch01_s05_yuanye.l3",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "阿荻。"
    },
    {
      "id": "ch01_s05_yuanye.l4",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "嗯？"
    },
    {
      "id": "ch01_s05_yuanye.l5",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "看什么？"
    },
    {
      "id": "ch01_s05_yuanye.l6",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "没看见，听见了。"
    },
    {
      "id": "ch01_s05_yuanye.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "听见了……"
    },
    {
      "id": "ch01_s05_yuanye.l8",
      "who": "narr",
      "kind": "aside",
      "text": "叶子里落下两声鸟鸣。"
    },
    {
      "id": "ch01_s05_yuanye.l9",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "是这样？啾，啾——"
    },
    {
      "id": "ch01_s05_yuanye.l10",
      "who": "adi",
      "expr": "open",
      "kind": "say",
      "text": "等等！"
    },
    {
      "id": "ch01_s05_yuanye.l11",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "怎么？"
    },
    {
      "id": "ch01_s05_yuanye.l12",
      "who": "adi",
      "expr": "open",
      "kind": "say",
      "text": "你这只在打喷嚏。"
    },
    {
      "id": "ch01_s05_yuanye.l13",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "喷嚏？"
    },
    {
      "id": "ch01_s05_yuanye.l14",
      "who": "adi",
      "expr": "open",
      "kind": "say",
      "text": "真有鸟听懂，还要来问你冷不冷。"
    },
    {
      "id": "ch01_s05_yuanye.l15",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "你来。"
    },
    {
      "id": "ch01_s05_yuanye.l16",
      "who": "narr",
      "kind": "aside",
      "text": "阿荻抿嘴吹出细气，冷风漏进你的领口，你缩了一下肩。"
    },
    {
      "id": "ch01_s05_yuanye.l17",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "你这只……"
    },
    {
      "id": "ch01_s05_yuanye.l18",
      "who": "adi",
      "expr": "open",
      "kind": "say",
      "text": "如何？"
    },
    {
      "id": "ch01_s05_yuanye.l19",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "还没醒，我只听见一口气。"
    },
    {
      "id": "ch01_s05_yuanye.l20",
      "who": "adi",
      "expr": "open",
      "kind": "say",
      "text": "它困着呢。"
    },
    {
      "id": "ch01_s05_yuanye.l21",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "也罢。"
    },
    {
      "id": "ch01_s05_yuanye.l22",
      "who": "narr",
      "kind": "aside",
      "text": "两个人笑了一会儿。树上的鸟不叫了。"
    },
    {
      "id": "ch01_s05_yuanye.l23",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "再试一声？"
    },
    {
      "id": "ch01_s05_yuanye.l24",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "等它。"
    },
    {
      "id": "ch01_s05_yuanye.l25",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch01_s05_yuanye.l26",
      "who": "narr",
      "kind": "aside",
      "text": "你们坐着，谁也没再出声。"
    },
    {
      "id": "ch01_s05_yuanye.l27",
      "who": "narr",
      "kind": "aside",
      "text": "过了一会儿，叶子里又响了。"
    },
    {
      "id": "ch01_s05_yuanye.l28",
      "who": "narr",
      "kind": "aside",
      "text": "你向阿荻摆摆手，仍坐着听。"
    }
  ],
  "goto": "ch01_s06_yeting"
}
