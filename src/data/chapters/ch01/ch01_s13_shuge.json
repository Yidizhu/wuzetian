{
  "id": "ch01_s13_shuge",
  "chapter": 1,
  "act": 1,
  "scene": "shuge",
  "palette": "ink",
  "cast": [
    "wuze",
    "shenheng"
  ],
  "require": {
    "affinity.shenheng": {
      "gte": 4
    }
  },
  "weightless": true,
  "leavesLetter": [],
  "purpose": "两个人为茶的浓淡认真一会儿，又不必分出答案",
  "lines": [
    {
      "id": "ch01_s13_shuge.l1",
      "who": "narr",
      "kind": "aside",
      "text": "你留在书阁，随沈衡坐到檐下。"
    },
    {
      "id": "ch01_s13_shuge.l2",
      "who": "narr",
      "kind": "aside",
      "text": "檐下反光亮到书阁卷架半腰，两杯茶搁凉了，一点热气也没有。",
      "image": "e39_ch01_s13_l2"
    },
    {
      "id": "ch01_s13_shuge.l3",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "左边淡。"
    },
    {
      "id": "ch01_s13_shuge.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "左边？"
    },
    {
      "id": "ch01_s13_shuge.l5",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch01_s13_shuge.l6",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "方才可说右边。"
    },
    {
      "id": "ch01_s13_shuge.l7",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "你换过。"
    },
    {
      "id": "ch01_s13_shuge.l8",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "我换的是——"
    },
    {
      "id": "ch01_s13_shuge.l9",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "杯子。"
    },
    {
      "id": "ch01_s13_shuge.l10",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "手，杯子没动。"
    },
    {
      "id": "ch01_s13_shuge.l11",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "手？"
    },
    {
      "id": "ch01_s13_shuge.l12",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "你不信，两杯都尝一口。"
    },
    {
      "id": "ch01_s13_shuge.l13",
      "who": "narr",
      "kind": "aside",
      "text": "沈衡各试了一口，眉头很轻地皱起来。"
    },
    {
      "id": "ch01_s13_shuge.l14",
      "who": "shenheng",
      "expr": "guarded",
      "kind": "say",
      "text": "都淡。"
    },
    {
      "id": "ch01_s13_shuge.l15",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "都淡……"
    },
    {
      "id": "ch01_s13_shuge.l16",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "怎么还分左右呢？"
    },
    {
      "id": "ch01_s13_shuge.l17",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "方才明明尝出来了，让你问得记不得。"
    },
    {
      "id": "ch01_s13_shuge.l18",
      "who": "narr",
      "kind": "aside",
      "text": "你看她把杯沿转了半圈，唇刚离开，杯子又搁回案上。"
    },
    {
      "id": "ch01_s13_shuge.l19",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "这杯给我。"
    },
    {
      "id": "ch01_s13_shuge.l20",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "还没分出哪杯淡。"
    },
    {
      "id": "ch01_s13_shuge.l21",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "不分了。就要你这杯。"
    },
    {
      "id": "ch01_s13_shuge.l22",
      "who": "narr",
      "kind": "aside",
      "text": "沈衡手停在杯边，看了你一眼，才把杯子推过来。",
      "image": "shenheng_9_liangcha"
    },
    {
      "id": "ch01_s13_shuge.l23",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "拿着。别又换回去。"
    },
    {
      "id": "ch01_s13_shuge.l24",
      "who": "self",
      "kind": "inner",
      "text": "（她明白了。我没说浓淡。）"
    },
    {
      "id": "ch01_s13_shuge.l25",
      "who": "narr",
      "kind": "aside",
      "text": "你接来喝了一口。她拿起另一杯，没再报浓淡。"
    },
    {
      "id": "ch01_s13_shuge.l26",
      "who": "narr",
      "kind": "aside",
      "text": "两只杯子各留在手里，你陪她喝到见底。"
    }
  ],
  "goto": "ch01_s17_yeting"
}
