{
  "id": "ch01_s13_shuge",
  "chapter": 1,
  "act": 1,
  "scene": "shuge",
  "palette": "ink",
  "cast": [
    "wuze",
    "shenheng"
  ],
  "require": {
    "affinity.shenheng": {
      "gte": 4
    }
  },
  "weightless": true,
  "leavesLetter": [],
  "purpose": "两个人为茶的浓淡认真一会儿，又不必分出答案",
  "lines": [
    {
      "id": "ch01_s13_shuge.l1",
      "who": "narr",
      "kind": "aside",
      "text": "你留在书阁，随沈衡坐到檐下。"
    },
    {
      "id": "ch01_s13_shuge.l2",
      "who": "narr",
      "kind": "aside",
      "text": "檐下反光亮到书阁卷架半腰，两杯茶搁凉了，一点热气也没有。"
    },
    {
      "id": "ch01_s13_shuge.l3",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "左边淡。"
    },
    {
      "id": "ch01_s13_shuge.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "左边？"
    },
    {
      "id": "ch01_s13_shuge.l5",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch01_s13_shuge.l6",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "方才可说右边。"
    },
    {
      "id": "ch01_s13_shuge.l7",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "你换过。"
    },
    {
      "id": "ch01_s13_shuge.l8",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "我换的是——"
    },
    {
      "id": "ch01_s13_shuge.l9",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "杯子。"
    },
    {
      "id": "ch01_s13_shuge.l10",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "手，杯子没动。"
    },
    {
      "id": "ch01_s13_shuge.l11",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "手？"
    },
    {
      "id": "ch01_s13_shuge.l12",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "你不信，两杯都尝一口。"
    },
    {
      "id": "ch01_s13_shuge.l13",
      "who": "narr",
      "kind": "aside",
      "text": "沈衡各试了一口，眉头很轻地皱起来。"
    },
    {
      "id": "ch01_s13_shuge.l14",
      "who": "shenheng",
      "expr": "guarded",
      "kind": "say",
      "text": "都淡。"
    },
    {
      "id": "ch01_s13_shuge.l15",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "都淡……"
    },
    {
      "id": "ch01_s13_shuge.l16",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "怎么还分左右呢？"
    },
    {
      "id": "ch01_s13_shuge.l17",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "方才明明尝出来了，让你问得记不得。"
    },
    {
      "id": "ch01_s13_shuge.l18",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch01_s13_shuge.l19",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "总有一杯……"
    },
    {
      "id": "ch01_s13_shuge.l20",
      "who": "narr",
      "kind": "aside",
      "text": "你把左杯推过去，她把右杯推回来。"
    },
    {
      "id": "ch01_s13_shuge.l21",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这回算换过了。"
    },
    {
      "id": "ch01_s13_shuge.l22",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "这回。"
    },
    {
      "id": "ch01_s13_shuge.l23",
      "who": "shenheng",
      "expr": "open",
      "kind": "say",
      "text": "算。"
    },
    {
      "id": "ch01_s13_shuge.l24",
      "who": "narr",
      "kind": "aside",
      "text": "两人又喝了一口，没有再报浓淡。"
    },
    {
      "id": "ch01_s13_shuge.l25",
      "who": "narr",
      "kind": "aside",
      "text": "你挽好袖口，把茶杯放回两人中间。"
    }
  ],
  "goto": "ch01_s17_yeting"
}
