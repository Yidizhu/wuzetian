{
  "id": "ch01_s07_yuanye",
  "chapter": 1,
  "act": 1,
  "scene": "yuanye",
  "palette": "ink",
  "cast": [
    "wuze",
    "peizhaoye"
  ],
  "weightless": false,
  "leavesLetter": [
    "peizhaoye"
  ],
  "purpose": "亲手接近那匹马，也看见裴照夜不敢轻许归期的缘由",
  "lines": [
    {
      "id": "ch01_s07_yuanye.l1",
      "who": "narr",
      "kind": "aside",
      "text": "次日，园门边的积水映着晴光，那匹马正低头嗅草。"
    },
    {
      "id": "ch01_s07_yuanye.l2",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "照夜，那日踢桶的？"
    },
    {
      "id": "ch01_s07_yuanye.l3",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "耳尖缺的那一点，认得？"
    },
    {
      "id": "ch01_s07_yuanye.l4",
      "who": "narr",
      "kind": "aside",
      "text": "你走近，它抬头。裴照夜没有拉着它来迎你。"
    },
    {
      "id": "ch01_s07_yuanye.l5",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "站侧边，让它看见。别急着伸手。"
    },
    {
      "id": "ch01_s07_yuanye.l6",
      "who": "narr",
      "kind": "aside",
      "text": "马闻了闻你垂下的袖口，鼻息暖而潮。"
    },
    {
      "id": "ch01_s07_yuanye.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "现在呢？"
    },
    {
      "id": "ch01_s07_yuanye.l8",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "可以。这里。"
    },
    {
      "id": "ch01_s07_yuanye.l9",
      "who": "narr",
      "kind": "aside",
      "text": "你用掌根碰上它颈侧，短毛底下轻轻一颤。"
    },
    {
      "id": "ch01_s07_yuanye.l10",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "好，手拿回来。今日够了。"
    },
    {
      "id": "ch01_s07_yuanye.l11",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "我还以为要等它喜欢我。"
    },
    {
      "id": "ch01_s07_yuanye.l12",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "它不讨厌，已经很忙了。"
    },
    {
      "id": "ch01_s07_yuanye.l13",
      "who": "narr",
      "kind": "aside",
      "text": "她递给你一方干布，自己去解湿缰。"
    },
    {
      "id": "ch01_s07_yuanye.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你的人什么时候能走？听说已经准了。"
    },
    {
      "id": "ch01_s07_yuanye.l15",
      "who": "peizhaoye",
      "expr": "guarded",
      "kind": "say",
      "text": "准了。钱还没齐。"
    },
    {
      "id": "ch01_s07_yuanye.l16",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "先定日子，办钱的人也不敢一直拖。"
    },
    {
      "id": "ch01_s07_yuanye.l17",
      "who": "peizhaoye",
      "expr": "guarded",
      "kind": "say",
      "text": "我从前也这样催过，日子到了，她背着行囊来问，钱仍不在我手里。"
    },
    {
      "id": "ch01_s07_yuanye.l18",
      "who": "narr",
      "kind": "aside",
      "text": "她拉平缰绳上一个折处，许久没有松开。"
    },
    {
      "id": "ch01_s07_yuanye.l19",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "所以以后都不许日子？她们总得有个盼头。"
    },
    {
      "id": "ch01_s07_yuanye.l20",
      "who": "peizhaoye",
      "expr": "guarded",
      "kind": "say",
      "text": "我能答应明日去催，不能拿她再等一回，证明我今日说得好听。"
    },
    {
      "id": "ch01_s07_yuanye.l21",
      "who": "narr",
      "kind": "aside",
      "text": "马把鼻子伸向干布，抢去一个角。你赶忙托住。"
    },
    {
      "id": "ch01_s07_yuanye.l22",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "这个倒有个准日子，今日就要吃。"
    },
    {
      "id": "ch01_s07_yuanye.l23",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "布不准吃。草在那边。"
    },
    {
      "id": "ch01_s07_yuanye.l24",
      "who": "narr",
      "kind": "aside",
      "text": "她拨开马嘴，用湿指在石上画出一道弯。"
    },
    {
      "id": "ch01_s07_yuanye.l25",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "这条路，不赶军程时我想再走一次，溪边有摊子，饼总烤得很慢。"
    },
    {
      "id": "ch01_s07_yuanye.l26",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "你还记得饼？"
    },
    {
      "id": "ch01_s07_yuanye.l27",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "记得。比记得路的人多。"
    },
    {
      "id": "ch01_s07_yuanye.l28",
      "who": "narr",
      "kind": "aside",
      "text": "那道水痕快干了，她又给你指了一遍转弯处。"
    }
  ],
  "choices": [
    {
      "id": "ch01_s07_yuanye.cA",
      "text": "我陪你催，但不替你许归期",
      "effects": {
        "affinity.peizhaoye": 3,
        "flag.pei_no_departure_date": true
      },
      "irreversible": false,
      "goto": "ch01_s08_shuge"
    },
    {
      "id": "ch01_s07_yuanye.cB",
      "text": "日子仍要问，我陪你逐项核",
      "effects": {
        "affinity.peizhaoye": 3,
        "flag.pei_seek_departure_date": true
      },
      "irreversible": false,
      "goto": "ch01_s08_shuge"
    }
  ]
}
