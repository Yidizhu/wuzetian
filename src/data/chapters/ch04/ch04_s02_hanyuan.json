{
  "id": "ch04_s02_hanyuan",
  "chapter": 4,
  "act": 4,
  "scene": "hanyuan",
  "palette": "gold",
  "cast": [
    "wuze",
    "liqinghe",
    "shenheng",
    "tangjian",
    "songhuizhen"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "受理结契照料来件，并选择自己异议的存处",
  "lines": [
    {
      "id": "ch04_s02_hanyuan.l1",
      "who": "narr",
      "kind": "aside",
      "text": "龙尾道的风吹到殿门，远处入席的脚步一声比一声散。"
    },
    {
      "id": "ch04_s02_hanyuan.l2",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "病者指定了照料的人，病舍却不认她的凭，取药的时辰已经耽搁一回。"
    },
    {
      "id": "ch04_s02_hanyuan.l3",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "人现在还在门外？"
    },
    {
      "id": "ch04_s02_hanyuan.l4",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "在。两边都有人守着，没叫她独等。"
    },
    {
      "id": "ch04_s02_hanyuan.l5",
      "who": "narr",
      "kind": "aside",
      "text": "观议席有人说：“结契的妇人招来虹气。”"
    },
    {
      "id": "ch04_s02_hanyuan.l6",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "今晚那服药，谁递给她？"
    },
    {
      "id": "ch04_s02_hanyuan.l7",
      "who": "narr",
      "kind": "aside",
      "text": "唐简用手压住来件，纸角在风里拍了两下。"
    },
    {
      "id": "ch04_s02_hanyuan.l8",
      "when": {
        "ming": {
          "gte": 6
        }
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "你说过“先让她们看清要等多久”。这一回登记等几日，也请照实写。"
    },
    {
      "id": "ch04_s02_hanyuan.l9",
      "when": {
        "ming": {
          "lt": 6
        }
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "这一回登记要等几日？经手人也列上，别只在开头写准了。"
    },
    {
      "id": "ch04_s02_hanyuan.l10",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "先依病者已经签的照料凭送药。新法慢慢议，不能拿今晚的人等它写完。"
    },
    {
      "id": "ch04_s02_hanyuan.l11",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "原有代领凭可以核。这件先去办，另案来报。"
    },
    {
      "id": "ch04_s02_hanyuan.l12",
      "when": {
        "flag.enthroned": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "还有反对你新署用人的原议。"
    },
    {
      "id": "ch04_s02_hanyuan.l13",
      "when": {
        "flag.enthroned": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "拿来。"
    },
    {
      "id": "ch04_s02_hanyuan.l14",
      "when": {
        "flag.enthroned": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "她问近人换个职名，是否仍只有近人能问。主张只登你的答复，反对另存。"
    },
    {
      "id": "ch04_s02_hanyuan.l15",
      "when": {
        "flag.enthroned": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "只看答复，看不出她问过哪一句。"
    },
    {
      "id": "ch04_s02_hanyuan.l16",
      "when": {
        "flag.enthroned": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "两份同存要逐项答，三日内办不完便须记延期，不能只收而不回。"
    },
    {
      "id": "ch04_s02_hanyuan.l17",
      "when": {
        "flag.enthroned": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "若移出议录，原牒暂存。后来查议录的人，便找不到她为什么来。"
    },
    {
      "id": "ch04_s02_hanyuan.l18",
      "when": {
        "flag.declined_crown": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "你交的只算本人意见，不替仍在位的人批。"
    },
    {
      "id": "ch04_s02_hanyuan.l19",
      "when": {
        "flag.liqinghe_won": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "你的反对照收，署谁就记谁；李令仪的答复另列。"
    },
    {
      "id": "ch04_s02_hanyuan.l20",
      "who": "narr",
      "kind": "aside",
      "text": "宋把取药的凭收好，没有留下来等一场掌声。"
    }
  ],
  "dressing": "gongyi",
  "choices": [
    {
      "id": "ch04_s02_hanyuan.cA",
      "text": "原议与答复同收",
      "require": {
        "flag.enthroned": true
      },
      "effects": {
        "flag.ch04_dissent_keep_order": true,
        "flag.ch04_dissent_remove_order": false
      },
      "irreversible": false,
      "goto": "ch04_s03_shuge"
    },
    {
      "id": "ch04_s02_hanyuan.cB",
      "text": "议录只收答复，原议另存",
      "require": {
        "flag.enthroned": true
      },
      "effects": {
        "flag.ch04_dissent_keep_order": false,
        "flag.ch04_dissent_remove_order": true
      },
      "irreversible": false,
      "goto": "ch04_s03_shuge"
    },
    {
      "id": "ch04_s02_hanyuan.cC",
      "text": "递交本人意见，领回存件",
      "require": {
        "flag.enthroned": false
      },
      "effects": {},
      "irreversible": false,
      "goto": "ch04_s08_shuge"
    }
  ]
}
