      "goto": "ch04_s03_shuge"
    },
    {
      "id": "ch04_s02_hanyuan.cB",
      "text": "议录只收答复，原议另存",
      "require": {
        "flag.enthroned": true
      },
      "effects": {
        "flag.ch04_dissent_keep_order": false,
        "flag.ch04_dissent_remove_order": true
      },
      "irreversible": false,
      "goto": "ch04_s03_shuge"
    },
    {
      "id": "ch04_s02_hanyuan.cC",
      "text": "递交本人意见，领回存件",
      "require": {
        "flag.enthroned": false
      },
      "effects": {},
      "irreversible": false,
      "goto": "ch04_s08_shuge"
    }
  ]
}
