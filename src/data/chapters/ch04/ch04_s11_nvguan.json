{
  "id": "ch04_s11_nvguan",
  "chapter": 4,
  "act": 4,
  "scene": "nvguan",
  "palette": "ink",
  "cast": [
    "wuze",
    "xujinghe",
    "wenqiao"
  ],
  "require": {
    "flag.liqinghe_won": true
  },
  "weightless": false,
  "leavesLetter": [],
  "purpose": "把借屋与有偿教习定成实际一月合同",
  "lines": [
    {
      "id": "ch04_s11_nvguan.l1",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "narr",
      "kind": "aside",
      "text": "手边的纸收妥，你到观里问借屋。"
    },
    {
      "id": "ch04_s11_nvguan.l2",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "narr",
      "kind": "aside",
      "text": "次日，女观窗下晾着药筛，晒干的草叶气味混进纸里。",
      "image": "e39_ch04_s11_l2"
    },
    {
      "id": "ch04_s11_nvguan.l3",
      "when": {
        "flag.ch03_consider_school": true,
        "flag.ch04_school_cost_question": false
      },
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "上回说看看，屋的时辰列好了，只借这几段。"
    },
    {
      "id": "ch04_s11_nvguan.l4",
      "when": {
        "flag.ch03_consider_school": true,
        "flag.ch04_school_cost_question": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "只按你能借的时辰用。"
    },
    {
      "id": "ch04_s11_nvguan.l5",
      "when": {
        "flag.ch03_consider_school": false,
        "flag.ch04_school_cost_question": false
      },
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "今日才问，也先看时辰，只借这几段。"
    },
    {
      "id": "ch04_s11_nvguan.l6",
      "when": {
        "flag.ch03_consider_school": false,
        "flag.ch04_school_cost_question": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "先让我看看空在哪时辰。"
    },
    {
      "id": "ch04_s11_nvguan.l7",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "半间，借一月。"
    },
    {
      "id": "ch04_s11_nvguan.l8",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "先前借温的三日过了。病舍和原来的课不挪，只能午后借你半间。"
    },
    {
      "id": "ch04_s11_nvguan.l9",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "早晚仍让原来的人用。"
    },
    {
      "id": "ch04_s11_nvguan.l10",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "买纸照价付。请我教课另算钱，不能买了纸，就算买我半日。"
    },
    {
      "id": "ch04_s11_nvguan.l11",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "两笔分开算。"
    },
    {
      "id": "ch04_s11_nvguan.l12",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你来几回？"
    },
    {
      "id": "ch04_s11_nvguan.l13",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "四回，余下自己教。"
    },
    {
      "id": "ch04_s11_nvguan.l14",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "剩下的，我自己教。"
    },
    {
      "id": "ch04_s11_nvguan.l15",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "narr",
      "kind": "aside",
      "text": "你俯身量开席的宽处，掌心碰到晒热的窗沿。"
    },
    {
      "id": "ch04_s11_nvguan.l16",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "场租纸钱我付，明日课前交清。"
    },
    {
      "id": "ch04_s11_nvguan.l17",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch04_s11_nvguan.l18",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "做不到……就不开，别让人先垫。"
    },
    {
      "id": "ch04_s11_nvguan.l19",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "学字的人只来半日，也给她留位置。停课先说，别叫她误了做工来等。"
    },
    {
      "id": "ch04_s11_nvguan.l20",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "下次——"
    },
    {
      "id": "ch04_s11_nvguan.l21",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "先看纸背。"
    },
    {
      "id": "ch04_s11_nvguan.l22",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "背面还有一行。"
    },
    {
      "id": "ch04_s11_nvguan.l23",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "要停、要改，到几时前得说，都在那里。"
    },
    {
      "id": "ch04_s11_nvguan.l24",
      "when": {
        "flag.ch04_school_cost_question": false
      },
      "who": "self",
      "kind": "inner",
      "text": "（只有四回。剩下的得我来。）"
    },
    {
      "id": "ch04_s11_nvguan.l25",
      "when": {
        "flag.ch04_school_cost_question": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "温将纸钱与教习钱拆成两页，指节上的白痕抵着纸沿。"
    },
    {
      "id": "ch04_s11_nvguan.l26",
      "when": {
        "flag.ch04_school_cost_question": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "没人来……教习钱怎么算？"
    },
    {
      "id": "ch04_s11_nvguan.l27",
      "when": {
        "flag.ch04_school_cost_question": true
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "学生一个都不来？"
    },
    {
      "id": "ch04_s11_nvguan.l28",
      "when": {
        "flag.ch04_school_cost_question": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那一次——"
    },
    {
      "id": "ch04_s11_nvguan.l29",
      "when": {
        "flag.ch04_school_cost_question": true
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "我也空了半日。"
    },
    {
      "id": "ch04_s11_nvguan.l30",
      "when": {
        "flag.ch04_school_cost_question": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你别的活儿已经推了。"
    },
    {
      "id": "ch04_s11_nvguan.l31",
      "when": {
        "flag.ch04_school_cost_question": true
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "对。不能因为她们没来，就扣我的工钱。"
    },
    {
      "id": "ch04_s11_nvguan.l32",
      "when": {
        "flag.ch04_school_cost_question": true
      },
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "照约在课前告知，可以另定。过了时辰，照付。纸背都写了。"
    },
    {
      "id": "ch04_s11_nvguan.l33",
      "when": {
        "flag.ch04_school_cost_question": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这一行我看清了。"
    },
    {
      "id": "ch04_s11_nvguan.l34",
      "when": {
        "flag.ch04_school_cost_question": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "你翻过纸，背面那一行没有添改。"
    }
  ],
  "choices": [
    {
      "id": "ch04_s11_nvguan.cA",
      "text": "按这一月的约定办",
      "effects": {
        "flag.ch04_school_contract": true
      },
      "irreversible": false,
      "goto": "ch04_s12_nvguan"
    },
    {
      "id": "ch04_s11_nvguan.cB",
      "text": "这回先不接",
      "effects": {
        "flag.ch04_school_contract": false
      },
      "irreversible": false,
      "goto": "ch04_s10_yuanye"
    },
    {
      "id": "ch04_s11_nvguan.cC",
      "text": "追问无人来时怎样付钱",
      "require": {
        "cai": {
          "gte": 6
        },
        "flag.ch04_school_cost_question": false
      },
      "effects": {
        "flag.ch04_school_cost_question": true
      },
      "irreversible": false,
      "goto": "ch04_s11_nvguan"
    }
  ]
}
