{
  "id": "ch04_s12_nvguan",
  "chapter": 4,
  "act": 4,
  "scene": "nvguan",
  "palette": "ink",
  "cast": [
    "wuze",
    "wenqiao",
    "adi",
    "xujinghe"
  ],
  "require": {
    "flag.ch04_school_contract": true
  },
  "weightless": false,
  "leavesLetter": [],
  "purpose": "实际开课，允许报名者带自己的工时离开",
  "lines": [
    {
      "id": "ch04_s12_nvguan.l1",
      "who": "narr",
      "kind": "aside",
      "text": "纸背的退改时辰看清了，你带纸进屋。"
    },
    {
      "id": "ch04_s12_nvguan.l2",
      "who": "narr",
      "kind": "aside",
      "text": "午后日光越过门槛，屋里坐席没有铺满；新裁的纸边碰着你的腕。",
      "image": "e39_ch04_s12_l2"
    },
    {
      "id": "ch04_s12_nvguan.l3",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "一月场租、纸钱、四回教习钱都清了。"
    },
    {
      "id": "ch04_s12_nvguan.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "之后我自己接着教。"
    },
    {
      "id": "ch04_s12_nvguan.l5",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "各留称呼，想学的自己说，不上榜的字也教。"
    },
    {
      "id": "ch04_s12_nvguan.l6",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "只学领钱这个。"
    },
    {
      "id": "ch04_s12_nvguan.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那就从你用得着的学。"
    },
    {
      "id": "ch04_s12_nvguan.l8",
      "who": "narr",
      "kind": "aside",
      "text": "她将亲手写过的单据放下，针包留在自己脚边。"
    },
    {
      "id": "ch04_s12_nvguan.l9",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "先读数。"
    },
    {
      "id": "ch04_s12_nvguan.l10",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch04_s12_nvguan.l11",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "这个是九。下边少了一个。"
    },
    {
      "id": "ch04_s12_nvguan.l12",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "哪一个？"
    },
    {
      "id": "ch04_s12_nvguan.l13",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "领。没到手，不能只写付。"
    },
    {
      "id": "ch04_s12_nvguan.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "确实得写谁领到了。"
    },
    {
      "id": "ch04_s12_nvguan.l15",
      "who": "narr",
      "kind": "aside",
      "text": "温把自己的纸翻面，笑了一声，没有替她补那一笔。"
    },
    {
      "id": "ch04_s12_nvguan.l16",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那从这两个……教起。"
    },
    {
      "id": "ch04_s12_nvguan.l17",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "一个付，一个领。"
    },
    {
      "id": "ch04_s12_nvguan.l18",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "付给谁，谁领到。我再——"
    },
    {
      "id": "ch04_s12_nvguan.l19",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "这会儿就走。"
    },
    {
      "id": "ch04_s12_nvguan.l20",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch04_s12_nvguan.l21",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "下次带来，不用空半日工才算认真。"
    },
    {
      "id": "ch04_s12_nvguan.l22",
      "who": "narr",
      "kind": "aside",
      "text": "她把“领”字写了两遍，第二遍旁边留着自己划掉的错笔。"
    },
    {
      "id": "ch04_s12_nvguan.l23",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "错的也带走，是你写的。"
    },
    {
      "id": "ch04_s12_nvguan.l24",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "我留着，知道哪里改过。"
    },
    {
      "id": "ch04_s12_nvguan.l25",
      "who": "narr",
      "kind": "aside",
      "text": "阿荻把纸夹进针包，先出了门；其他人仍照自己的快慢写。"
    }
  ],
  "dressing": "kaike",
  "choices": [
    {
      "id": "ch04_s12_nvguan.cA",
      "text": "收好今日的课页",
      "effects": {
        "flag.founded_school": true,
        "flag.road_agreement": false
      },
      "irreversible": false,
      "goto": "ch04_s13_nvguan"
    }
  ]
}
