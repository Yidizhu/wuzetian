{
  "id": "ch04_s09_yuanye",
  "chapter": 4,
  "act": 4,
  "scene": "yuanye",
  "palette": "ink",
  "cast": [
    "wuze",
    "liqinghe"
  ],
  "require": {
    "flag.liqinghe_won": true
  },
  "weightless": false,
  "leavesLetter": [],
  "purpose": "李令仪与落选者在政见不改的前提下，各自亲口决定是否继续相爱",
  "lines": [
    {
      "id": "ch04_s09_yuanye.l1",
      "who": "narr",
      "kind": "aside",
      "text": "书阁的存件收妥，你到苑墙下见李令仪。"
    },
    {
      "id": "ch04_s09_yuanye.l2",
      "who": "narr",
      "kind": "aside",
      "text": "苑墙挡住暮风，李令仪坐在背风的石阶上，手边半张饼已经凉了。"
    },
    {
      "id": "ch04_s09_yuanye.l3",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "反对照原话收了。"
    },
    {
      "id": "ch04_s09_yuanye.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "原话。"
    },
    {
      "id": "ch04_s09_yuanye.l5",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那句钱不够，也收了？"
    },
    {
      "id": "ch04_s09_yuanye.l6",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "收了，下月还得答。"
    },
    {
      "id": "ch04_s09_yuanye.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "下月。"
    },
    {
      "id": "ch04_s09_yuanye.l8",
      "who": "narr",
      "kind": "aside",
      "text": "她把议件卷起，放到另一侧，没有夹进留给你的坐处。"
    },
    {
      "id": "ch04_s09_yuanye.l9",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "我还会来问。"
    },
    {
      "id": "ch04_s09_yuanye.l10",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "你来问，钱的来处就摊开，答不出照记。"
    },
    {
      "id": "ch04_s09_yuanye.l11",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch04_s09_yuanye.l12",
      "who": "narr",
      "kind": "aside",
      "text": "你在石阶下停住，她把卷放到另一侧。"
    },
    {
      "id": "ch04_s09_yuanye.l13",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "我输了。"
    },
    {
      "id": "ch04_s09_yuanye.l14",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "我知道。"
    },
    {
      "id": "ch04_s09_yuanye.l15",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "不用说只差——"
    },
    {
      "id": "ch04_s09_yuanye.l16",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "没打算说。"
    },
    {
      "id": "ch04_s09_yuanye.l17",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch04_s09_yuanye.l18",
      "who": "narr",
      "kind": "aside",
      "text": "她将饼掰下一角，碎屑落在自己膝上，没急着拂掉。"
    },
    {
      "id": "ch04_s09_yuanye.l19",
      "when": {
        "love.liqinghe": true
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "先前相爱的话，我没有收回。"
    },
    {
      "id": "ch04_s09_yuanye.l20",
      "when": {
        "love.liqinghe": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "去远了……未必赶得上时辰。"
    },
    {
      "id": "ch04_s09_yuanye.l21",
      "when": {
        "love.liqinghe": true
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "另约。归期不列朝班，不拿差事换你留下。"
    },
    {
      "id": "ch04_s09_yuanye.l22",
      "when": {
        "love.liqinghe": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "她将饼角放回纸上，给你留出坐处。"
    },
    {
      "id": "ch04_s09_yuanye.l23",
      "when": {
        "love.liqinghe": false
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "公事照来。今晚不替往后答。"
    },
    {
      "id": "ch04_s09_yuanye.l24",
      "when": {
        "love.liqinghe": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "议件我还会送来。"
    },
    {
      "id": "ch04_s09_yuanye.l25",
      "when": {
        "love.liqinghe": false
      },
      "who": "narr",
      "kind": "aside",
      "text": "她将饼角留在自己掌心，没有递到你嘴边。"
    }
  ],
  "choices": [
