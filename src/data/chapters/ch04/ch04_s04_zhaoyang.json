{
  "id": "ch04_s04_zhaoyang",
  "chapter": 4,
  "act": 4,
  "scene": "zhaoyang",
  "palette": "ink",
  "cast": [
    "wuze",
    "tangjian",
    "shenheng",
    "songhuizhen",
    "xujinghe"
  ],
  "require": {
    "flag.enthroned": true
  },
  "weightless": false,
  "leavesLetter": [],
  "purpose": "兑现原案存毁，使照料权不依赖一人代签",
  "lines": [
    {
      "id": "ch04_s04_zhaoyang.l1",
      "who": "narr",
      "kind": "aside",
      "text": "原案的存毁已定，你回昭阳殿核授凭。"
    },
    {
      "id": "ch04_s04_zhaoyang.l2",
      "who": "narr",
      "kind": "aside",
      "text": "次日帷幔已卷起，殿内残留熏香，门口的冷风吹不到案后。"
    },
    {
      "id": "ch04_s04_zhaoyang.l3",
      "when": {
        "flag.ch04_originals_keep_order": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "原案归存，封号、权限、保管人在此，缺字另记。"
    },
    {
      "id": "ch04_s04_zhaoyang.l4",
      "when": {
        "flag.ch04_originals_keep_order": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "另记。"
    },
    {
      "id": "ch04_s04_zhaoyang.l5",
      "when": {
        "flag.ch04_originals_burn_order": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "照你确认的清单，昨夜焚完，执行与在场人留名。"
    },
    {
      "id": "ch04_s04_zhaoyang.l6",
      "when": {
        "flag.ch04_originals_burn_order": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "昨夜。"
    },
    {
      "id": "ch04_s04_zhaoyang.l7",
      "when": {
        "flag.ch04_originals_burn_order": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "沈将辞牒搁在清点单上，印与差牌放在纸旁。"
    },
    {
      "id": "ch04_s04_zhaoyang.l8",
      "when": {
        "flag.ch04_originals_burn_order": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "经手交了，辞署也存原话。"
    },
    {
      "id": "ch04_s04_zhaoyang.l9",
      "when": {
        "flag.ch04_originals_burn_order": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "原话。"
    },
    {
      "id": "ch04_s04_zhaoyang.l10",
      "when": {
        "flag.ch04_originals_burn_order": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "她等唐收清物件，离开了案边。"
    },
    {
      "id": "ch04_s04_zhaoyang.l11",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "药送到了，人见着了。"
    },
    {
      "id": "ch04_s04_zhaoyang.l12",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "见着了。"
    },
    {
      "id": "ch04_s04_zhaoyang.l13",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "两份新法，你与她……想怎么记？"
    },
    {
      "id": "ch04_s04_zhaoyang.l14",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "我说我的，她不在。"
    },
    {
      "id": "ch04_s04_zhaoyang.l15",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你的。"
    },
    {
      "id": "ch04_s04_zhaoyang.l16",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "一法双方自愿入籍，照料、财产逐项说定。"
    },
    {
      "id": "ch04_s04_zhaoyang.l17",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "双方。"
    },
    {
      "id": "ch04_s04_zhaoyang.l18",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "一人没答，不能代填。"
    },
    {
      "id": "ch04_s04_zhaoyang.l19",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "另一法各自授凭，照料、代领、财产分写。"
    },
    {
      "id": "ch04_s04_zhaoyang.l20",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "分写。"
    },
    {
      "id": "ch04_s04_zhaoyang.l21",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "许哪项，只办哪项。"
    },
    {
      "id": "ch04_s04_zhaoyang.l22",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "许哪项。"
    },
    {
      "id": "ch04_s04_zhaoyang.l23",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不入籍，也能进病舍？"
    },
    {
      "id": "ch04_s04_zhaoyang.l24",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "授过照料凭便能核入，不能因未入籍再拦。"
    },
    {
      "id": "ch04_s04_zhaoyang.l25",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch04_s04_zhaoyang.l26",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "给谁看呢？"
    },
    {
      "id": "ch04_s04_zhaoyang.l27",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "本人、照料人与核办者看，公示办法不列姓名。"
    },
    {
      "id": "ch04_s04_zhaoyang.l28",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "这张给我带回去。"
    },
    {
      "id": "ch04_s04_zhaoyang.l29",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "这张。"
    },
    {
      "id": "ch04_s04_zhaoyang.l30",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "想撤时，另一人——"
    },
    {
      "id": "ch04_s04_zhaoyang.l31",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "不用求她准。"
    },
    {
      "id": "ch04_s04_zhaoyang.l32",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch04_s04_zhaoyang.l33",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "各撤自己的授权，已交钱物另核清。"
    },
    {
      "id": "ch04_s04_zhaoyang.l34",
      "who": "narr",
      "kind": "aside",
      "text": "宋把空着第二个署名的纸折好，没有请你替她催。"
    },
    {
      "id": "ch04_s04_zhaoyang.l35",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "入籍双方核，省举凭；各授少问私事，多走几次。"
    },
    {
      "id": "ch04_s04_zhaoyang.l36",
      "who": "narr",
      "kind": "aside",
      "text": "你把两份授凭办法分开放好，等着落笔。"
    }
  ],
