{
  "id": "ch04_s08_shuge",
  "chapter": 4,
  "act": 4,
  "scene": "shuge",
  "palette": "ink",
  "cast": [
    "wuze",
    "tangjian",
    "shenheng",
    "peizhaoye",
    "wenqiao",
    "liqinghe"
  ],
  "require": {
    "flag.enthroned": false
  },
  "weightless": false,
  "leavesLetter": [],
  "purpose": "晚间交清个人存件并保留关系与生活的另答",
  "lines": [
    {
      "id": "ch04_s08_shuge.l1",
      "who": "narr",
      "kind": "aside",
      "text": "宋的取药凭已收好，当晚你在书阁领存件。"
    },
    {
      "id": "ch04_s08_shuge.l2",
      "who": "narr",
      "kind": "aside",
      "text": "当晚书阁只点罩灯，冷风沿卷架底下走，唐把你的存件放在灯外。"
    },
    {
      "id": "ch04_s08_shuge.l3",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "本人回凭，原话存了，不带任免，不替在位者点头。"
    },
    {
      "id": "ch04_s08_shuge.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "本人。"
    },
    {
      "id": "ch04_s08_shuge.l5",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "名字这行给我看看。"
    },
    {
      "id": "ch04_s08_shuge.l6",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "这行。"
    },
    {
      "id": "ch04_s08_shuge.l7",
      "who": "narr",
      "kind": "aside",
      "text": "你用指腹压平纸，粗边擦到掌上旧裂口。"
    },
    {
      "id": "ch04_s08_shuge.l8",
      "when": {
        "flag.declined_crown": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "公差交清了，今晚领私物，不用再填新职。"
    },
    {
      "id": "ch04_s08_shuge.l9",
      "when": {
        "flag.declined_crown": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "私物。"
    },
    {
      "id": "ch04_s08_shuge.l10",
      "when": {
        "flag.liqinghe_won": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "反对留着，她逐条答，不能拿见面换收回。"
    },
    {
      "id": "ch04_s08_shuge.l11",
      "when": {
        "flag.liqinghe_won": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "逐条。"
    },
    {
      "id": "ch04_s08_shuge.l12",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "半张纸在这，别人没准记的仍没添。"
    },
    {
      "id": "ch04_s08_shuge.l13",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "半张。"
    },
    {
      "id": "ch04_s08_shuge.l14",
      "when": {
        "flag.shen_after_intercept_meet": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "那回另听的回话，没夹公卷。"
    },
    {
      "id": "ch04_s08_shuge.l15",
      "when": {
        "flag.shen_after_intercept_meet": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "另听。"
    },
    {
      "id": "ch04_s08_shuge.l16",
      "when": {
        "flag.shen_ch02_letter_poem": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "回诗留在无案号的纸里。"
    },
    {
      "id": "ch04_s08_shuge.l17",
      "when": {
        "flag.shen_ch02_letter_poem": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "回诗。"
    },
    {
      "id": "ch04_s08_shuge.l18",
      "when": {
        "flag.shen_ch02_letter_silent": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "那封没回，我没再催。"
    },
    {
      "id": "ch04_s08_shuge.l19",
      "when": {
        "flag.shen_ch02_letter_silent": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch04_s08_shuge.l20",
      "when": {
        "flag.shen_after_intercept_scope": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "截信后只核已读范围，没添私话。"
    },
    {
      "id": "ch04_s08_shuge.l21",
      "when": {
        "flag.shen_after_intercept_scope": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "范围。"
    },
    {
      "id": "ch04_s08_shuge.l22",
      "when": {
        "flag.shen_after_intercept_private_stop": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "你要公事另纸，私笺我收了。"
    },
    {
      "id": "ch04_s08_shuge.l23",
      "when": {
        "flag.shen_after_intercept_private_stop": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "另纸。"
    },
    {
      "id": "ch04_s08_shuge.l24",
      "when": {
        "flag.shen_ch03_letter_meet": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "撤差那封说有空再约，日子没替你填。"
    },
    {
      "id": "ch04_s08_shuge.l25",
      "when": {
        "flag.shen_ch03_letter_meet": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "有空。"
    },
    {
      "id": "ch04_s08_shuge.l26",
      "when": {
        "flag.shen_ch03_letter_wait": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "撤差那封私见先缓，复议照来往。"
    },
    {
      "id": "ch04_s08_shuge.l27",
      "when": {
        "flag.shen_ch03_letter_wait": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "先缓。"
    },
    {
      "id": "ch04_s08_shuge.l28",
      "when": {
        "flag.shen_ch03_letter_stop": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "你叫停私笺，这回只带交付凭。"
    },
    {
      "id": "ch04_s08_shuge.l29",
      "when": {
        "flag.shen_ch03_letter_stop": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "交付凭。"
    },
    {
      "id": "ch04_s08_shuge.l30",
      "when": {
        "flag.shen_ch03_letter_poem": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "撤差的回诗夹旧笺，没夹驳语。"
    },
    {
      "id": "ch04_s08_shuge.l31",
      "when": {
        "flag.shen_ch03_letter_poem": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "旧笺。"
    },
    {
      "id": "ch04_s08_shuge.l32",
      "when": {
        "flag.shen_ch03_letter_silent": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "撤差那封没回，余纸收了。"
    },
    {
      "id": "ch04_s08_shuge.l33",
      "when": {
        "flag.shen_ch03_letter_silent": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch04_s08_shuge.l34",
      "who": "narr",
      "kind": "aside",
      "text": "裴从门边进来，先搓热握缰的手，才接自己的路书。"
    },
    {
      "id": "ch04_s08_shuge.l35",
      "when": {
        "flag.pei_ch02_spare_time": true
      },
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "这半刻是我自己留的空。"
    },
    {
      "id": "ch04_s08_shuge.l36",
      "when": {
        "flag.pei_ch02_spare_time": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "半刻。"
    },
    {
      "id": "ch04_s08_shuge.l37",
      "when": {
        "flag.pei_ch02_letter_poem": true
      },
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "回诗在路书后，没拿去报程。"
    },
    {
      "id": "ch04_s08_shuge.l38",
      "when": {
        "flag.pei_ch02_letter_poem": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "路书后。"
    },
    {
      "id": "ch04_s08_shuge.l39",
      "when": {
        "flag.pei_ch02_letter_silent": true
      },
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "你没回，就没叫人备马。"
    },
    {
      "id": "ch04_s08_shuge.l40",
      "when": {
        "flag.pei_ch02_letter_silent": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch04_s08_shuge.l41",
      "when": {
        "flag.pei_ch02_check_again": true
      },
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "补俸你肯再核，只列那一次账。"
    },
    {
      "id": "ch04_s08_shuge.l42",
      "when": {
        "flag.pei_ch02_check_again": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那一次。"
    },
    {
      "id": "ch04_s08_shuge.l43",
      "when": {
        "flag.pei_ch02_pause_help": true
      },
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "不核账、不同行，我另请人了。"
    },
    {
      "id": "ch04_s08_shuge.l44",
      "when": {
        "flag.pei_ch02_pause_help": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "另请的。"
    },
    {
      "id": "ch04_s08_shuge.l45",
      "when": {
        "flag.pei_ch03_letter_meal": true
      },
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "拔刺那封说吃热的，还没报时辰。"
    },
    {
      "id": "ch04_s08_shuge.l46",
      "when": {
        "flag.pei_ch03_letter_meal": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "时辰。"
    },
    {
      "id": "ch04_s08_shuge.l47",
      "when": {
        "flag.pei_ch03_letter_no_date": true
      },
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "不替旧友定日，那格还空着。"
    },
    {
      "id": "ch04_s08_shuge.l48",
      "when": {
        "flag.pei_ch03_letter_no_date": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "空着。"
    },
    {
      "id": "ch04_s08_shuge.l49",
      "when": {
        "flag.pei_ch03_letter_stop": true
      },
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "私约停了，没多备行囊。"
    },
    {
      "id": "ch04_s08_shuge.l50",
      "when": {
        "flag.pei_ch03_letter_stop": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "行囊。"
    },
    {
      "id": "ch04_s08_shuge.l51",
      "when": {
        "flag.pei_ch03_letter_poem": true
      },
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "拔刺的回诗在路书末，没交署里。"
    },
    {
      "id": "ch04_s08_shuge.l52",
      "when": {
        "flag.pei_ch03_letter_poem": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "末页。"
    },
    {
      "id": "ch04_s08_shuge.l53",
      "when": {
        "flag.pei_ch03_letter_silent": true
      },
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "那封没回，我照值次走，没托人问。"
    },
    {
      "id": "ch04_s08_shuge.l54",
      "when": {
        "flag.pei_ch03_letter_silent": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch04_s08_shuge.l55",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "晚班交完才有半刻，别的差程另核。"
    },
    {
      "id": "ch04_s08_shuge.l56",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "队里——"
    },
    {
      "id": "ch04_s08_shuge.l57",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "不能领个名字走。"
    },
    {
      "id": "ch04_s08_shuge.l58",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "是。"
    },
    {
      "id": "ch04_s08_shuge.l59",
      "who": "narr",
      "kind": "aside",
      "text": "温把样纸递过来，坐在灯照不到的席角。"
    },
    {
      "id": "ch04_s08_shuge.l60",
      "when": {
        "flag.wen_ch02_read_again": true
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "按你快慢读，没替你圈停处。"
    },
    {
      "id": "ch04_s08_shuge.l61",
      "when": {
        "flag.wen_ch02_read_again": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "停处。"
    },
    {
      "id": "ch04_s08_shuge.l62",
      "when": {
        "flag.wen_ch02_letter_poem": true
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "回诗整张留着，没改字。"
    },
    {
      "id": "ch04_s08_shuge.l63",
      "when": {
        "flag.wen_ch02_letter_poem": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "整张。"
    },
    {
      "id": "ch04_s08_shuge.l64",
      "when": {
        "flag.wen_ch02_letter_silent": true
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "没回，后来的改稿留我案上了。"
    },
    {
      "id": "ch04_s08_shuge.l65",
      "when": {
        "flag.wen_ch02_letter_silent": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch04_s08_shuge.l66",
      "when": {
        "flag.wen_ch02_keep_without_pardon": true
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "折鱼那封收了，也照你说的不猜她。"
    },
    {
      "id": "ch04_s08_shuge.l67",
      "when": {
        "flag.wen_ch02_keep_without_pardon": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不猜。"
    },
    {
      "id": "ch04_s08_shuge.l68",
      "when": {
        "flag.wen_ch02_private_pause": true
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "只谈公事，私笺没充核稿。"
    },
    {
      "id": "ch04_s08_shuge.l69",
      "when": {
        "flag.wen_ch02_private_pause": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "公事。"
    },
    {
      "id": "ch04_s08_shuge.l70",
      "when": {
        "flag.wen_ch03_letter_sing": true
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "退钱那封还想听唱错，曲子没催准。"
    },
    {
      "id": "ch04_s08_shuge.l71",
      "when": {
        "flag.wen_ch03_letter_sing": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "唱错。"
    },
    {
      "id": "ch04_s08_shuge.l72",
      "when": {
        "flag.wen_ch03_letter_fair_pay": true
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "新槽钱另算，稿工的钱没挪。"
    },
    {
      "id": "ch04_s08_shuge.l73",
      "when": {
        "flag.wen_ch03_letter_fair_pay": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "稿工。"
    },
    {
      "id": "ch04_s08_shuge.l74",
      "when": {
        "flag.wen_ch03_letter_stop": true
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "暂不合唱，曲旁没写你名。"
    },
    {
      "id": "ch04_s08_shuge.l75",
      "when": {
        "flag.wen_ch03_letter_stop": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "暂不。"
    },
    {
      "id": "ch04_s08_shuge.l76",
      "when": {
        "flag.wen_ch03_letter_poem": true
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "退钱的回诗，用你的字试过调。"
    },
    {
      "id": "ch04_s08_shuge.l77",
      "when": {
        "flag.wen_ch03_letter_poem": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "试调。"
    },
    {
      "id": "ch04_s08_shuge.l78",
      "when": {
        "flag.wen_ch03_letter_silent": true
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "退钱那封没回，收了笺，照旧刷槽。"
    },
    {
      "id": "ch04_s08_shuge.l79",
      "when": {
        "flag.wen_ch03_letter_silent": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch04_s08_shuge.l80",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "我这里只够晾纸，教字先问许能借哪半间。"
    },
    {
      "id": "ch04_s08_shuge.l81",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "哪半间。"
    },
    {
