  "scene": "shuge",
  "palette": "ink",
  "cast": [
    "wuze",
    "tangjian",
    "shenheng",
    "peizhaoye",
    "wenqiao",
    "liqinghe"
  ],
  "require": {
    "flag.enthroned": false
  },
  "weightless": false,
  "leavesLetter": [],
  "purpose": "晚间交清个人存件并保留关系与生活的另答",
  "lines": [
    {
      "id": "ch04_s08_shuge.l1",
      "who": "narr",
      "kind": "aside",
      "text": "宋收好取药凭据，当晚你去书阁拿留给自己的那份文书。"
    },
    {
      "id": "ch04_s08_shuge.l2",
      "who": "narr",
      "kind": "aside",
      "text": "当晚书阁只点罩灯，冷风沿卷架底下走，唐把你的存件放在灯外。"
    },
    {
      "id": "ch04_s08_shuge.l3",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "这是给你的回话，原话存下了。没任免谁，也不替在位的人点头。"
    },
    {
      "id": "ch04_s08_shuge.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "只答我自己提的那件。"
    },
    {
      "id": "ch04_s08_shuge.l5",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "名字这行给我看看。"
    },
    {
      "id": "ch04_s08_shuge.l6",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "在这儿，没改。"
    },
    {
      "id": "ch04_s08_shuge.l7",
      "who": "narr",
      "kind": "aside",
      "text": "你用指腹压平纸，粗边擦到掌上旧裂口。"
    },
    {
      "id": "ch04_s08_shuge.l8",
      "when": {
        "flag.declined_crown": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "公差交清了，今晚领私物，不用再填新职。"
    },
    {
      "id": "ch04_s08_shuge.l9",
      "when": {
        "flag.declined_crown": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "拿齐就好。"
    },
    {
      "id": "ch04_s08_shuge.l10",
      "when": {
        "flag.liqinghe_won": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "反对的话留下了，她会逐条答，不能拿私下相见换你收回。"
    },
    {
      "id": "ch04_s08_shuge.l11",
      "when": {
        "flag.liqinghe_won": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那就一条条等她答。"
    },
    {
      "id": "ch04_s08_shuge.l12",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "半张纸在这。旁人没准许记的，我仍没添。"
    },
    {
      "id": "ch04_s08_shuge.l13",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "空的仍让它空着。"
    }
  ],
  "goto": "ch04_s05p_shuge"
}
