{
  "id": "ch04_s05_yeting",
  "chapter": 4,
  "act": 4,
  "scene": "yeting",
  "palette": "ink",
  "cast": [
    "wuze",
    "tangjian",
    "songhuizhen",
    "adi",
    "shenheng",
    "peizhaoye",
    "wenqiao",
    "liqinghe"
  ],
  "require": {
    "flag.enthroned": true
  },
  "weightless": false,
  "leavesLetter": [],
  "purpose": "付清这批劳动并展示复核如何实际运行",
  "lines": [
    {
      "id": "ch04_s05_yeting.l1",
      "who": "narr",
      "kind": "aside",
      "text": "授凭办法已颁下，你到掖庭核领款。"
    },
    {
      "id": "ch04_s05_yeting.l2",
      "who": "narr",
      "kind": "aside",
      "text": "数日后，掖庭晾起洗过的布，湿气贴着廊柱。阿荻把钱一枚枚分开。"
    },
    {
      "id": "ch04_s05_yeting.l3",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "够了，我收。"
    },
    {
      "id": "ch04_s05_yeting.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "够了。"
    },
    {
      "id": "ch04_s05_yeting.l5",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "还留这边做么？"
    },
    {
      "id": "ch04_s05_yeting.l6",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "那边定了，今日只领钱。"
    },
    {
      "id": "ch04_s05_yeting.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "领钱。"
    },
    {
      "id": "ch04_s05_yeting.l8",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "还赶得上饭，别拿稿叫她顺路。"
    },
    {
      "id": "ch04_s05_yeting.l9",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "代班、核旧款与观中俸钱各有收凭，未付另列。"
    },
    {
      "id": "ch04_s05_yeting.l10",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "未付的。"
    },
    {
      "id": "ch04_s05_yeting.l11",
      "who": "narr",
      "kind": "aside",
      "text": "阿荻提起自己的布包，走到门口，又回身拿走漏下的针。"
    },
    {
      "id": "ch04_s05_yeting.l12",
      "when": {
        "flag.ch04_contract_registration": true
      },
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "两人核的收件了，我这第二个名等她自己答。"
    },
    {
      "id": "ch04_s05_yeting.l13",
      "when": {
        "flag.ch04_contract_registration": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "等她。"
    },
    {
      "id": "ch04_s05_yeting.l14",
      "when": {
        "flag.ch04_separate_authorization": true
      },
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "我的照料凭收了，她那份另定，没带来代签。"
    },
    {
      "id": "ch04_s05_yeting.l15",
      "when": {
        "flag.ch04_separate_authorization": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "她那份。"
    },
    {
      "id": "ch04_s05_yeting.l16",
      "when": {
        "flag.ch04_dissent_retained": true,
        "flag.ch04_originals_retained": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "她依权限查原案，指出少字，更正附上，具名答了。"
    },
    {
      "id": "ch04_s05_yeting.l17",
      "when": {
        "flag.ch04_dissent_retained": true,
        "flag.ch04_originals_retained": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "更正。"
    },
    {
      "id": "ch04_s05_yeting.l18",
      "when": {
        "flag.ch04_dissent_retained": true,
        "flag.ch04_originals_retained": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "原摘要也留，叫人知道改哪笔。"
    },
    {
      "id": "ch04_s05_yeting.l19",
      "when": {
        "flag.ch04_dissent_retained": false
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "议录只查到你的答复，补工钱也补不回原问。"
    },
    {
      "id": "ch04_s05_yeting.l20",
      "when": {
        "flag.ch04_dissent_retained": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "原问。"
    },
    {
      "id": "ch04_s05_yeting.l21",
      "when": {
        "flag.ch04_dissent_retained": true,
        "flag.ch04_originals_retained": false
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "异议在，原件烧了，只能记漏字，不能验原笔。"
    },
    {
      "id": "ch04_s05_yeting.l22",
      "when": {
        "flag.ch04_dissent_retained": true,
        "flag.ch04_originals_retained": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不能验。"
    }
  ],
  "goto": "ch04_s05p_shuge"
}
