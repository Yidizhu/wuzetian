{
  "id": "ch04_s15_yilu",
  "chapter": 4,
  "act": 4,
  "scene": "yilu",
  "palette": "ink",
  "cast": [
    "wuze",
    "peizhaoye",
    "tangjian"
  ],
  "require": {
    "flag.ch04_road_contract": true
  },
  "weightless": false,
  "leavesLetter": [],
  "purpose": "领路费、交凭并真正启程",
  "lines": [
    {
      "id": "ch04_s15_yilu.l1",
      "who": "narr",
      "kind": "aside",
      "text": "天亮时驿路泥还湿，车辙压出细水，轮边的泥点溅到你的靴面。"
    },
    {
      "id": "ch04_s15_yilu.l2",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "路费在袋里，当面点。"
    },
    {
      "id": "ch04_s15_yilu.l3",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "齐。"
    },
    {
      "id": "ch04_s15_yilu.l4",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "俸凭另收好。这不是裴将军替你领的，回来也向这边核，不往她的军账里并。"
    },
    {
      "id": "ch04_s15_yilu.l5",
      "who": "narr",
      "kind": "aside",
      "text": "你把自己的收凭递回去，唐在交付时辰下落笔。"
    },
    {
      "id": "ch04_s15_yilu.l6",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "我队先行。"
    },
    {
      "id": "ch04_s15_yilu.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我随这一车。"
    },
    {
      "id": "ch04_s15_yilu.l8",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "车停你就歇，别为赶我多走夜路；这段差程写的是核粮，不是一路追到我面前。"
    },
    {
      "id": "ch04_s15_yilu.l9",
      "who": "narr",
      "kind": "aside",
      "text": "前轮陷在软泥里，你与车旁的人垫进干枝，肩头抵住车沿。"
    },
    {
      "id": "ch04_s15_yilu.l10",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "先别催，轮子还偏着。"
    },
    {
      "id": "ch04_s15_yilu.l11",
      "who": "narr",
      "kind": "aside",
      "text": "车轮挪过泥坑，冷泥钻进靴口，马鼻边浮起白气。"
    },
    {
      "id": "ch04_s15_yilu.l12",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "出了这一段，第一处交接在驿旁。"
    },
    {
      "id": "ch04_s15_yilu.l13",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "知道。纸在自己身上。"
    },
    {
      "id": "ch04_s15_yilu.l14",
      "who": "narr",
      "kind": "aside",
      "text": "裴的队列转过前面的坡，你随运粮车走上另一道辙。"
    }
  ],
  "dressing": "qicheng",
  "choices": [
    {
      "id": "ch04_s15_yilu.cA",
      "text": "随车到第一处交接",
      "effects": {
        "flag.road_agreement": true,
        "flag.founded_school": false
      },
      "irreversible": false,
      "goto": "ch04_s16_yilu"
    }
  ]
}
