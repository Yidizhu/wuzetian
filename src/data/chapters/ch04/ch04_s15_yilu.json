{
  "id": "ch04_s15_yilu",
  "chapter": 4,
  "act": 4,
  "scene": "yilu",
  "palette": "ink",
  "cast": [
    "wuze",
    "peizhaoye",
    "tangjian"
  ],
  "require": {
    "flag.ch04_road_contract": true
  },
  "weightless": false,
  "leavesLetter": [],
  "purpose": "领路费、交凭并真正启程",
  "lines": [
    {
      "id": "ch04_s15_yilu.l1",
      "who": "narr",
      "kind": "aside",
      "text": "归期纸收稳，你到驿路领款。"
    },
    {
      "id": "ch04_s15_yilu.l2",
      "who": "narr",
      "kind": "aside",
      "text": "天亮时驿路泥还湿，车辙压出细水，轮边的泥点溅到你的靴面。",
      "image": "e39_ch04_s15_l2"
    },
    {
      "id": "ch04_s15_yilu.l3",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "路费袋里，当面点。"
    },
    {
      "id": "ch04_s15_yilu.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我先点一遍。"
    },
    {
      "id": "ch04_s15_yilu.l5",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "齐。"
    },
    {
      "id": "ch04_s15_yilu.l6",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "领俸的凭据另收，裴没代领。回来向这里核钱。"
    },
    {
      "id": "ch04_s15_yilu.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "找你们，不找军中。"
    },
    {
      "id": "ch04_s15_yilu.l8",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "对，你的钱不并进军账。"
    },
    {
      "id": "ch04_s15_yilu.l9",
      "who": "narr",
      "kind": "aside",
      "text": "你递回自己领到钱的凭据，唐写下交付时辰。"
    },
    {
      "id": "ch04_s15_yilu.l10",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "我队先行。"
    },
    {
      "id": "ch04_s15_yilu.l11",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你照你的时辰走。"
    },
    {
      "id": "ch04_s15_yilu.l12",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我随这一车。"
    },
    {
      "id": "ch04_s15_yilu.l13",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "车停就歇，不为赶我走夜路。"
    },
    {
      "id": "ch04_s15_yilu.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不用追着你的队伍赶。"
    },
    {
      "id": "ch04_s15_yilu.l15",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "你接的是查粮的差，照那份文书走，不是来追我。"
    },
    {
      "id": "ch04_s15_yilu.l16",
      "who": "narr",
      "kind": "aside",
      "text": "前轮陷在软泥里，你与车旁的人垫进干枝，肩头抵住车沿。"
    },
    {
      "id": "ch04_s15_yilu.l17",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "轮子还偏着，我——"
    },
    {
      "id": "ch04_s15_yilu.l18",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "先别催。"
    },
    {
      "id": "ch04_s15_yilu.l19",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch04_s15_yilu.l20",
      "who": "narr",
      "kind": "aside",
      "text": "车轮挪过泥坑，冷泥钻进靴口，马鼻边浮起白气。"
    },
    {
      "id": "ch04_s15_yilu.l21",
      "who": "narr",
      "kind": "aside",
      "text": "城的那一边，一座方形砖塔露在屋脊上。"
    },
    {
      "id": "ch04_s15_yilu.l22",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "出了这段，第一处交接在驿旁。"
    },
    {
      "id": "ch04_s15_yilu.l23",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "朝塔那边走？"
    },
    {
      "id": "ch04_s15_yilu.l24",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "先看轮印。塔露着顶，路还绕着走。"
    },
    {
      "id": "ch04_s15_yilu.l25",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "远看倒近。"
    },
    {
      "id": "ch04_s15_yilu.l26",
      "who": "narr",
      "kind": "aside",
      "text": "你低头磕掉靴边的一块泥，收好身上的纸。"
    },
    {
      "id": "ch04_s15_yilu.l27",
      "who": "narr",
      "kind": "aside",
      "text": "裴的队列转过前面的坡，你随运粮车走上另一道辙。"
    }
  ],
  "dressing": "qicheng",
  "choices": [
    {
      "id": "ch04_s15_yilu.cA",
      "text": "随车到第一处交接",
      "effects": {
        "flag.road_agreement": true,
        "flag.founded_school": false
      },
      "irreversible": false,
      "goto": "ch04_s16_yilu"
    }
  ]
}
