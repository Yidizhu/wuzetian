{
  "id": "ch04_s15_yilu",
  "chapter": 4,
  "act": 4,
  "scene": "yilu",
  "palette": "ink",
  "cast": [
    "wuze",
    "peizhaoye",
    "tangjian"
  ],
  "require": {
    "flag.ch04_road_contract": true
  },
  "weightless": false,
  "leavesLetter": [],
  "purpose": "领路费、交凭并真正启程",
  "lines": [
    {
      "id": "ch04_s15_yilu.l1",
      "who": "narr",
      "kind": "aside",
      "text": "归期纸收稳，你到驿路领款。"
    },
    {
      "id": "ch04_s15_yilu.l2",
      "who": "narr",
      "kind": "aside",
      "text": "天亮时驿路泥还湿，车辙压出细水，轮边的泥点溅到你的靴面。"
    },
    {
      "id": "ch04_s15_yilu.l3",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "路费袋里，当面点。"
    },
    {
      "id": "ch04_s15_yilu.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "袋里。"
    },
    {
      "id": "ch04_s15_yilu.l5",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "齐。"
    },
    {
      "id": "ch04_s15_yilu.l6",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "俸凭另收，裴没代领，回来向这边核。"
    },
    {
      "id": "ch04_s15_yilu.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这边。"
    },
    {
      "id": "ch04_s15_yilu.l8",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "不并军账。"
    },
    {
      "id": "ch04_s15_yilu.l9",
      "who": "narr",
      "kind": "aside",
      "text": "你把自己的收凭递回去，唐在交付时辰下落笔。"
    },
    {
      "id": "ch04_s15_yilu.l10",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "我队先行。"
    },
    {
      "id": "ch04_s15_yilu.l11",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "先行。"
    },
    {
      "id": "ch04_s15_yilu.l12",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我随这一车。"
    },
    {
      "id": "ch04_s15_yilu.l13",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "车停就歇，不为赶我走夜路。"
    },
    {
      "id": "ch04_s15_yilu.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "夜路……"
    },
    {
      "id": "ch04_s15_yilu.l15",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "写的是核粮，不是来追我。"
    },
    {
      "id": "ch04_s15_yilu.l16",
      "who": "narr",
      "kind": "aside",
      "text": "前轮陷在软泥里，你与车旁的人垫进干枝，肩头抵住车沿。"
    },
    {
      "id": "ch04_s15_yilu.l17",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "轮子还偏着，我——"
    },
    {
      "id": "ch04_s15_yilu.l18",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "先别催。"
    },
    {
      "id": "ch04_s15_yilu.l19",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch04_s15_yilu.l20",
      "who": "narr",
      "kind": "aside",
      "text": "车轮挪过泥坑，冷泥钻进靴口，马鼻边浮起白气。"
    },
    {
      "id": "ch04_s15_yilu.l21",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "出了这段，第一处交接在驿旁。"
    },
    {
      "id": "ch04_s15_yilu.l22",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "驿旁。"
    },
    {
      "id": "ch04_s15_yilu.l23",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "知道，纸在自己身上。"
    },
    {
      "id": "ch04_s15_yilu.l24",
      "who": "narr",
      "kind": "aside",
      "text": "裴的队列转过前面的坡，你随运粮车走上另一道辙。"
    }
  ],
  "dressing": "qicheng",
  "choices": [
    {
      "id": "ch04_s15_yilu.cA",
      "text": "随车到第一处交接",
      "effects": {
        "flag.road_agreement": true,
        "flag.founded_school": false
      },
      "irreversible": false,
      "goto": "ch04_s16_yilu"
    }
  ]
}
