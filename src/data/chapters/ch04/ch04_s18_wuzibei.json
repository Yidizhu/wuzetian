{
  "id": "ch04_s18_wuzibei",
  "chapter": 4,
  "act": 4,
  "scene": "wuzibei",
  "palette": "ink",
  "cast": [
    "wuze",
    "xujinghe"
  ],
  "weightless": true,
  "leavesLetter": [],
  "purpose": "夜里看无印碑样，放下笔后才进入结局",
  "lines": [
    {
      "id": "ch04_s18_wuzibei.l1",
      "who": "narr",
      "kind": "aside",
      "text": "宋的页收进袖里后，你走到石旁看碑样。"
    },
    {
      "id": "ch04_s18_wuzibei.l2",
      "who": "narr",
      "kind": "aside",
      "text": "夜里石旁没有印，灯照着一张空的碑样纸，纸角被风吹得贴上石面。"
    },
    {
      "id": "ch04_s18_wuzibei.l3",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "压这边，别飞了。"
    },
    {
      "id": "ch04_s18_wuzibei.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这边。"
    },
    {
      "id": "ch04_s18_wuzibei.l5",
      "who": "narr",
      "kind": "aside",
      "text": "你用笔杆压住纸角，石的冷透进指腹，手没有立刻收回。"
    },
    {
      "id": "ch04_s18_wuzibei.l6",
      "when": {
        "flag.enthroned": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不刻颂辞，先留这句。"
    },
    {
      "id": "ch04_s18_wuzibei.l7",
      "when": {
        "flag.enthroned": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "只是碑样，我也看一会儿。"
    },
    {
      "id": "ch04_s18_wuzibei.l8",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "看罢，温的册子还在她手里。"
    },
    {
      "id": "ch04_s18_wuzibei.l9",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "册子。"
    },
    {
      "id": "ch04_s18_wuzibei.l10",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "这里只看留白尺寸，不搬私页。"
    },
    {
      "id": "ch04_s18_wuzibei.l11",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch04_s18_wuzibei.l12",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "有人已经把自己的取走了。"
    },
    {
      "id": "ch04_s18_wuzibei.l13",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "由她取走。"
    },
    {
      "id": "ch04_s18_wuzibei.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "取走。"
    },
    {
      "id": "ch04_s18_wuzibei.l15",
      "who": "narr",
      "kind": "aside",
      "text": "你提起笔，纸角又翻过来，露出一样空的背面。"
    },
    {
      "id": "ch04_s18_wuzibei.l16",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我不写满……她们不少地方说话。"
    },
    {
      "id": "ch04_s18_wuzibei.l17",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "你空着，她们也得空么？"
    },
    {
      "id": "ch04_s18_wuzibei.l18",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "她们——"
    },
    {
      "id": "ch04_s18_wuzibei.l19",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "另问本人。"
    },
    {
      "id": "ch04_s18_wuzibei.l20",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch04_s18_wuzibei.l21",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "愿记不愿记的都有，谁还欠你的字？"
    },
    {
      "id": "ch04_s18_wuzibei.l22",
      "who": "self",
      "kind": "inner",
      "text": "（又说她们。连这张白纸，也想一并答了。）"
    },
    {
      "id": "ch04_s18_wuzibei.l23",
      "who": "narr",
      "kind": "aside",
      "text": "你将笔尖抬离纸面，墨还挂在尖上，没有落下来。"
    },
    {
      "id": "ch04_s18_wuzibei.l24",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "今晚先这样。"
    },
    {
      "id": "ch04_s18_wuzibei.l25",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch04_s18_wuzibei.l26",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "灯还能放一会儿。"
    },
    {
      "id": "ch04_s18_wuzibei.l27",
      "who": "narr",
      "kind": "aside",
      "text": "你把笔放下。"
    }
  ],
  "dressing": "beiyang",
  "judgeEnding": true
}
