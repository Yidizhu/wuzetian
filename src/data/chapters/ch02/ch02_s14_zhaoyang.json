{
  "id": "ch02_s14_zhaoyang",
  "chapter": 2,
  "act": 2,
  "scene": "zhaoyang",
  "palette": "gold",
  "cast": [
    "wuze",
    "hetaihou",
    "songhuizhen",
    "peizhaoye"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "宋不拿照料换无限留任，裴接受已经耽误的去路不能补许",
  "lines": [
    {
      "id": "ch02_s14_zhaoyang.l1",
      "who": "narr",
      "kind": "aside",
      "text": "封簿已归存。"
    },
    {
      "id": "ch02_s14_zhaoyang.l2",
      "who": "narr",
      "kind": "aside",
      "text": "数日后，宋蕙贞来辞一项夜值。殿门风吹得披帛垂到凳脚。"
    },
    {
      "id": "ch02_s14_zhaoyang.l3",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "披着，夜里风硬。"
    },
    {
      "id": "ch02_s14_zhaoyang.l4",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "谢太后。"
    },
    {
      "id": "ch02_s14_zhaoyang.l5",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "夜值仍请换人。"
    },
    {
      "id": "ch02_s14_zhaoyang.l6",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "这些人，你最熟。"
    },
    {
      "id": "ch02_s14_zhaoyang.l7",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "最熟……"
    },
    {
      "id": "ch02_s14_zhaoyang.l8",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "我带新人做两回，往后她熟，就不用我夜夜在。"
    },
    {
      "id": "ch02_s14_zhaoyang.l9",
      "who": "narr",
      "kind": "aside",
      "text": "太后压住将被风卷走的一角，没替她重新披紧。"
    },
    {
      "id": "ch02_s14_zhaoyang.l10",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "当年留下你，是怕一换人，饭药又被减去。"
    },
    {
      "id": "ch02_s14_zhaoyang.l11",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "饭药的数留下。"
    },
    {
      "id": "ch02_s14_zhaoyang.l12",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "数留下。"
    },
    {
      "id": "ch02_s14_zhaoyang.l13",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "我的人不能也留成一个数，少一夜便坏事。"
    },
    {
      "id": "ch02_s14_zhaoyang.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "换班与支给分开记，她只应了两回。"
    },
    {
      "id": "ch02_s14_zhaoyang.l15",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "两回。"
    },
    {
      "id": "ch02_s14_zhaoyang.l16",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "新值姓名与交接日给我，披帛你仍拿走。"
    },
    {
      "id": "ch02_s14_zhaoyang.l17",
      "who": "songhuizhen",
      "expr": "open",
      "kind": "say",
      "text": "这个我拿。"
    },
    {
      "id": "ch02_s14_zhaoyang.l18",
      "who": "hetaihou",
      "expr": "open",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch02_s14_zhaoyang.l19",
      "who": "narr",
      "kind": "aside",
      "text": "宋告退后，裴照夜奉召交回军需核单，停在殿门内。"
    },
    {
      "id": "ch02_s14_zhaoyang.l20",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "她不去了。"
    },
    {
      "id": "ch02_s14_zhaoyang.l21",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "转粮那队？"
    },
    {
      "id": "ch02_s14_zhaoyang.l22",
      "who": "peizhaoye",
      "expr": "guarded",
      "kind": "say",
      "text": "这回定了别人，她另接修具，不等我问。"
    },
    {
      "id": "ch02_s14_zhaoyang.l23",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你怎么答？"
    },
    {
      "id": "ch02_s14_zhaoyang.l24",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "怎么答……"
    },
    {
      "id": "ch02_s14_zhaoyang.l25",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "俸补齐了，那两个暂缓仍署我的名。"
    },
    {
      "id": "ch02_s14_zhaoyang.l26",
      "who": "narr",
      "kind": "aside",
      "text": "裴展开手中的核单，边角磨出了毛，里面没有那个人的新申请。"
    },
    {
      "id": "ch02_s14_zhaoyang.l27",
      "who": "peizhaoye",
      "expr": "guarded",
      "kind": "say",
      "text": "她来问，我说等天暖。"
    },
    {
      "id": "ch02_s14_zhaoyang.l28",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "天暖。"
    },
    {
      "id": "ch02_s14_zhaoyang.l29",
      "who": "peizhaoye",
      "expr": "guarded",
      "kind": "say",
      "text": "如今真暖了，倒找不到一句该说的话。"
    },
    {
      "id": "ch02_s14_zhaoyang.l30",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "别再叫她——"
    },
    {
      "id": "ch02_s14_zhaoyang.l31",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "不叫她再申请。"
    },
    {
      "id": "ch02_s14_zhaoyang.l32",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s14_zhaoyang.l33",
      "who": "narr",
      "kind": "aside",
      "text": "裴交出核单。门外牵马的人先行，她没有跟上。"
    },
    {
      "id": "ch02_s14_zhaoyang.l34",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "早一刻交完，想把这一刻给你。"
    },
    {
      "id": "ch02_s14_zhaoyang.l35",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "这一刻？"
    },
    {
      "id": "ch02_s14_zhaoyang.l36",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "你若有事，我就在这儿等风小。"
    },
    {
      "id": "ch02_s14_zhaoyang.l37",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不用点卯？"
    },
    {
      "id": "ch02_s14_zhaoyang.l38",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "点过了，这一刻是我的。"
    },
    {
      "id": "ch02_s14_zhaoyang.l39",
      "who": "narr",
      "kind": "aside",
      "text": "她站到风来的那一侧，却没替你决定往哪儿走。"
    },
    {
      "id": "ch02_s14_zhaoyang.l40",
      "who": "narr",
      "kind": "aside",
      "text": "你看她站到迎风处，袍角翻起，靴子仍停在你身侧。"
    },
    {
      "id": "ch02_s14_zhaoyang.l41",
      "who": "cg",
      "kind": "aside",
      "text": "peizhaoye_2_dangfeng"
    },
    {
      "id": "ch02_s14_zhaoyang.l42",
      "who": "self",
      "kind": "inner",
      "text": "（这边不冷了。想再站一会儿。）"
    }
  ],
