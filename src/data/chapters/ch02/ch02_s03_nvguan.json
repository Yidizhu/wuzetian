{
  "id": "ch02_s03_nvguan",
  "chapter": 2,
  "act": 2,
  "scene": "nvguan",
  "palette": "ink",
  "cast": [
    "wuze",
    "xujinghe",
    "songhuizhen",
    "adi"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "暂住须由阿荻自己选，许的观舍也有边界",
  "lines": [
    {
      "id": "ch02_s03_nvguan.l1",
      "who": "narr",
      "kind": "aside",
      "text": "晨风把晾毯吹得贴上柱子。你伸手扯开。"
    },
    {
      "id": "ch02_s03_nvguan.l2",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "她说来看看。别先替她铺。"
    },
    {
      "id": "ch02_s03_nvguan.l3",
      "when": {
        "flag.adi_verify_now": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "九件已经核过。出门前又念了一遍。"
    },
    {
      "id": "ch02_s03_nvguan.l4",
      "when": {
        "flag.adi_verify_now": true
      },
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "我改了一个字。"
    },
    {
      "id": "ch02_s03_nvguan.l5",
      "when": {
        "flag.adi_verify_later": true
      },
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "午后我还回去核。今日不住这里。"
    },
    {
      "id": "ch02_s03_nvguan.l6",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "看看可以。先帮我拿着这一角。"
    },
    {
      "id": "ch02_s03_nvguan.l7",
      "who": "narr",
      "kind": "aside",
      "text": "毯里还存着潮气，压得你两臂往下一沉。"
    },
    {
      "id": "ch02_s03_nvguan.l8",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "西间有空床？"
    },
    {
      "id": "ch02_s03_nvguan.l9",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "今晚有人回来。"
    },
    {
      "id": "ch02_s03_nvguan.l10",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "挪一挪呢？"
    },
    {
      "id": "ch02_s03_nvguan.l11",
      "who": "xujinghe",
      "expr": "guarded",
      "kind": "say",
      "text": "先放下。"
    },
    {
      "id": "ch02_s03_nvguan.l12",
      "who": "narr",
      "kind": "aside",
      "text": "许将毯折过你手背，领你放到干净木架上。"
    },
    {
      "id": "ch02_s03_nvguan.l13",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "她来时说看看，你却已经替她问床；我答了你，今晚该听谁的？"
    },
    {
      "id": "ch02_s03_nvguan.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "听她。阿荻，你——"
    },
    {
      "id": "ch02_s03_nvguan.l15",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "我说了。今日不住。"
    },
    {
      "id": "ch02_s03_nvguan.l16",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "水开了没有？"
    },
    {
      "id": "ch02_s03_nvguan.l17",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "还差些。你摸杯，不摸壶。"
    },
    {
      "id": "ch02_s03_nvguan.l18",
      "who": "narr",
      "kind": "aside",
      "text": "宋捋开衣缘，露出一线紫。许认了，递给她常用的杯。"
    },
    {
      "id": "ch02_s03_nvguan.l19",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "她寄来的簪，前日修好了。旧的我舍不得换。"
    },
    {
      "id": "ch02_s03_nvguan.l20",
      "who": "xujinghe",
      "expr": "open",
      "kind": "say",
      "text": "你们在这里换过一回，还不够？"
    },
    {
      "id": "ch02_s03_nvguan.l21",
      "who": "songhuizhen",
      "expr": "open",
      "kind": "say",
      "text": "那回她先插歪了。"
    },
    {
      "id": "ch02_s03_nvguan.l22",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "往后我若真想住，自己来问。没有床便说没有，别为我赶别人走。"
    },
    {
      "id": "ch02_s03_nvguan.l23",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "好。水开了。"
    },
    {
      "id": "ch02_s03_nvguan.l24",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我把杯子拿过去。"
    },
    {
      "id": "ch02_s03_nvguan.l25",
      "who": "narr",
      "kind": "aside",
      "text": "你一只只拿，阿荻提壶。谁也没去西间铺床。"
    }
  ],
  "goto": "ch02_s04_shuge"
}
