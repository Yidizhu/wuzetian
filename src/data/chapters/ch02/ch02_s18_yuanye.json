  "act": 2,
  "scene": "yuanye",
  "palette": "ink",
  "cast": [
    "wuze",
    "liqinghe"
  ],
  "require": {
    "affinity.liqinghe": {
      "gte": 8
    },
    "flag.liqinghe_cost_check": true
  },
  "weightless": true,
  "leavesLetter": [],
  "purpose": "猜枝的方向，不立输赢与赴约凭据",
  "lines": [
    {
      "id": "ch02_s18_yuanye.l1",
      "who": "narr",
      "kind": "aside",
      "text": "与裴照夜道别后，你到苑墙下找李令仪。"
    },
    {
      "id": "ch02_s18_yuanye.l2",
      "who": "narr",
      "kind": "aside",
      "text": "墙边一枝弯得很低，枝尖悬在李令仪袖口上方。"
    },
    {
      "id": "ch02_s18_yuanye.l3",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "明日往这边。"
    },
    {
      "id": "ch02_s18_yuanye.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这边？"
    },
    {
      "id": "ch02_s18_yuanye.l5",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "今日就往这边。"
    },
    {
      "id": "ch02_s18_yuanye.l6",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "再一点。"
    },
    {
      "id": "ch02_s18_yuanye.l7",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "再一点……"
    },
    {
      "id": "ch02_s18_yuanye.l8",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "你的袖口——"
    },
    {
      "id": "ch02_s18_yuanye.l9",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "收回来。"
    },
    {
      "id": "ch02_s18_yuanye.l10",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "风一来就推它，这样明日还朝你那边。"
    },
    {
      "id": "ch02_s18_yuanye.l11",
      "who": "narr",
      "kind": "aside",
      "text": "李令仪收回袖子，枝尖弹开。"
    },
    {
      "id": "ch02_s18_yuanye.l12",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch02_s18_yuanye.l13",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "你猜。"
    },
    {
      "id": "ch02_s18_yuanye.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "往上。"
    },
    {
      "id": "ch02_s18_yuanye.l15",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "往上……"
    },
    {
      "id": "ch02_s18_yuanye.l16",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "那你替它等一夜，我可不等。"
    },
    {
      "id": "ch02_s18_yuanye.l17",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s18_yuanye.l18",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "明日若忘了今日说什么，也别问我。"
    },
    {
      "id": "ch02_s18_yuanye.l19",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "不问。"
    },
    {
      "id": "ch02_s18_yuanye.l20",
      "who": "narr",
      "kind": "aside",
      "text": "你们绕过低枝。她在阴影里坐下，你收回扶枝的手。"
    },
    {
      "id": "ch02_s18_yuanye.l21",
      "who": "narr",
      "kind": "aside",
      "text": "你没坐到另一头，把裙摆拢在膝下，坐到她身旁。"
    },
    {
      "id": "ch02_s18_yuanye.l22",
      "who": "narr",
      "kind": "aside",
      "text": "李令仪望了望两人之间，向你挪了一点。你也挪过去。",
      "image": "liqinghe_7_dizhi"
    },
    {
      "id": "ch02_s18_yuanye.l23",
      "who": "self",
      "kind": "inner",
      "text": "（就差这一点。方才还想拿枝子指给她看。）"
    },
    {
      "id": "ch02_s18_yuanye.l24",
      "who": "narr",
      "kind": "aside",
      "text": "她低头用鞋尖拨开一片叶，你看见她嘴角翘起来。"
    },
    {
      "id": "ch02_s18_yuanye.l25",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "不猜了？"
    },
    {
      "id": "ch02_s18_yuanye.l26",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "歇会儿。"
    },
    {
      "id": "ch02_s18_yuanye.l27",
      "who": "narr",
      "kind": "aside",
      "text": "她把鞋尖收回裙下，你们没再换地方。"
    }
  ],
  "goto": "ch02_s20_hanyuan"
}
