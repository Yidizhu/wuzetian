{
  "id": "ch02_s02_yeting",
  "chapter": 2,
  "act": 2,
  "scene": "yeting",
  "palette": "ink",
  "cast": [
    "wuze",
    "adi",
    "tangjian",
    "shenheng"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "核问改为分项复述、本人确认，欠付与擅引分开",
  "lines": [
    {
      "id": "ch02_s02_yeting.l1",
      "who": "narr",
      "kind": "aside",
      "text": "粥碗还在席边，沈衡跨进门来。"
    },
    {
      "id": "ch02_s02_yeting.l2",
      "who": "narr",
      "kind": "aside",
      "text": "沈衡进门时，粥碗边已经结了一圈薄皮。"
    },
    {
      "id": "ch02_s02_yeting.l3",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "谁记的？"
    },
    {
      "id": "ch02_s02_yeting.l4",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "我。"
    },
    {
      "id": "ch02_s02_yeting.l5",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "我看看。"
    },
    {
      "id": "ch02_s02_yeting.l6",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "这份记录，还没请她一句句认过。"
    },
    {
      "id": "ch02_s02_yeting.l7",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "先念。"
    },
    {
      "id": "ch02_s02_yeting.l8",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "初八交衣十一件，其中九件是她做的。"
    },
    {
      "id": "ch02_s02_yeting.l9",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "这句是。"
    },
    {
      "id": "ch02_s02_yeting.l10",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "呈文还说欠她工钱，请一并查清。"
    },
    {
      "id": "ch02_s02_yeting.l11",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "呈文写了什么，我没见。"
    },
    {
      "id": "ch02_s02_yeting.l12",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "是我添的，没问过她。"
    },
    {
      "id": "ch02_s02_yeting.l13",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s02_yeting.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不能让她认下我写的整张纸。"
    },
    {
      "id": "ch02_s02_yeting.l15",
      "who": "shenheng",
      "expr": "guarded",
      "kind": "say",
      "text": "另拿张纸，把你怎么用她的话写清楚，署你自己的名。"
    },
    {
      "id": "ch02_s02_yeting.l16",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch02_s02_yeting.l17",
      "who": "narr",
      "kind": "aside",
      "text": "你接了窄纸。沈衡没有替你移走旧牒。"
    },
    {
      "id": "ch02_s02_yeting.l18",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "该付她的钱照付。擅用她的话，我另问你。"
    },
    {
      "id": "ch02_s02_yeting.l19",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "每句都念？"
    },
    {
      "id": "ch02_s02_yeting.l20",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "每句。"
    },
    {
      "id": "ch02_s02_yeting.l21",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "我念，你改，改完再念。"
    },
    {
      "id": "ch02_s02_yeting.l22",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "有些我不肯——"
    },
    {
      "id": "ch02_s02_yeting.l23",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "就记不答。"
    },
    {
      "id": "ch02_s02_yeting.l24",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "不答。"
    },
    {
      "id": "ch02_s02_yeting.l25",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "末尾的名字，不能算全答应。"
    },
    {
      "id": "ch02_s02_yeting.l26",
      "who": "narr",
      "kind": "aside",
      "text": "唐简在纸边留出一道空栏，笔尖点了点。"
    },
    {
      "id": "ch02_s02_yeting.l27",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "改的字写在这里。认这一问，不算认下整张纸。"
    },
    {
      "id": "ch02_s02_yeting.l28",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "这里……"
    },
    {
      "id": "ch02_s02_yeting.l29",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "门外还站着人。"
    },
    {
      "id": "ch02_s02_yeting.l30",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "让他们走，我不隔着门答。"
    },
    {
      "id": "ch02_s02_yeting.l31",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "依她。"
    },
    {
      "id": "ch02_s02_yeting.l32",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s02_yeting.l33",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "作证的人，只留下我和她都答应的。"
    },
    {
      "id": "ch02_s02_yeting.l34",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "现在查，她少跑一趟。挪到午后，就得另调一班人。"
    },
    {
      "id": "ch02_s02_yeting.l35",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "午后。"
    },
    {
      "id": "ch02_s02_yeting.l36",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "两种时候，她都肯来。"
    },
    {
      "id": "ch02_s02_yeting.l37",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "午后也在这里，不去大堂。"
    },
    {
      "id": "ch02_s02_yeting.l38",
      "who": "narr",
      "kind": "aside",
      "text": "你留在粥碗旁，等她定下核问的时辰。"
    }
  ],
  "choices": [
    {
      "id": "ch02_s02_yeting.cA",
      "text": "现在逐项查清，请门外的人散去",
      "effects": {
        "shi": 1,
        "flag.adi_verify_now": true
      },
      "irreversible": false,
      "goto": "ch02_s03_nvguan"
    },
    {
      "id": "ch02_s02_yeting.cB",
      "text": "午后再查，给她留半日",
      "effects": {
        "xin": 1,
        "flag.adi_verify_later": true
      },
      "irreversible": false,
      "goto": "ch02_s03_nvguan"
    }
  ]
}
