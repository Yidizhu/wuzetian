{
  "id": "ch02_s06_yeting",
  "chapter": 2,
  "act": 2,
  "scene": "yeting",
  "palette": "ink",
  "cast": [
    "wuze",
    "adi",
    "songhuizhen",
    "tangjian"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "核准九件实际给付，辞出与欠款不再相互扣住",
  "lines": [
    {
      "id": "ch02_s06_yeting.l1",
      "who": "narr",
      "kind": "aside",
      "text": "帕子留在宋的手边，你去唐简案前核钱。"
    },
    {
      "id": "ch02_s06_yeting.l2",
      "who": "narr",
      "kind": "aside",
      "text": "唐简将两张窄纸摊开，铜钱隔着布囊碰了一声。"
    },
    {
      "id": "ch02_s06_yeting.l3",
      "when": {
        "flag.adi_verify_now": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "早上逐项认过，九件无误。"
    },
    {
      "id": "ch02_s06_yeting.l4",
      "when": {
        "flag.adi_verify_now": true
      },
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "九件。"
    },
    {
      "id": "ch02_s06_yeting.l5",
      "when": {
        "flag.adi_verify_later": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "午后这班挪来了，先听我念。"
    },
    {
      "id": "ch02_s06_yeting.l6",
      "when": {
        "flag.adi_verify_later": true
      },
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "念。"
    },
    {
      "id": "ch02_s06_yeting.l7",
      "when": {
        "flag.adi_verify_later": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "她逐项念，阿荻改了一处日期，再听一遍才认。"
    },
    {
      "id": "ch02_s06_yeting.l8",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "她做的九件查清了。另两件，得问做衣的人。"
    },
    {
      "id": "ch02_s06_yeting.l9",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "这张领钱，那张呢？"
    },
    {
      "id": "ch02_s06_yeting.l10",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "这张是给你离开时用的。"
    },
    {
      "id": "ch02_s06_yeting.l11",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "拿着它离开，欠款也仍归你。不必住在这里等钱。"
    },
    {
      "id": "ch02_s06_yeting.l12",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "可我今日——"
    },
    {
      "id": "ch02_s06_yeting.l13",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "先给你。"
    },
    {
      "id": "ch02_s06_yeting.l14",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s06_yeting.l15",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "哪日用，你自己定。"
    },
    {
      "id": "ch02_s06_yeting.l16",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "走了，上哪里领？"
    },
    {
      "id": "ch02_s06_yeting.l17",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "西库和我这里各留一份。哪天领，纸上写明白。"
    },
    {
      "id": "ch02_s06_yeting.l18",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "这日期。"
    },
    {
      "id": "ch02_s06_yeting.l19",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "不必再把原先那一班人找齐。"
    },
    {
      "id": "ch02_s06_yeting.l20",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "听明白了。"
    },
    {
      "id": "ch02_s06_yeting.l21",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我还须补什么？"
    },
    {
      "id": "ch02_s06_yeting.l22",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "补你那张。"
    },
    {
      "id": "ch02_s06_yeting.l23",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "我那张。"
    },
    {
      "id": "ch02_s06_yeting.l24",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "别往我的上面补。"
    },
    {
      "id": "ch02_s06_yeting.l25",
      "who": "narr",
      "kind": "aside",
      "text": "你把自己的认责纸往身前挪了挪。"
    },
    {
      "id": "ch02_s06_yeting.l26",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "旧账的钱今日只够付六件。还欠三件，得再催。"
    },
    {
      "id": "ch02_s06_yeting.l27",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "又等手续……"
    },
    {
      "id": "ch02_s06_yeting.l28",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s06_yeting.l29",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "哪一日？"
    },
    {
      "id": "ch02_s06_yeting.l30",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "今夜没等到回话，明晨就拿这张凭据去问。"
    },
    {
      "id": "ch02_s06_yeting.l31",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "明晨。"
    },
    {
      "id": "ch02_s06_yeting.l32",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "还有钱能暂垫么？"
    },
    {
      "id": "ch02_s06_yeting.l33",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "暂垫。"
    },
    {
      "id": "ch02_s06_yeting.l34",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "修东廊栏杆的钱准了，能先垫。但栏杆就得下旬再刷。"
    },
    {
      "id": "ch02_s06_yeting.l35",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "栏呢？"
    },
    {
      "id": "ch02_s06_yeting.l36",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "没坏，只是漆旧了。"
    },
    {
      "id": "ch02_s06_yeting.l37",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "只是旧。"
    },
    {
      "id": "ch02_s06_yeting.l38",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "饭药的钱？"
    },
    {
      "id": "ch02_s06_yeting.l39",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "饭钱药钱不动。先垫钱，或催原来的钱，两样都准了。"
    },
    {
      "id": "ch02_s06_yeting.l40",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "六件先给我。"
    },
    {
      "id": "ch02_s06_yeting.l41",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "六件。"
    },
    {
      "id": "ch02_s06_yeting.l42",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "你数。"
    },
    {
      "id": "ch02_s06_yeting.l43",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "数过再认，不在空纸上署名。"
    },
    {
      "id": "ch02_s06_yeting.l44",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "三件今夜领也可。"
    },
    {
      "id": "ch02_s06_yeting.l45",
      "who": "narr",
      "kind": "aside",
      "text": "她解开布囊。宋移近碗托，让铜钱不滚到席缝里。"
    },
    {
      "id": "ch02_s06_yeting.l46",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "补栏的人也得知道，别叫她们白来。"
    },
    {
      "id": "ch02_s06_yeting.l47",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "知道了。"
    },
    {
      "id": "ch02_s06_yeting.l48",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "垫钱就今日告知。若去催款，跑这一趟也要算工钱。"
    },
    {
      "id": "ch02_s06_yeting.l49",
      "who": "narr",
      "kind": "aside",
      "text": "你将领钱与辞出的两张窄纸分开。"
    }
  ],
  "choices": [
    {
      "id": "ch02_s06_yeting.cA",
      "text": "先垫修栏的钱，今日付清",
      "effects": {
        "shi": 1,
        "flag.adi_pay_advance": true
      },
      "irreversible": false,
      "goto": "ch02_s07_yuanye"
    },
    {
      "id": "ch02_s06_yeting.cB",
      "text": "先付六件，余下三件另催",
      "effects": {
        "ming": 1,
        "flag.adi_pay_original": true
      },
      "irreversible": false,
      "goto": "ch02_s07_yuanye"
    }
  ]
}
