{
  "id": "ch02_s07_yuanye",
  "chapter": 2,
  "act": 2,
  "scene": "yuanye",
  "palette": "ink",
  "cast": [
    "wuze",
    "peizhaoye"
  ],
  "weightless": false,
  "leavesLetter": [
    "peizhaoye"
  ],
  "purpose": "裴请主角一起复核她压住的放行安排",
  "lines": [
    {
      "id": "ch02_s07_yuanye.l1",
      "who": "narr",
      "kind": "aside",
      "text": "窄纸收好，你到廊外替裴照夜抬粮袋。"
    },
    {
      "id": "ch02_s07_yuanye.l2",
      "who": "narr",
      "kind": "aside",
      "text": "廊外堆着粮袋。裴照夜扎好袍角，裤脚收进靴筒。"
    },
    {
      "id": "ch02_s07_yuanye.l3",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "何为此装束？"
    },
    {
      "id": "ch02_s07_yuanye.l4",
      "who": "narr",
      "kind": "aside",
      "text": "你学着席间的腔调笑了一声，指的是她塞起的袍角。"
    },
    {
      "id": "ch02_s07_yuanye.l5",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "衣裳合身，不必合谁的意。"
    },
    {
      "id": "ch02_s07_yuanye.l6",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch02_s07_yuanye.l7",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "这一头给我。"
    },
    {
      "id": "ch02_s07_yuanye.l8",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "这一头？"
    },
    {
      "id": "ch02_s07_yuanye.l9",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "重，抬不起便放。"
    },
    {
      "id": "ch02_s07_yuanye.l10",
      "who": "narr",
      "kind": "aside",
      "text": "你攥紧麻布。她托着袋底，等你的手不再滑。"
    },
    {
      "id": "ch02_s07_yuanye.l11",
      "when": {
        "flag.pei_accept_open_date": true
      },
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "路还没定，你信里那句话我记着。"
    },
    {
      "id": "ch02_s07_yuanye.l12",
      "when": {
        "flag.pei_accept_open_date": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那句话。"
    },
    {
      "id": "ch02_s07_yuanye.l13",
      "when": {
        "flag.pei_prioritize_accounts": true
      },
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "先核账，你要的那份在袋后。"
    },
    {
      "id": "ch02_s07_yuanye.l14",
      "when": {
        "flag.pei_prioritize_accounts": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "袋后。"
    },
    {
      "id": "ch02_s07_yuanye.l15",
      "when": {
        "flag.pei_decline_shared_road": true
      },
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "今日核衣粮，同行的事照你先前说的。"
    },
    {
      "id": "ch02_s07_yuanye.l16",
      "when": {
        "flag.pei_decline_shared_road": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "先前说的。"
    },
    {
      "id": "ch02_s07_yuanye.l17",
      "when": {
        "flag.silent_to_peizhaoye": true
      },
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "不用补信，来核便核，旧话不追着问。"
    },
    {
      "id": "ch02_s07_yuanye.l18",
      "when": {
        "flag.silent_to_peizhaoye": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch02_s07_yuanye.l19",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "这一头交给你，行么？"
    },
    {
      "id": "ch02_s07_yuanye.l20",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "行，慢些松。"
    },
    {
      "id": "ch02_s07_yuanye.l21",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "慢些。"
    },
    {
      "id": "ch02_s07_yuanye.l22",
      "who": "narr",
      "kind": "aside",
      "text": "她松开托底的手。重量沉下来，你们一同挪到檐下。"
    },
    {
      "id": "ch02_s07_yuanye.l23",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "放，别砸脚。"
    },
    {
      "id": "ch02_s07_yuanye.l24",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这页，暂缓……"
    },
    {
      "id": "ch02_s07_yuanye.l25",
      "who": "peizhaoye",
      "expr": "guarded",
      "kind": "say",
      "text": "我写的。"
    },
    {
      "id": "ch02_s07_yuanye.l26",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s07_yuanye.l27",
      "who": "peizhaoye",
      "expr": "guarded",
      "kind": "say",
      "text": "她想领一队去转粮。"
    },
    {
      "id": "ch02_s07_yuanye.l28",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "她做不了？"
    },
    {
      "id": "ch02_s07_yuanye.l29",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "做得了，路不熟。"
    },
    {
      "id": "ch02_s07_yuanye.l30",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "路不熟。"
    },
    {
      "id": "ch02_s07_yuanye.l31",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你头回认路，谁替你写暂缓？"
    },
    {
      "id": "ch02_s07_yuanye.l32",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "暂缓。"
    },
    {
      "id": "ch02_s07_yuanye.l33",
      "who": "narr",
      "kind": "aside",
      "text": "裴解开腕上勒出的麻线，搓了搓那一道红痕。"
    },
    {
      "id": "ch02_s07_yuanye.l34",
      "who": "peizhaoye",
      "expr": "guarded",
      "kind": "say",
      "text": "她又问两回，我都叫她等。"
    },
    {
      "id": "ch02_s07_yuanye.l35",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s07_yuanye.l36",
      "who": "peizhaoye",
      "expr": "guarded",
      "kind": "say",
      "text": "今日翻到这里，还是我写的那两个字。"
    },
    {
      "id": "ch02_s07_yuanye.l37",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "她还肯去么？"
    },
    {
      "id": "ch02_s07_yuanye.l38",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "先问她，拖过了，不能又替她答愿意。"
    },
    {
      "id": "ch02_s07_yuanye.l39",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "先问。"
    },
    {
      "id": "ch02_s07_yuanye.l40",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "这一趟……"
    },
    {
      "id": "ch02_s07_yuanye.l41",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你说。"
    },
    {
      "id": "ch02_s07_yuanye.l42",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "陪我核衣粮，缺哪项照实写。"
    },
    {
      "id": "ch02_s07_yuanye.l43",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "别因我说稳妥，就替我删。"
    },
    {
      "id": "ch02_s07_yuanye.l44",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你自己去问她。"
    },
    {
      "id": "ch02_s07_yuanye.l45",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "我去。"
    },
    {
      "id": "ch02_s07_yuanye.l46",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好，我等着听。"
    },
    {
      "id": "ch02_s07_yuanye.l47",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "信里把她的答复与我欠办的分开。"
    },
    {
      "id": "ch02_s07_yuanye.l48",
      "who": "narr",
      "kind": "aside",
      "text": "裴照夜拿起粮袋后的纸，准备去问她。"
    }
  ],
  "choices": [
    {
      "id": "ch02_s07_yuanye.cA",
      "text": "我核欠项，你去问她",
      "effects": {
        "affinity.peizhaoye": 3,
        "flag.pei_shared_check": true,
        "flag.pei_check_supply": true
      },
      "irreversible": false,
      "goto": "ch02_s08_shuge"
    },
    {
      "id": "ch02_s07_yuanye.cB",
      "text": "我核脚程，你把粮数列齐",
      "effects": {
        "affinity.peizhaoye": 3,
        "flag.pei_shared_check": true,
        "flag.pei_check_route": true
      },
      "irreversible": false,
      "goto": "ch02_s08_shuge"
    },
    {
      "id": "ch02_s07_yuanye.cC",
      "text": "我今日接不下，另请人核",
      "effects": {
        "flag.pei_check_declined": true
      },
      "irreversible": false,
      "goto": "ch02_s08_shuge"
    }
  ]
}
