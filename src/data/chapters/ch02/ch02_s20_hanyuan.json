{
  "id": "ch02_s20_hanyuan",
  "chapter": 2,
  "act": 2,
  "scene": "hanyuan",
  "palette": "gold",
  "cast": [
    "wuze",
    "shenheng",
    "liqinghe",
    "hetaihou",
    "tangjian"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "比较两种非宗室提名办法，承担各自的门槛与成本",
  "lines": [
    {
      "id": "ch02_s20_hanyuan.l1",
      "who": "narr",
      "kind": "aside",
      "text": "又过数日，两份拟条放在同一案上，留着一样宽的页边。"
    },
    {
      "id": "ch02_s20_hanyuan.l2",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "奉准试收议案材料，是否入候选册，仍待新条颁行。"
    },
    {
      "id": "ch02_s20_hanyuan.l3",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "今日议的是谁能受荐。别把这两件说成你已得了哪一席。"
    },
    {
      "id": "ch02_s20_hanyuan.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那就把只许宗姓的这一行改掉。"
    },
    {
      "id": "ch02_s20_hanyuan.l5",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "改掉以后，谁来核荐书？"
    },
    {
      "id": "ch02_s20_hanyuan.l6",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "甲法，三处联署，先核履历与经办，署者须各答所知。"
    },
    {
      "id": "ch02_s20_hanyuan.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "找不着三处的人，仍在门外。"
    },
    {
      "id": "ch02_s20_hanyuan.l8",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "是。不能写成人人已能进来。"
    },
    {
      "id": "ch02_s20_hanyuan.l9",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "乙法，限期试问，先收自呈。答卷之外，还核实做过的事。"
    },
    {
      "id": "ch02_s20_hanyuan.l10",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "路远的来不起呢？"
    },
    {
      "id": "ch02_s20_hanyuan.l11",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "要留旅费和寄卷人手，评期也长。"
    },
    {
      "id": "ch02_s20_hanyuan.l12",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "用甲，旧门第能结成一张荐网；用乙，来得起、等得起的人先占住案前。"
    },
    {
      "id": "ch02_s20_hanyuan.l13",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "都有门槛。把每一道写出来，别只在开头写不问宗姓。"
    },
    {
      "id": "ch02_s20_hanyuan.l14",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "我仍主张宗室先试任，有旧供给可接，不必重搭一遍。"
    },
    {
      "id": "ch02_s20_hanyuan.l15",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "那供给从哪里来，谁没能分到，也要给我们看。"
    },
    {
      "id": "ch02_s20_hanyuan.l16",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "看。你做过的，也照这个问。"
    },
    {
      "id": "ch02_s20_hanyuan.l17",
      "who": "narr",
      "kind": "aside",
      "text": "她把自家的支出册推到案中，没有递到你手边私看。"
    },
    {
      "id": "ch02_s20_hanyuan.l18",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "军中不得以兵代荐。往来利害各自申明。"
    },
    {
      "id": "ch02_s20_hanyuan.l19",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "两法都留异议。候选人自己的反对话，也收。"
    },
    {
      "id": "ch02_s20_hanyuan.l20",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我擅引阿荻的那一笔，一样列入。她的私话别再随卷发。"
    },
    {
      "id": "ch02_s20_hanyuan.l21",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "你先选要试办哪一法，写清要花多少、人从何处来。"
    },
    {
      "id": "ch02_s20_hanyuan.l22",
      "who": "narr",
      "kind": "aside",
      "text": "两张拟条都没有落你的名，笔搁在正中。"
    }
  ],
  "choices": [
    {
      "id": "ch02_s20_hanyuan.cA",
      "text": "试联署核验，列回避与申辩",
      "effects": {
        "shi": 1,
        "flag.nomination_joint_review": true
      },
      "irreversible": false,
      "goto": "ch02_s21_nvguan"
    },
    {
      "id": "ch02_s20_hanyuan.cB",
      "text": "试限期问策，列旅费与评期",
      "effects": {
        "ming": 1,
        "flag.nomination_open_questions": true
      },
      "irreversible": false,
      "goto": "ch02_s21_nvguan"
    }
  ]
}
