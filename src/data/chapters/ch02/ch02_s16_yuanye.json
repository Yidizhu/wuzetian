  "weightless": true,
  "leavesLetter": [],
  "purpose": "掰饼不论军粮，只吃眼前这一块",
  "lines": [
    {
      "id": "ch02_s16_yuanye.l1",
      "who": "narr",
      "kind": "aside",
      "text": "你随裴照夜走到苑里，接过她掰的饼。"
    },
    {
      "id": "ch02_s16_yuanye.l2",
      "who": "narr",
      "kind": "aside",
      "text": "饼边一掰就掉渣，纸上落了一圈。"
    },
    {
      "id": "ch02_s16_yuanye.l3",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "你这块小。"
    },
    {
      "id": "ch02_s16_yuanye.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "小？"
    },
    {
      "id": "ch02_s16_yuanye.l5",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "添一点。"
    },
    {
      "id": "ch02_s16_yuanye.l6",
      "who": "narr",
      "kind": "aside",
      "text": "裴掰下一角，反倒掉成三块。"
    },
    {
      "id": "ch02_s16_yuanye.l7",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "现在都小了。"
    },
    {
      "id": "ch02_s16_yuanye.l8",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "都小了……"
    },
    {
      "id": "ch02_s16_yuanye.l9",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "再补——"
    },
    {
      "id": "ch02_s16_yuanye.l10",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "还补？"
    },
    {
      "id": "ch02_s16_yuanye.l11",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "别补了，得捧着纸吃。"
    },
    {
      "id": "ch02_s16_yuanye.l12",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "捧着。"
    },
    {
      "id": "ch02_s16_yuanye.l13",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "捧着也能吃。"
    },
    {
      "id": "ch02_s16_yuanye.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "风要吃。"
    },
    {
      "id": "ch02_s16_yuanye.l15",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "它若来……"
    },
    {
      "id": "ch02_s16_yuanye.l16",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "如何？"
    },
    {
      "id": "ch02_s16_yuanye.l17",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "趁它没来，先吃手上这口，剩下随你拿。"
    },
    {
      "id": "ch02_s16_yuanye.l18",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch02_s16_yuanye.l19",
      "who": "narr",
      "kind": "aside",
      "text": "你们各拿一块。裴把纸折高半寸，挡住细渣。"
    },
    {
      "id": "ch02_s16_yuanye.l20",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "这块脆。"
    },
    {
      "id": "ch02_s16_yuanye.l21",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "我的也脆。"
    },
    {
      "id": "ch02_s16_yuanye.l22",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s16_yuanye.l23",
      "who": "narr",
      "kind": "aside",
      "text": "你把手里的饼送到嘴边，接着吃。"
    }
  ],
  "goto": "ch02_s20_hanyuan"
}
