{
  "id": "ch02_s17_shishe",
  "chapter": 2,
  "act": 2,
  "scene": "shishe",
  "palette": "ink",
  "cast": [
    "wuze",
    "wenqiao"
  ],
  "require": {
    "affinity.wenqiao": {
      "gte": 8
    },
    "flag.wen_reader_help": true
  },
  "weightless": true,
  "leavesLetter": [],
  "purpose": "给窗影起怪名，随口说过就算",
  "lines": [
    {
      "id": "ch02_s17_shishe.l1",
      "who": "narr",
      "kind": "aside",
      "text": "与裴照夜道别后，你去温荞的窗下坐坐。"
    },
    {
      "id": "ch02_s17_shishe.l2",
      "who": "narr",
      "kind": "aside",
      "text": "竹影越过窗棂，在温荞袖上弯成一钩。"
    },
    {
      "id": "ch02_s17_shishe.l3",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "长脖子勺。"
    },
    {
      "id": "ch02_s17_shishe.l4",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "勺？"
    },
    {
      "id": "ch02_s17_shishe.l5",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "没勺肚。"
    },
    {
      "id": "ch02_s17_shishe.l6",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "瘦了。"
    },
    {
      "id": "ch02_s17_shishe.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "瘦了……"
    },
    {
      "id": "ch02_s17_shishe.l8",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "又分叉——"
    },
    {
      "id": "ch02_s17_shishe.l9",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "捆起来。"
    },
    {
      "id": "ch02_s17_shishe.l10",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "捆好才能进汤锅。"
    },
    {
      "id": "ch02_s17_shishe.l11",
      "who": "narr",
      "kind": "aside",
      "text": "你看温荞把袖子抻平，肩也跟着向你这边倾了一点。"
    },
    {
      "id": "ch02_s17_shishe.l12",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "让我靠一会儿？"
    },
    {
      "id": "ch02_s17_shishe.l13",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "靠这里。别压着头发。"
    },
    {
      "id": "ch02_s17_shishe.l14",
      "who": "narr",
      "kind": "aside",
      "text": "她拨开发尾，把肩侧让给你。你挪过去，额角贴上她的肩。"
    },
    {
      "id": "ch02_s17_shishe.l15",
      "who": "self",
      "kind": "inner",
      "text": "（她说话时，这里也跟着动。）"
    },
    {
      "id": "ch02_s17_shishe.l16",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "看得到么？"
    },
    {
      "id": "ch02_s17_shishe.l17",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "看得到。"
    },
    {
      "id": "ch02_s17_shishe.l18",
      "who": "narr",
      "kind": "aside",
      "text": "温把另一只袖子抬起，影子从臂上滑到窗下。"
    },
    {
      "id": "ch02_s17_shishe.l19",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "走路勺。"
    },
    {
      "id": "ch02_s17_shishe.l20",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "不能换一个么？"
    },
    {
      "id": "ch02_s17_shishe.l21",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "天女。昨日读的《维摩诘经》，还记着她。"
    },
    {
      "id": "ch02_s17_shishe.l22",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "哪里像？"
    },
    {
      "id": "ch02_s17_shishe.l23",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "舍利弗问她，为什么不转女身。"
    },
    {
      "id": "ch02_s17_shishe.l24",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "她便把两人的模样换过来，轮到她问了。"
    },
    {
      "id": "ch02_s17_shishe.l25",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "“何以不转女身？”"
    },
    {
      "id": "ch02_s17_shishe.l26",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "这一句，你是不是等了半天？"
    },
    {
      "id": "ch02_s17_shishe.l27",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "……你还看不看影子？"
    },
    {
      "id": "ch02_s17_shishe.l28",
      "who": "narr",
      "kind": "aside",
      "text": "风把两枝吹到一处。"
    },
    {
      "id": "ch02_s17_shishe.l29",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "撞着了。"
    },
    {
      "id": "ch02_s17_shishe.l30",
      "who": "narr",
      "kind": "aside",
      "text": "温荞放下抬着的手，仍让窗影留在袖上。"
    }
  ],
  "goto": "ch02_s20_hanyuan"
}
