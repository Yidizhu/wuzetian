{
  "id": "ch02_s25_yeting",
  "chapter": 2,
  "act": 2,
  "scene": "yeting",
  "palette": "ink",
  "cast": [
    "wuze",
    "liuchenghuan",
    "tangjian"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "柳自请为女史，主角第一次面对有实际收益的过量代劳",
  "lines": [
    {
      "id": "ch02_s25_yeting.l1",
      "who": "narr",
      "kind": "aside",
      "text": "东间的时辰另排妥了；你在掖庭等来柳承欢。"
    },
    {
      "id": "ch02_s25_yeting.l2",
      "who": "narr",
      "kind": "aside",
      "text": "一旬后，柳承欢托来三页稿，把缺印的地方都夹了细签。"
    },
    {
      "id": "ch02_s25_yeting.l3",
      "who": "narr",
      "kind": "aside",
      "text": "柳梳单刀半翻髻，襦裙袖边不搭帔帛，两肘撑开，将稿托在胸前。"
    },
    {
      "id": "ch02_s25_yeting.l4",
      "who": "liuchenghuan",
      "expr": "default",
      "kind": "say",
      "text": "那天我在，你问马，我站后头。"
    },
    {
      "id": "ch02_s25_yeting.l5",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那天……"
    },
    {
      "id": "ch02_s25_yeting.l6",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这几处，你都查过了？"
    },
    {
      "id": "ch02_s25_yeting.l7",
      "who": "liuchenghuan",
      "expr": "open",
      "kind": "say",
      "text": "前后查了两遍。"
    },
    {
      "id": "ch02_s25_yeting.l8",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "一处处查了两遍？"
    },
    {
      "id": "ch02_s25_yeting.l9",
      "who": "liuchenghuan",
      "expr": "open",
      "kind": "say",
      "text": "第三页还缺经手人的名字，已经请她来补了。"
    },
    {
      "id": "ch02_s25_yeting.l10",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "这些都对。这半日照付工钱，记你做的，不能算白帮忙。"
    },
    {
      "id": "ch02_s25_yeting.l11",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "核得对。"
    },
    {
      "id": "ch02_s25_yeting.l12",
      "who": "liuchenghuan",
      "expr": "default",
      "kind": "say",
      "text": "我想做你的女史，往后送你的纸，先过我这里。"
    },
    {
      "id": "ch02_s25_yeting.l13",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你想一直替我管这些文书？"
    },
    {
      "id": "ch02_s25_yeting.l14",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "女史得另行授职。今日先记你做了多少，工钱已经准了。"
    },
    {
      "id": "ch02_s25_yeting.l15",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那今晚的稿子……"
    },
    {
      "id": "ch02_s25_yeting.l16",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "今夜这份也答应了？"
    },
    {
      "id": "ch02_s25_yeting.l17",
      "who": "liuchenghuan",
      "expr": "default",
      "kind": "say",
      "text": "今夜这份，替你答应了。我留下来誊写。"
    },
    {
      "id": "ch02_s25_yeting.l18",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "替我？"
    },
    {
      "id": "ch02_s25_yeting.l19",
      "who": "narr",
      "kind": "aside",
      "text": "她把自己的抄试报名牒垫在纸底，空着应试时辰那一栏。"
    },
    {
      "id": "ch02_s25_yeting.l20",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "你的抄试就在今夜。"
    },
    {
      "id": "ch02_s25_yeting.l21",
      "who": "liuchenghuan",
      "expr": "default",
      "kind": "say",
      "text": "下回能去，你这份——"
    },
    {
      "id": "ch02_s25_yeting.l22",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "下回没有定日。"
    },
    {
      "id": "ch02_s25_yeting.l23",
      "who": "liuchenghuan",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s25_yeting.l24",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "可你今日缺席，那边就会记下。"
    },
    {
      "id": "ch02_s25_yeting.l25",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我留下，只少半日备稿。你留下，会误了自己的考试。"
    },
    {
      "id": "ch02_s25_yeting.l26",
      "who": "liuchenghuan",
      "expr": "default",
      "kind": "say",
      "text": "半日。"
    },
    {
      "id": "ch02_s25_yeting.l27",
      "who": "liuchenghuan",
      "expr": "open",
      "kind": "say",
      "text": "不用说为什么，我信你。"
    },
    {
      "id": "ch02_s25_yeting.l28",
      "who": "self",
      "kind": "inner",
      "text": "（明日那半日。我确实想要。）"
    },
    {
      "id": "ch02_s25_yeting.l29",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "已经做的照付工钱。今夜谁接这份活，得自己答。"
    },
    {
      "id": "ch02_s25_yeting.l30",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我……"
    },
    {
      "id": "ch02_s25_yeting.l31",
      "who": "narr",
      "kind": "aside",
      "text": "柳将最上面的一页转正，仍等着你接过去。"
    },
    {
      "id": "ch02_s25_yeting.l32",
      "who": "narr",
      "kind": "aside",
      "text": "你取下束稿的一小段朱绳，放在她已经核好的三页旁。"
    },
    {
      "id": "ch02_s25_yeting.l33",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这段绳借你束纸，办完再还。"
    },
    {
      "id": "ch02_s25_yeting.l34",
      "who": "narr",
      "kind": "aside",
      "text": "你把朱绳放到柳手边，让她自己束纸。"
    }
  ],
  "choices": [
    {
      "id": "ch02_s25_yeting.cA",
      "text": "今夜交给你，我去备稿",
      "effects": {
        "shi": 1,
        "xin": -1,
        "flag.chenghuan_accept_1": true
      },
      "irreversible": false,
      "goto": "ch02_s22_shuge"
    },
    {
      "id": "ch02_s25_yeting.cB",
      "text": "撤回代答，我自己另排时辰",
      "effects": {
        "flag.chenghuan_refuse_1": true
      },
      "irreversible": false,
      "goto": "ch02_s22_shuge"
    }
  ]
}
