        "affinity.wenqiao": 1,
        "flag.self_submit_cap": true
      },
      "irreversible": true,
      "goto": "ch01_s09_shuge"
    },
    {
      "id": "ch01_s08_shuge.cB",
      "text": "午后前都收，评卷顺延",
      "effects": {
        "ming": 1,
        "shi": -1,
        "affinity.liqinghe": 2,
        "affinity.wenqiao": 1,
        "flag.self_submit_window": true
      },
      "irreversible": true,
      "goto": "ch01_s09_shuge"
    }
  ]
}
