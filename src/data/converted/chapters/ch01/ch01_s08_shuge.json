{
  "id": "ch01_s08_shuge",
  "chapter": 1,
  "act": 1,
  "scene": "shuge",
  "palette": "gold",
  "cast": [
    "wuze",
    "liqinghe",
    "tangjian"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "宫内策问试收无荐卷，以明确限额或时限分担经办成本",
  "lines": [
    {
      "id": "ch01_s08_shuge.l1",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "替谁送卷？经手簿上没有你。"
    },
    {
      "id": "ch01_s08_shuge.l2",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我呈自己的卷，请公主看。"
    },
    {
      "id": "ch01_s08_shuge.l3",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "是自己的卷，便由你答。典记，给她留一行。"
    },
    {
      "id": "ch01_s08_shuge.l4",
      "when": {
        "flag.trial_recopy": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "晨光落在你的指腹上，补抄的墨还没洗净。"
    },
    {
      "id": "ch01_s08_shuge.l5",
      "when": {
        "flag.trial_recopy": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "你替误了工的人抄完了簿页，预先看题的时辰也过去了，今日只能当场读。"
    },
    {
      "id": "ch01_s08_shuge.l6",
      "when": {
        "flag.trial_recopy": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "请给我半刻，我没看过便不装作看过，漏答的地方也请记在我名下。"
    },
    {
      "id": "ch01_s08_shuge.l7",
      "when": {
        "flag.trial_recopy": true
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "读吧。我等半刻，不多给。"
    },
    {
      "id": "ch01_s08_shuge.l8",
      "when": {
        "flag.trial_append": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "晨光照着附改处，新旧两道墨迹一同留在案上。"
    },
    {
      "id": "ch01_s08_shuge.l9",
      "when": {
        "flag.trial_append": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "那日试次虽续上了，这份新旧并存的纸仍待说明，先说清楚才能开卷。"
    },
    {
      "id": "ch01_s08_shuge.l10",
      "when": {
        "flag.trial_append": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "原写骑试，裴将军实授牵行，更正处有我署名，请把两份都留给后来问的人。"
    },
    {
      "id": "ch01_s08_shuge.l11",
      "when": {
        "flag.trial_append": true
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "我听明白了。这一段问答也留着。"
    },
    {
      "id": "ch01_s08_shuge.l12",
      "who": "narr",
      "kind": "aside",
      "text": "李令仪扶住高冠，拢起大袖礼衣的袖子，再将册子压平。"
    },
    {
      "id": "ch01_s08_shuge.l13",
      "who": "narr",
      "kind": "aside",
      "text": "风从书阁门缝钻进来；公主翻到末尾，荐名栏尽了，纸还剩半页。"
    },
    {
      "id": "ch01_s08_shuge.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "无人荐的，放哪里？"
    },
    {
      "id": "ch01_s08_shuge.l15",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "这一批没有。"
    },
    {
      "id": "ch01_s08_shuge.l16",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "题不是只给荐名的人看得懂。"
    },
    {
      "id": "ch01_s08_shuge.l17",
      "who": "liqinghe",
      "expr": "guarded",
      "kind": "say",
      "text": "人手却不是半页空纸，写得下十个名字，不等于明日有人看完十份卷。"
    },
    {
      "id": "ch01_s08_shuge.l18",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "我还要核病舍领物。不能另添一夜。"
    },
    {
      "id": "ch01_s08_shuge.l19",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "抄副卷的工钱，能从誊写颂辞那笔里移么？"
    },
    {
      "id": "ch01_s08_shuge.l20",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "省下誊本可以，原文仍留一份。多少？"
    },
    {
      "id": "ch01_s08_shuge.l21",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "温荞那里接得下几份。价钱须先定。"
    },
    {
      "id": "ch01_s08_shuge.l22",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "让她们照所抄的领钱，不因卷子没有入选，就白白抄过一遍。"
    },
    {
      "id": "ch01_s08_shuge.l23",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "这条可以。抄工与评卷分记。"
    },
    {
      "id": "ch01_s08_shuge.l24",
      "who": "narr",
      "kind": "aside",
      "text": "公主抽走两份重复的颂辞誊本，空出一处实实在在的位置。"
    },
    {
      "id": "ch01_s08_shuge.l25",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "自呈另收。不过，要有个止处。"
    },
    {
      "id": "ch01_s08_shuge.l26",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "定份数，先满先止；或定时辰，到时的收齐。"
    },
    {
      "id": "ch01_s08_shuge.l27",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "定份数，晚知道的人吃亏。"
    },
    {
      "id": "ch01_s08_shuge.l28",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "定时辰，来的多就得延后评完，荐名卷也要等。你选哪一笔代价？"
    },
    {
      "id": "ch01_s08_shuge.l29",
      "who": "narr",
      "kind": "aside",
      "text": "唐简拿起木夹，把“自呈”两字夹在空出的案边。"
    },
    {
      "id": "ch01_s08_shuge.l30",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "收下以后，不能仍压在荐名卷底下。"
    },
    {
      "id": "ch01_s08_shuge.l31",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "同批评。我要的是可用的答卷，不是多一摞供人称颂的纸。"
    }
  ],
  "choices": [
    {
      "id": "ch01_s08_shuge.cA",
      "text": "先收六份，满额便明示",
      "effects": {
        "shi": 1,
        "ming": -1,
        "affinity.liqinghe": 2,
        "affinity.wenqiao": 1,
        "flag.self_submit_cap": true
      },
      "irreversible": true,
      "goto": "ch01_s09_shuge"
    },
    {
      "id": "ch01_s08_shuge.cB",
      "text": "午后前都收，评卷顺延",
      "effects": {
        "ming": 1,
        "shi": -1,
        "affinity.liqinghe": 2,
        "affinity.wenqiao": 1,
        "flag.self_submit_window": true
      },
      "irreversible": true,
      "goto": "ch01_s09_shuge"
    }
  ]
}
