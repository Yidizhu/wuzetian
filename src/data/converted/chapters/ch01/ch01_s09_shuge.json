{
  "id": "ch01_s09_shuge",
  "chapter": 1,
  "act": 1,
  "scene": "shuge",
  "palette": "ink",
  "cast": [
    "wuze",
    "liqinghe"
  ],
  "weightless": false,
  "leavesLetter": [
    "liqinghe"
  ],
  "purpose": "看见公主既有自己的判断，也被母亲的评价遮住",
  "lines": [
    {
      "id": "ch01_s09_shuge.l1",
      "who": "narr",
      "kind": "aside",
      "text": "移到侧室，帘影把泥金书签遮成一条暗线。"
    },
    {
      "id": "ch01_s09_shuge.l2",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "方才你还留了一句话。"
    },
    {
      "id": "ch01_s09_shuge.l3",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你肯收无荐卷，为什么不肯听无宗籍的人谈承统？"
    },
    {
      "id": "ch01_s09_shuge.l4",
      "who": "liqinghe",
      "expr": "guarded",
      "kind": "say",
      "text": "两件事。"
    },
    {
      "id": "ch01_s09_shuge.l5",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "门外的人听起来，可未必是两件。"
    },
    {
      "id": "ch01_s09_shuge.l6",
      "who": "liqinghe",
      "expr": "guarded",
      "kind": "say",
      "text": "宗籍至少让争位的人有个数目，若谁都可自称贤能，你拿什么拦住兵强的人？"
    },
    {
      "id": "ch01_s09_shuge.l7",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "可你先划去许多人，再问剩下的人谁有才能，连比较的地方都没留给她们。"
    },
    {
      "id": "ch01_s09_shuge.l8",
      "who": "narr",
      "kind": "aside",
      "text": "公主合了一半的册子又打开，指尖停在自己的改字上。"
    },
    {
      "id": "ch01_s09_shuge.l9",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "那就拿一个不会只剩刀兵的办法来。别只把门拆了。"
    },
    {
      "id": "ch01_s09_shuge.l10",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我还没有。"
    },
    {
      "id": "ch01_s09_shuge.l11",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "好。这句比方才说得实。"
    },
    {
      "id": "ch01_s09_shuge.l12",
      "who": "narr",
      "kind": "aside",
      "text": "她翻出母亲看过的那一页，原先像是想给你看。"
    },
    {
      "id": "ch01_s09_shuge.l13",
      "who": "narr",
      "kind": "aside",
      "text": "批语只有四字：颇肖朕意。"
    },
    {
      "id": "ch01_s09_shuge.l14",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "这处是我改了三夜的。"
    },
    {
      "id": "ch01_s09_shuge.l15",
      "who": "narr",
      "kind": "aside",
      "text": "她说完，把要递过来的手停在半途。"
    },
    {
      "id": "ch01_s09_shuge.l16",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这里跟前文不一样，拿掉一层代领，病着的人须多一个见证，对么？"
    },
    {
      "id": "ch01_s09_shuge.l17",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "对。"
    },
    {
      "id": "ch01_s09_shuge.l18",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "多的那个人，谁去找？"
    },
    {
      "id": "ch01_s09_shuge.l19",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "你真一点也不肯放过。"
    },
    {
      "id": "ch01_s09_shuge.l20",
      "who": "narr",
      "kind": "aside",
      "text": "她这回把整页推过来，遮住那四字，只露自己的正文。"
    },
    {
      "id": "ch01_s09_shuge.l21",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "明日再来挑一处，我想知道你读见了什么，不必先告诉我像谁。"
    },
    {
      "id": "ch01_s09_shuge.l22",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "挑赢了，有什么？"
    },
    {
      "id": "ch01_s09_shuge.l23",
      "who": "liqinghe",
      "expr": "open",
      "kind": "say",
      "text": "我改。挑错了，你改。"
    },
    {
      "id": "ch01_s09_shuge.l24",
      "who": "narr",
      "kind": "aside",
      "text": "帘外有人走过。她没有把你这边的坐席撤远。"
    }
  ],
  "choices": [
    {
      "id": "ch01_s09_shuge.cA",
      "text": "我来当面挑，也听你驳我",
      "effects": {
        "affinity.liqinghe": 3,
        "flag.liqinghe_open_debate": true
      },
      "irreversible": false,
      "goto": "ch01_s10_yeting"
    },
    {
      "id": "ch01_s09_shuge.cB",
      "text": "先各自写，免得我顺着你说",
      "effects": {
        "affinity.liqinghe": 3,
        "flag.liqinghe_separate_draft": true
      },
      "irreversible": false,
      "goto": "ch01_s10_yeting"
    }
  ]
}
