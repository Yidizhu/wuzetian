{
  "id": "ch01_s11_shishe",
  "chapter": 1,
  "act": 1,
  "scene": "shishe",
  "palette": "ink",
  "cast": [
    "wuze",
    "wenqiao"
  ],
  "weightless": false,
  "leavesLetter": [
    "wenqiao"
  ],
  "purpose": "雨中抢收纸张，温荞先付抄工，再让主角看自己被撤掉的署名",
  "lines": [
    {
      "id": "ch01_s11_shishe.l1",
      "who": "narr",
      "kind": "aside",
      "text": "布包送往病舍时，你走到了诗社檐下。"
    },
    {
      "id": "ch01_s11_shishe.l2",
      "who": "narr",
      "kind": "aside",
      "text": "雨忽然砸在檐口，晾纸绳一抖，水沿着纸角往下淌。",
      "image": "e39_ch01_s11_l2"
    },
    {
      "id": "ch01_s11_shishe.l3",
      "who": "narr",
      "kind": "aside",
      "text": "温荞高挽着髻，指间夹一角样纸，身子已经探到廊外。"
    },
    {
      "id": "ch01_s11_shishe.l4",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "来取哪份卷？"
    },
    {
      "id": "ch01_s11_shishe.l5",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "温先生么？"
    },
    {
      "id": "ch01_s11_shishe.l6",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "是我。"
    },
    {
      "id": "ch01_s11_shishe.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我来问纸钱。"
    },
    {
      "id": "ch01_s11_shishe.l8",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "问价的，先搭把手。"
    },
    {
      "id": "ch01_s11_shishe.l9",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "从纸角——"
    },
    {
      "id": "ch01_s11_shishe.l10",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "别拉角！"
    },
    {
      "id": "ch01_s11_shishe.l11",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch01_s11_shishe.l12",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "托住底下，湿纸可经不起扯。"
    },
    {
      "id": "ch01_s11_shishe.l13",
      "who": "narr",
      "kind": "aside",
      "text": "你来不及答，双手接住垂下的一大片纸，冷水顺着腕子流进袖里。"
    },
    {
      "id": "ch01_s11_shishe.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "放哪儿？"
    },
    {
      "id": "ch01_s11_shishe.l15",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "里头竹架，慢点，脚下有水。"
    },
    {
      "id": "ch01_s11_shishe.l16",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "竹架。"
    },
    {
      "id": "ch01_s11_shishe.l17",
      "who": "narr",
      "kind": "aside",
      "text": "她一脚抵住门，腾出两手，和你抬过湿滑的门槛。",
      "image": "e39_ch01_s11_l17"
    },
    {
      "id": "ch01_s11_shishe.l18",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "还好，明日的饭钱没全淋掉。"
    },
    {
      "id": "ch01_s11_shishe.l19",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这张裂了。"
    },
    {
      "id": "ch01_s11_shishe.l20",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "哪张？"
    },
    {
      "id": "ch01_s11_shishe.l21",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "晒干做小笺，别忙着替它办丧事。"
    },
    {
      "id": "ch01_s11_shishe.l22",
      "who": "narr",
      "kind": "aside",
      "text": "她把钱分成几堆，逐堆压在抄好的卷下。"
    },
    {
      "id": "ch01_s11_shishe.l23",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "这几堆是抄工的钱，入不入选都得给。"
    },
    {
      "id": "ch01_s11_shishe.l24",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch01_s11_shishe.l25",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "你争的那句话，我听见了。"
    },
    {
      "id": "ch01_s11_shishe.l26",
      "when": {
        "flag.self_submit_cap": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "第七份卷用干布包着，没有压进那六份里。"
    },
    {
      "id": "ch01_s11_shishe.l27",
      "when": {
        "flag.self_submit_cap": true
      },
      "who": "wenqiao",
      "expr": "guarded",
      "kind": "say",
      "text": "第七份，来时六份已满。"
    },
    {
      "id": "ch01_s11_shishe.l28",
      "when": {
        "flag.self_submit_cap": true
      },
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "第七份……"
    },
    {
      "id": "ch01_s11_shishe.l29",
      "when": {
        "flag.self_submit_cap": true
      },
      "who": "wenqiao",
      "expr": "guarded",
      "kind": "say",
      "text": "你定只收六份，她就真的交不进去了。"
    },
    {
      "id": "ch01_s11_shishe.l30",
      "when": {
        "flag.self_submit_cap": true
      },
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "不能悄悄塞进去。"
    },
    {
      "id": "ch01_s11_shishe.l31",
      "when": {
        "flag.self_submit_cap": true
      },
      "who": "wenqiao",
      "expr": "guarded",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch01_s11_shishe.l32",
      "when": {
        "flag.self_submit_cap": true
      },
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "退回时问问她，肯不肯等下次。"
    },
    {
      "id": "ch01_s11_shishe.l33",
      "when": {
        "flag.self_submit_cap": true
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "我去问，她若不等，也别替她惋惜。"
    },
    {
      "id": "ch01_s11_shishe.l34",
      "when": {
        "flag.self_submit_window": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "收卷篮满了，旁边又添一只，雨水滴在空篮沿上。",
      "image": "e39_ch01_s11_l34"
    },
    {
      "id": "ch01_s11_shishe.l35",
      "when": {
        "flag.self_submit_window": true
      },
      "who": "wenqiao",
      "expr": "guarded",
      "kind": "say",
      "text": "午后前的都收了，评卷的日子也往后推了。"
    },
    {
      "id": "ch01_s11_shishe.l36",
      "when": {
        "flag.self_submit_window": true
      },
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "所有人都得多等。"
    },
    {
      "id": "ch01_s11_shishe.l37",
      "when": {
        "flag.self_submit_window": true
      },
      "who": "wenqiao",
      "expr": "guarded",
      "kind": "say",
      "text": "等到哪日，我得一个个答。"
    },
    {
      "id": "ch01_s11_shishe.l38",
      "when": {
        "flag.self_submit_window": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "多抄的卷，也照原价付钱。"
    },
    {
      "id": "ch01_s11_shishe.l39",
      "when": {
        "flag.self_submit_window": true
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "你说。"
    },
    {
      "id": "ch01_s11_shishe.l40",
      "when": {
        "flag.self_submit_window": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "别通夜赶，让人以为我没耽误工。"
    },
    {
      "id": "ch01_s11_shishe.l41",
      "when": {
        "flag.self_submit_window": true
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "已分两日做；等的人骂急了，也照实回。"
    },
    {
      "id": "ch01_s11_shishe.l42",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那你的钱呢？"
    },
    {
      "id": "ch01_s11_shishe.l43",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "我的？"
    },
    {
      "id": "ch01_s11_shishe.l44",
      "who": "narr",
      "kind": "aside",
      "text": "她从最下面抽出一张印样，题下有一块刮薄的纸。"
    },
    {
      "id": "ch01_s11_shishe.l45",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "他们肯收诗，却要删掉我的名字。这笔我不接。"
    },
    {
      "id": "ch01_s11_shishe.l46",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "你看这里。"
    },
    {
      "id": "ch01_s11_shishe.l47",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "拿你的诗，不让人知道是你写的？"
    },
    {
      "id": "ch01_s11_shishe.l48",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "句子也认得出是你的。"
    },
    {
      "id": "ch01_s11_shishe.l49",
      "who": "wenqiao",
      "expr": "guarded",
      "kind": "say",
      "text": "读者认出句子是读者的本事，名字仍该由他们写上。"
    },
    {
      "id": "ch01_s11_shishe.l50",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch01_s11_shishe.l51",
      "who": "wenqiao",
      "expr": "guarded",
      "kind": "say",
      "text": "认得出，也不能抵掉该署的名字。"
    },
    {
      "id": "ch01_s11_shishe.l52",
      "who": "narr",
      "kind": "aside",
      "text": "她把印样折起，先把抄工的钱放回原处。"
    },
    {
      "id": "ch01_s11_shishe.l53",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我有份呈文，想请你看看。"
    },
    {
      "id": "ch01_s11_shishe.l54",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "借我的纸，还是借我的嘴？"
    },
    {
      "id": "ch01_s11_shishe.l55",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这个……"
    },
    {
      "id": "ch01_s11_shishe.l56",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "都想借一点。"
    },
    {
      "id": "ch01_s11_shishe.l57",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "倒实在。"
    },
    {
      "id": "ch01_s11_shishe.l58",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "纸能卖，嘴不论尺。"
    },
    {
      "id": "ch01_s11_shishe.l59",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "出了钱，也得听你挑错？"
    },
    {
      "id": "ch01_s11_shishe.l60",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "你若要我写得像我，就得容我说几句不顺耳的话。"
    },
    {
      "id": "ch01_s11_shishe.l61",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch01_s11_shishe.l62",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "你付的是纸钱，可没买下我赞成。"
    },
    {
      "id": "ch01_s11_shishe.l63",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "知道了。"
    },
    {
      "id": "ch01_s11_shishe.l64",
      "who": "narr",
      "kind": "aside",
      "text": "她把裂开的纸背翻过来，上头只有半行未成的字。"
    },
    {
      "id": "ch01_s11_shishe.l65",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "这半行是裁剩的。"
    },
    {
      "id": "ch01_s11_shishe.l66",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "半行。"
    },
    {
      "id": "ch01_s11_shishe.l67",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "呈文先放这里，等纸干了再看。"
    },
    {
      "id": "ch01_s11_shishe.l68",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "免得两面的墨洇在一处。"
    },
    {
      "id": "ch01_s11_shishe.l69",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "我看看。"
    },
    {
      "id": "ch01_s11_shishe.l70",
      "who": "narr",
      "kind": "aside",
      "text": "她将那半行朝下，把空白处留给你的呈文。"
    },
    {
      "id": "ch01_s11_shishe.l71",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "背面也算纸钱么？"
    },
    {
      "id": "ch01_s11_shishe.l72",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "算半张，别把字挤过来。"
    },
    {
      "id": "ch01_s11_shishe.l73",
      "who": "narr",
      "kind": "aside",
      "text": "檐外雨声薄下去，你们把湿纸挪到风能吹到的一层。",
      "image": "e39_ch01_s11_l73"
    }
  ],
  "choices": [
    {
      "id": "ch01_s11_shishe.cA",
      "text": "请你挑错，呈文由我自己署",
      "effects": {
        "cai": 1,
        "affinity.wenqiao": 4,
        "flag.wen_editor_only": true
      },
      "irreversible": false,
      "goto": "ch01_s12_shuge"
    },
    {
      "id": "ch01_s11_shishe.cB",
      "text": "今日不借你的话，只买这一张纸",
      "effects": {
        "shi": 1,
        "affinity.wenqiao": 4,
        "flag.wen_paper_only": true
      },
      "irreversible": false,
      "goto": "ch01_s12_shuge"
    }
  ]
}
