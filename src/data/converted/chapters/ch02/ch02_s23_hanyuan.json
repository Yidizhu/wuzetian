{
  "id": "ch02_s23_hanyuan",
  "chapter": 2,
  "act": 2,
  "scene": "hanyuan",
  "palette": "gold",
  "cast": [
    "wuze",
    "liqinghe",
    "shenheng",
    "tangjian",
    "hetaihou"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "正式开放非宗室提名，本轮候选名单公布",
  "lines": [
    {
      "id": "ch02_s23_hanyuan.l1",
      "who": "narr",
      "kind": "aside",
      "text": "工时与批注收齐后，你等到了正式议决。"
    },
    {
      "id": "ch02_s23_hanyuan.l2",
      "who": "narr",
      "kind": "aside",
      "text": "正式议决那日，唐简展开颁牒。案后的帘已卷起。"
    },
    {
      "id": "ch02_s23_hanyuan.l3",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "奉诏，承统受荐，不限宗姓。"
    },
    {
      "id": "ch02_s23_hanyuan.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不限宗姓。"
    },
    {
      "id": "ch02_s23_hanyuan.l5",
      "when": {
        "flag.nomination_joint_review": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "本轮三处联署，回避、申辩、复核照附条行。"
    },
    {
      "id": "ch02_s23_hanyuan.l6",
      "when": {
        "flag.nomination_joint_review": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "三处联署。"
    },
    {
      "id": "ch02_s23_hanyuan.l7",
      "when": {
        "flag.nomination_open_questions": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "本轮限期试问，寄卷、旅费、复核照附条行。"
    },
    {
      "id": "ch02_s23_hanyuan.l8",
      "when": {
        "flag.nomination_open_questions": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "限期试问。"
    },
    {
      "id": "ch02_s23_hanyuan.l9",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "此后变更仍须再议，不得只为一人破例。"
    },
    {
      "id": "ch02_s23_hanyuan.l10",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "陛下依议颁条，谁受位仍待比较，今日不定。"
    },
    {
      "id": "ch02_s23_hanyuan.l11",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "名册。"
    },
    {
      "id": "ch02_s23_hanyuan.l12",
      "who": "narr",
      "kind": "aside",
      "text": "唐简另展开一页，本轮核准处有两行。"
    },
    {
      "id": "ch02_s23_hanyuan.l13",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "李令仪。{名}。"
    },
    {
      "id": "ch02_s23_hanyuan.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "都核过了？"
    },
    {
      "id": "ch02_s23_hanyuan.l15",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "你看。"
    },
    {
      "id": "ch02_s23_hanyuan.l16",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "履历、支出、未决之事，两人的都附了。"
    },
    {
      "id": "ch02_s23_hanyuan.l17",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "两人的。"
    },
    {
      "id": "ch02_s23_hanyuan.l18",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "你的擅引与她的旧支出，一样在册后。"
    },
    {
      "id": "ch02_s23_hanyuan.l19",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "异议仍可依限送来，入册不封后面的口。"
    },
    {
      "id": "ch02_s23_hanyuan.l20",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "明日交全稿，你也交。"
    },
    {
      "id": "ch02_s23_hanyuan.l21",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "全稿。"
    },
    {
      "id": "ch02_s23_hanyuan.l22",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不是只交愿给人看——"
    },
    {
      "id": "ch02_s23_hanyuan.l23",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "全部。"
    },
    {
      "id": "ch02_s23_hanyuan.l24",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s23_hanyuan.l25",
      "who": "narr",
      "kind": "aside",
      "text": "你看着两行字。自己的名字旁边，没有比另一行多一寸位置。"
    },
    {
      "id": "ch02_s23_hanyuan.l26",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "这一步到了，后面不能再拿来路苦作答。"
    },
    {
      "id": "ch02_s23_hanyuan.l27",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "往后……"
    },
    {
      "id": "ch02_s23_hanyuan.l28",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "问的只会更多。"
    },
    {
      "id": "ch02_s23_hanyuan.l29",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那就从全稿问起。"
    },
    {
      "id": "ch02_s23_hanyuan.l30",
      "who": "narr",
      "kind": "aside",
      "text": "你收好名册的存件，准备从全稿问起。"
    }
  ],
  "choices": [
    {
      "id": "ch02_s23_hanyuan.cA",
      "text": "收下候选文牒，准备比较",
      "effects": {
        "flag.succession_open": true
      },
      "irreversible": false,
      "goto": "ch02_s26_shuge"
    }
  ]
}
