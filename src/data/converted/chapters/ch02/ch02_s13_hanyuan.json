{
  "id": "ch02_s13_hanyuan",
  "chapter": 2,
  "act": 2,
  "scene": "hanyuan",
  "palette": "gold",
  "cast": [
    "wuze",
    "shenheng",
    "hetaihou",
    "tangjian",
    "wenqiao"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "对齐取得和宣读的责任，停止继续抄传",
  "lines": [
    {
      "id": "ch02_s13_hanyuan.l1",
      "who": "narr",
      "kind": "aside",
      "text": "灯留给了阿荻，你再回夜议的席上。"
    },
    {
      "id": "ch02_s13_hanyuan.l2",
      "who": "narr",
      "kind": "aside",
      "text": "回到席上，封线仍摊在匣边，灯油少了半指。"
    },
    {
      "id": "ch02_s13_hanyuan.l3",
      "when": {
        "flag.letter_recall_first": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "外案两份先收回，验封迟了一刻。"
    },
    {
      "id": "ch02_s13_hanyuan.l4",
      "when": {
        "flag.letter_recall_first": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "一刻。"
    },
    {
      "id": "ch02_s13_hanyuan.l5",
      "when": {
        "flag.letter_recall_first": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "原件一直由我与沈司记看着。"
    },
    {
      "id": "ch02_s13_hanyuan.l6",
      "when": {
        "flag.letter_seal_first": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "先验封，再收外案两份，未曾续发。"
    },
    {
      "id": "ch02_s13_hanyuan.l7",
      "when": {
        "flag.letter_seal_first": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "两份。"
    },
    {
      "id": "ch02_s13_hanyuan.l8",
      "when": {
        "flag.letter_seal_first": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "待递的人多等了一刻。"
    },
    {
      "id": "ch02_s13_hanyuan.l9",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "一份也没出门？"
    },
    {
      "id": "ch02_s13_hanyuan.l10",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "今夜这两份没有，先前去西库的另算。"
    },
    {
      "id": "ch02_s13_hanyuan.l11",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "西库……"
    },
    {
      "id": "ch02_s13_hanyuan.l12",
      "when": {
        "flag.petition_chase_first": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "西库原牒与已发抄件逐处追回，都核在册上。"
    },
    {
      "id": "ch02_s13_hanyuan.l13",
      "when": {
        "flag.petition_chase_first": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "都在册上。"
    },
    {
      "id": "ch02_s13_hanyuan.l14",
      "when": {
        "flag.petition_explain_first": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "多发那一处已取回，谁看过、何时收都记了。"
    },
    {
      "id": "ch02_s13_hanyuan.l15",
      "when": {
        "flag.petition_explain_first": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "收回时刻。"
    },
    {
      "id": "ch02_s13_hanyuan.l16",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "阿荻那行，重抄时去掉能认人的细节。"
    },
    {
      "id": "ch02_s13_hanyuan.l17",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "分项证词留本案，不再跟你的呈文抄。"
    },
    {
      "id": "ch02_s13_hanyuan.l18",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "留本案。"
    },
    {
      "id": "ch02_s13_hanyuan.l19",
      "when": {
        "flag.wen_stop_at_hurt": true
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "停这儿，更正不必再抄她的私话。"
    },
    {
      "id": "ch02_s13_hanyuan.l20",
      "when": {
        "flag.wen_stop_at_hurt": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "停这儿。"
    },
    {
      "id": "ch02_s13_hanyuan.l21",
      "when": {
        "flag.wen_finish_then_note": true
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "听完了，更正时撤掉引她私话的原句。"
    },
    {
      "id": "ch02_s13_hanyuan.l22",
      "when": {
        "flag.wen_finish_then_note": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "原句。"
    },
    {
      "id": "ch02_s13_hanyuan.l23",
      "when": {
        "flag.wen_reader_help": false
      },
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "只核给我看的公务摘录，私段不看。"
    },
    {
      "id": "ch02_s13_hanyuan.l24",
      "when": {
        "flag.wen_reader_help": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "只核摘录。"
    },
    {
      "id": "ch02_s13_hanyuan.l25",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "取笺的令与准读的决定，两项都署我的名。"
    },
    {
      "id": "ch02_s13_hanyuan.l26",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "停发、取封、宣读，我逐项署经手。"
    },
    {
      "id": "ch02_s13_hanyuan.l27",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s13_hanyuan.l28",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "下次不能拿一道令，把里外全读了。"
    },
    {
      "id": "ch02_s13_hanyuan.l29",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "调来先验相关处；公开另列范围，先给本人看。"
    },
    {
      "id": "ch02_s13_hanyuan.l30",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "先给本人。"
    },
    {
      "id": "ch02_s13_hanyuan.l31",
      "who": "shenheng",
      "expr": "guarded",
      "kind": "say",
      "text": "私情不作错办实据。"
    },
    {
      "id": "ch02_s13_hanyuan.l32",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "记上，旧案仍须依原件查，不能一并停掉。"
    },
    {
      "id": "ch02_s13_hanyuan.l33",
      "who": "narr",
      "kind": "aside",
      "text": "沈伸手去理封线，线头从两指间落了两回。"
    },
    {
      "id": "ch02_s13_hanyuan.l34",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我来——"
    },
    {
      "id": "ch02_s13_hanyuan.l35",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "放着。"
    },
    {
      "id": "ch02_s13_hanyuan.l36",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s13_hanyuan.l37",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "让我坐一会儿。"
    },
    {
      "id": "ch02_s13_hanyuan.l38",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "坐一会儿。"
    },
    {
      "id": "ch02_s13_hanyuan.l39",
      "who": "narr",
      "kind": "aside",
      "text": "众人转去核议抄。你把挡路的矮凳移开，留在她身旁。"
    },
    {
      "id": "ch02_s13_hanyuan.l40",
      "who": "shenheng",
      "expr": "guarded",
      "kind": "say",
      "text": "他们都听见了，我知道。"
    },
    {
      "id": "ch02_s13_hanyuan.l41",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "我知道。"
    },
    {
      "id": "ch02_s13_hanyuan.l42",
      "who": "shenheng",
      "expr": "guarded",
      "kind": "say",
      "text": "方才还想折回去，折到没开过的时候。"
    },
    {
      "id": "ch02_s13_hanyuan.l43",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不用再念给我听。"
    },
    {
      "id": "ch02_s13_hanyuan.l44",
      "when": {
        "flag.shen_ch02_private_yes": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "今夜仍想见你，谁听过信，都不替我收回。"
    },
    {
      "id": "ch02_s13_hanyuan.l45",
      "when": {
        "flag.shen_ch02_private_yes": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "今夜。"
    },
    {
      "id": "ch02_s13_hanyuan.l46",
      "when": {
        "flag.shen_ch02_private_wait": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "私见照你说的缓，我方才却一直听着门口。"
    },
    {
      "id": "ch02_s13_hanyuan.l47",
      "when": {
        "flag.shen_ch02_private_wait": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "门口……"
    },
    {
      "id": "ch02_s13_hanyuan.l48",
      "when": {
        "flag.shen_ch02_private_no": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "不约私见，照你说的办。"
    },
    {
      "id": "ch02_s13_hanyuan.l49",
      "when": {
        "flag.shen_ch02_private_no": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s13_hanyuan.l50",
      "when": {
        "flag.shen_ch02_private_no": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "盼你回来是我的话，不要你改口。"
    },
    {
      "id": "ch02_s13_hanyuan.l51",
      "when": {
        "flag.shen_ch02_help_no": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "没接陪读也不欠我，方才想叫你，与旧卷无关。"
    },
    {
      "id": "ch02_s13_hanyuan.l52",
      "when": {
        "flag.shen_ch02_help_no": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "叫我。"
    },
    {
      "id": "ch02_s13_hanyuan.l53",
      "who": "self",
      "kind": "inner",
      "text": "（她叫的是我。不是等一个人替她署名。）"
    },
    {
      "id": "ch02_s13_hanyuan.l54",
      "who": "narr",
      "kind": "aside",
      "text": "沈把手放回膝上。唐简将两种存法分别写在纸边。"
    },
    {
      "id": "ch02_s13_hanyuan.l55",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "存法……"
    },
    {
      "id": "ch02_s13_hanyuan.l56",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你说。"
    },
    {
      "id": "ch02_s13_hanyuan.l57",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "全笺限阅封存，日后好核，得留人看守。"
    },
    {
      "id": "ch02_s13_hanyuan.l58",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "退还私笺，后查就得另请本人。"
    },
    {
      "id": "ch02_s13_hanyuan.l59",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "两样都可，公开只留公务摘录。"
    },
    {
      "id": "ch02_s13_hanyuan.l60",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch02_s13_hanyuan.l61",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不能说封存了，就当没读过。"
    },
    {
      "id": "ch02_s13_hanyuan.l62",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "准读失当与更正都留，收回抄件也不许删。"
    },
    {
      "id": "ch02_s13_hanyuan.l63",
      "who": "narr",
      "kind": "aside",
      "text": "唐简将准读失当的记录留在封簿上。"
    }
  ],
  "dressing": "gongyi",
  "choices": [
    {
      "id": "ch02_s13_hanyuan.cA",
      "text": "全笺限阅，另存公务摘录",
