        "affinity.shenheng": 2,
        "affinity.wenqiao": 2,
        "flag.letter_keep_sealed": true
      },
      "irreversible": false,
      "goto": "ch02_s14_zhaoyang"
    },
    {
      "id": "ch02_s13_hanyuan.cB",
      "text": "验存公务摘录，退还私笺",
      "effects": {
        "affinity.shenheng": 2,
        "affinity.wenqiao": 2,
        "flag.letter_return_private": true
      },
      "irreversible": false,
      "goto": "ch02_s14_zhaoyang"
    }
  ]
}
