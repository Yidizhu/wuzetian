{
  "id": "ch02_s03_nvguan",
  "chapter": 2,
  "act": 2,
  "scene": "nvguan",
  "palette": "ink",
  "cast": [
    "wuze",
    "xujinghe",
    "songhuizhen",
    "adi"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "暂住须由阿荻自己选，许的观舍也有边界",
  "lines": [
    {
      "id": "ch02_s03_nvguan.l1",
      "who": "narr",
      "kind": "aside",
      "text": "粥碗放下后，你随阿荻到观里看一看。"
    },
    {
      "id": "ch02_s03_nvguan.l2",
      "who": "narr",
      "kind": "aside",
      "text": "晨风把晾毯吹得贴上柱子。你伸手扯开。"
    },
    {
      "id": "ch02_s03_nvguan.l3",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "她只说来看看，别先替她铺。"
    },
    {
      "id": "ch02_s03_nvguan.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "看看。"
    },
    {
      "id": "ch02_s03_nvguan.l5",
      "when": {
        "flag.adi_verify_now": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "九件核过了，出门又念了一遍。"
    },
    {
      "id": "ch02_s03_nvguan.l6",
      "when": {
        "flag.adi_verify_now": true
      },
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "我改了一个字。"
    },
    {
      "id": "ch02_s03_nvguan.l7",
      "when": {
        "flag.adi_verify_now": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "一个字。"
    },
    {
      "id": "ch02_s03_nvguan.l8",
      "when": {
        "flag.adi_verify_later": true
      },
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "午后还回去核，今日不住。"
    },
    {
      "id": "ch02_s03_nvguan.l9",
      "when": {
        "flag.adi_verify_later": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "今日。"
    },
    {
      "id": "ch02_s03_nvguan.l10",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "看看可以，先替我拿住这一角。"
    },
    {
      "id": "ch02_s03_nvguan.l11",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这角？"
    },
    {
      "id": "ch02_s03_nvguan.l12",
      "who": "narr",
      "kind": "aside",
      "text": "毯里还存着潮气，压得你两臂往下一沉。"
    },
    {
      "id": "ch02_s03_nvguan.l13",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "西间有空床？"
    },
    {
      "id": "ch02_s03_nvguan.l14",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "今晚有人回来。"
    },
    {
      "id": "ch02_s03_nvguan.l15",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "有人回来……"
    },
    {
      "id": "ch02_s03_nvguan.l16",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "挪一挪——"
    },
    {
      "id": "ch02_s03_nvguan.l17",
      "who": "xujinghe",
      "expr": "guarded",
      "kind": "say",
      "text": "先放下。"
    },
    {
      "id": "ch02_s03_nvguan.l18",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s03_nvguan.l19",
      "who": "narr",
      "kind": "aside",
      "text": "许将毯折过你手背，领你放到干净木架上。"
    },
    {
      "id": "ch02_s03_nvguan.l20",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "她只说看看，你却问床；答应你了，听谁的？"
    },
    {
      "id": "ch02_s03_nvguan.l21",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "听她的。"
    },
    {
      "id": "ch02_s03_nvguan.l22",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "阿荻，你……"
    },
    {
      "id": "ch02_s03_nvguan.l23",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "我说了，今日不住。"
    },
    {
      "id": "ch02_s03_nvguan.l24",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "是我又……"
    },
    {
      "id": "ch02_s03_nvguan.l25",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "水开了没有？"
    },
    {
      "id": "ch02_s03_nvguan.l26",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "还差些，摸杯，别摸壶。"
    },
    {
      "id": "ch02_s03_nvguan.l27",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "知道。"
    },
    {
      "id": "ch02_s03_nvguan.l28",
      "who": "narr",
      "kind": "aside",
      "text": "宋捋开衣缘，露出一线紫。许认了，递给她常用的杯。"
    },
    {
      "id": "ch02_s03_nvguan.l29",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "她寄来的簪修好了，旧的我舍不得换。"
    },
    {
      "id": "ch02_s03_nvguan.l30",
      "who": "xujinghe",
      "expr": "open",
      "kind": "say",
      "text": "你们在这里换过一回，还不够？"
    },
    {
      "id": "ch02_s03_nvguan.l31",
      "who": "songhuizhen",
      "expr": "open",
      "kind": "say",
      "text": "那回……"
    },
    {
      "id": "ch02_s03_nvguan.l32",
      "who": "songhuizhen",
      "expr": "open",
      "kind": "say",
      "text": "那回她先插歪了。"
    },
    {
      "id": "ch02_s03_nvguan.l33",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "真想住，我自己问。"
    },
    {
      "id": "ch02_s03_nvguan.l34",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "你自己问。"
    },
    {
      "id": "ch02_s03_nvguan.l35",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "没床就说没床，别为我赶人。"
    },
    {
      "id": "ch02_s03_nvguan.l36",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch02_s03_nvguan.l37",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "水开了。"
    },
    {
      "id": "ch02_s03_nvguan.l38",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "杯子我拿过去。"
    },
    {
      "id": "ch02_s03_nvguan.l39",
      "who": "narr",
      "kind": "aside",
      "text": "你一只只拿，阿荻提壶。谁也没去西间铺床。"
    }
  ],
  "goto": "ch02_s04_shuge"
}
