{
  "id": "ch02_s11_hanyuan",
  "chapter": 2,
  "act": 2,
  "scene": "hanyuan",
  "palette": "gold",
  "cast": [
    "wuze",
    "shenheng",
    "hetaihou",
    "tangjian",
    "liqinghe",
    "xujinghe"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "公议将私笺变成私交记录，沈与主角制止继续宣读",
  "lines": [
    {
      "id": "ch02_s11_hanyuan.l1",
      "who": "narr",
      "kind": "aside",
      "text": "离开许静和的灯下，你赶去含元殿夜议。"
    },
    {
      "id": "ch02_s11_hanyuan.l2",
      "who": "narr",
      "kind": "aside",
      "text": "夜议的灯排在案后。唐简将封匣放到光下。"
    },
    {
      "id": "ch02_s11_hanyuan.l3",
      "who": "narr",
      "kind": "aside",
      "text": "何太后冠上横梁掠过灯影，大袖垂在案侧，一只手扶着案沿。"
    },
    {
      "id": "ch02_s11_hanyuan.l4",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "先核“无券，不录”这句，谁当年经手？"
    },
    {
      "id": "ch02_s11_hanyuan.l5",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "臣。"
    },
    {
      "id": "ch02_s11_hanyuan.l6",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "你。"
    },
    {
      "id": "ch02_s11_hanyuan.l7",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "旧案在此，今晨往返笺与调卷回执同封。"
    },
    {
      "id": "ch02_s11_hanyuan.l8",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "午后提过异议，私段不许随卷读。"
    },
    {
      "id": "ch02_s11_hanyuan.l9",
      "who": "shenheng",
      "expr": "guarded",
      "kind": "say",
      "text": "是。"
    },
    {
      "id": "ch02_s11_hanyuan.l10",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "相关往返是我具令调的，取到时如何？"
    },
    {
      "id": "ch02_s11_hanyuan.l11",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "未发，外封有案号，按令停发，簿上已记。"
    },
    {
      "id": "ch02_s11_hanyuan.l12",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "午后验过，到我手里原封未开。"
    },
    {
      "id": "ch02_s11_hanyuan.l13",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "原封。"
    },
    {
      "id": "ch02_s11_hanyuan.l14",
      "who": "shenheng",
      "expr": "guarded",
      "kind": "say",
      "text": "回执可核，还有只给她的话。"
    },
    {
      "id": "ch02_s11_hanyuan.l15",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "只给我的。"
    },
    {
      "id": "ch02_s11_hanyuan.l16",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "谁校谁的稿，也得核；准依旧例全读。"
    },
    {
      "id": "ch02_s11_hanyuan.l17",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s11_hanyuan.l18",
      "who": "narr",
      "kind": "aside",
      "text": "唐简取下封线。窄笺的两道折口，在灯下摊成一片。"
    },
    {
      "id": "ch02_s11_hanyuan.l19",
      "when": {
        "flag.shen_joint_reading": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "“旧驳语请依原句读。我若先辩两券之缺，请把那句读完。”"
    },
    {
      "id": "ch02_s11_hanyuan.l20",
      "when": {
        "flag.shen_ch02_help_no": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "“陪读既未约成，旧卷由我自核；调卷回执仍请按公务收认。”"
    },
    {
      "id": "ch02_s11_hanyuan.l21",
      "when": {
        "flag.shen_ch02_private_yes": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "“读完也想见你。今日应下的相见，若有变动，递一句话便好。”"
    },
    {
      "id": "ch02_s11_hanyuan.l22",
      "when": {
        "flag.shen_ch02_private_wait": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "“私下相见照你说的暂缓。哪日想来，再问，不拿旧卷催你。”"
    },
    {
      "id": "ch02_s11_hanyuan.l23",
      "when": {
        "flag.shen_ch02_private_no": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "“你只核此卷、不约私见，我记下了。公事照办，不另候你。”"
    },
    {
      "id": "ch02_s11_hanyuan.l24",
      "when": {
        "flag.shen_ch02_help_no": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "“方才的相邀也不催答，别因这封笺觉得还欠我一次来见。”"
    },
    {
      "id": "ch02_s11_hanyuan.l25",
      "who": "shenheng",
      "expr": "guarded",
      "kind": "say",
      "text": "停，这句没准你读。"
    },
    {
      "id": "ch02_s11_hanyuan.l26",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "停。"
    },
    {
      "id": "ch02_s11_hanyuan.l27",
      "who": "narr",
      "kind": "aside",
      "text": "唐简的手停在下一行上，没有再翻折口。"
    },
    {
      "id": "ch02_s11_hanyuan.l28",
      "who": "hetaihou",
      "expr": "guarded",
      "kind": "say",
      "text": "是我准的。"
    },
    {
      "id": "ch02_s11_hanyuan.l29",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "那就记准读的人。"
    },
    {
      "id": "ch02_s11_hanyuan.l30",
      "who": "tangjian",
      "expr": "guarded",
      "kind": "say",
      "text": "记在……"
    },
    {
      "id": "ch02_s11_hanyuan.l31",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "不能只记我们的话，不记谁叫读的。"
    },
    {
      "id": "ch02_s11_hanyuan.l32",
      "who": "liqinghe",
      "expr": "guarded",
      "kind": "say",
      "text": "祖母，她们已经两次说不准，请先停。"
    },
    {
      "id": "ch02_s11_hanyuan.l33",
      "who": "hetaihou",
      "expr": "guarded",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s11_hanyuan.l34",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "余文停，已读的与准读、异议都照实留下。"
    },
    {
      "id": "ch02_s11_hanyuan.l35",
      "who": "narr",
      "kind": "aside",
      "text": "唐简在议录上写下“私交待核”，再另记准读与反对。"
    },
    {
      "id": "ch02_s11_hanyuan.l36",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "私交待核？"
    },
    {
      "id": "ch02_s11_hanyuan.l37",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "旧议例的目名，旁边写了你不认。"
    },
    {
      "id": "ch02_s11_hanyuan.l38",
      "who": "shenheng",
      "expr": "guarded",
      "kind": "say",
      "text": "我不认这个目名，哪件公务错，列哪件。"
    },
    {
      "id": "ch02_s11_hanyuan.l39",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "哪件。"
    },
    {
      "id": "ch02_s11_hanyuan.l40",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "她给我的话，平日无处记。"
    },
    {
      "id": "ch02_s11_hanyuan.l41",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "今日收得倒快。"
    },
    {
      "id": "ch02_s11_hanyuan.l42",
      "who": "liqinghe",
      "expr": "guarded",
      "kind": "say",
      "text": "今夜核驳案；说私情误事，拿哪件错办为据？"
    },
    {
      "id": "ch02_s11_hanyuan.l43",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s11_hanyuan.l44",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "爱谁不问罪，案如何办，仍要依原卷核问。"
    },
    {
      "id": "ch02_s11_hanyuan.l45",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "依原案问，下一行——"
    },
    {
      "id": "ch02_s11_hanyuan.l46",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不许再读。"
    },
    {
      "id": "ch02_s11_hanyuan.l47",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch02_s11_hanyuan.l48",
      "who": "self",
      "kind": "inner",
      "text": "（那一折还没开。别开。）"
    },
    {
      "id": "ch02_s11_hanyuan.l49",
      "who": "narr",
      "kind": "aside",
      "text": "沈的手搁在案沿，与你隔着那只已拆的匣。"
    },
    {
      "id": "ch02_s11_hanyuan.l50",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "调令、封簿、原笺和议录都留。"
    },
    {
      "id": "ch02_s11_hanyuan.l51",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "都留。"
    },
    {
      "id": "ch02_s11_hanyuan.l52",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "两份待发议抄还在外案。"
    },
    {
      "id": "ch02_s11_hanyuan.l53",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "先别再递。"
    },
    {
      "id": "ch02_s11_hanyuan.l54",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "已停了。"
    },
    {
      "id": "ch02_s11_hanyuan.l55",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch02_s11_hanyuan.l56",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "先收外案的纸还是先验封，须分两趟做。"
    },
    {
      "id": "ch02_s11_hanyuan.l57",
      "who": "narr",
      "kind": "aside",
      "text": "唐简按住封匣，等你排定两趟的先后。"
    }
  ],
  "dressing": "gongyi",
  "choices": [
    {
      "id": "ch02_s11_hanyuan.cA",
      "text": "先收议抄，再一同验封",
