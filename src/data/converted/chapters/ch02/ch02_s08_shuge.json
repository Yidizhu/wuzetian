{
  "id": "ch02_s08_shuge",
  "chapter": 2,
  "act": 2,
  "scene": "shuge",
  "palette": "gold",
  "cast": [
    "wuze",
    "xujinghe",
    "peizhaoye",
    "liqinghe",
    "tangjian"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "女冠校读正式给俸并限差务，同时把调笺授权摆到台前",
  "lines": [
    {
      "id": "ch02_s08_shuge.l1",
      "who": "narr",
      "kind": "aside",
      "text": "粮袋放妥，你回书阁和公主核这一趟脚程。"
    },
    {
      "id": "ch02_s08_shuge.l2",
      "who": "narr",
      "kind": "aside",
      "text": "案上金纹压着旧算筹，李令仪将最短的一根挑出来。"
    },
    {
      "id": "ch02_s08_shuge.l3",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "这半日，谁算的？"
    },
    {
      "id": "ch02_s08_shuge.l4",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "半日？"
    },
    {
      "id": "ch02_s08_shuge.l5",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "从入署算到出署。"
    },
    {
      "id": "ch02_s08_shuge.l6",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "我从观里来，光等入门就多半个时辰。"
    },
    {
      "id": "ch02_s08_shuge.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "门外没算。"
    },
    {
      "id": "ch02_s08_shuge.l8",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "门外。"
    },
    {
      "id": "ch02_s08_shuge.l9",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "那就一同核，你真走过，别照我纸上的猜。"
    },
    {
      "id": "ch02_s08_shuge.l10",
      "when": {
        "flag.pei_check_supply": true
      },
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "欠的护袋布已找到，补领也有凭。"
    },
    {
      "id": "ch02_s08_shuge.l11",
      "when": {
        "flag.pei_check_supply": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "有凭了。"
    },
    {
      "id": "ch02_s08_shuge.l12",
      "when": {
        "flag.pei_check_route": true
      },
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "往返漏了卸袋的一程，时辰得补。"
    },
    {
      "id": "ch02_s08_shuge.l13",
      "when": {
        "flag.pei_check_route": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这一程。"
    },
    {
      "id": "ch02_s08_shuge.l14",
      "when": {
        "flag.pei_check_declined": true
      },
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "另请人核过，往返与缺项分开写了。"
    },
    {
      "id": "ch02_s08_shuge.l15",
      "when": {
        "flag.pei_check_declined": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "分开写。"
    },
    {
      "id": "ch02_s08_shuge.l16",
      "when": {
        "flag.adi_pay_advance": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "九件付清，刷栏推到下旬，做工的已告知。"
    },
    {
      "id": "ch02_s08_shuge.l17",
      "when": {
        "flag.adi_pay_advance": true
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "下旬。"
    },
    {
      "id": "ch02_s08_shuge.l18",
      "when": {
        "flag.adi_pay_original": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "六件先付，三件已催，今夜回报。"
    },
    {
      "id": "ch02_s08_shuge.l19",
      "when": {
        "flag.adi_pay_original": true
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "三件……"
    },
    {
      "id": "ch02_s08_shuge.l20",
      "when": {
        "flag.adi_pay_original": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "催款另记工时。"
    },
    {
      "id": "ch02_s08_shuge.l21",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "这笔也列，别只让我看省下的。"
    },
    {
      "id": "ch02_s08_shuge.l22",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "今日核卷可以，明日病舍的药不能也等。"
    },
    {
      "id": "ch02_s08_shuge.l23",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "明日……"
    },
    {
      "id": "ch02_s08_shuge.l24",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "这里只校读验封，别的还得另问你。"
    },
    {
      "id": "ch02_s08_shuge.l25",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch02_s08_shuge.l26",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "按次，还是算上往返半日？"
    },
    {
      "id": "ch02_s08_shuge.l27",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "按次省款，她就得逐次记路。"
    },
    {
      "id": "ch02_s08_shuge.l28",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "记路。"
    },
    {
      "id": "ch02_s08_shuge.l29",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "半日少零账，空出的时辰也照付。"
    },
    {
      "id": "ch02_s08_shuge.l30",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "两样能接，半日满了就回去。"
    },
    {
      "id": "ch02_s08_shuge.l31",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch02_s08_shuge.l32",
      "who": "narr",
      "kind": "aside",
      "text": "唐简揭开另一只匣。封笺还未拆，旁边夹着调令。"
    },
    {
      "id": "ch02_s08_shuge.l33",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这封是给我的。"
    },
    {
      "id": "ch02_s08_shuge.l34",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "沈司记交的，和调卷回执同送，在待发匣。"
    },
    {
      "id": "ch02_s08_shuge.l35",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "怎么会——"
    },
    {
      "id": "ch02_s08_shuge.l36",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "先停了发。"
    },
    {
      "id": "ch02_s08_shuge.l37",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s08_shuge.l38",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "太后具令调旧案往返，外封有案号。"
    },
    {
      "id": "ch02_s08_shuge.l39",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "母亲委祖母核旧案，今夜公议，调令在此。"
    },
    {
      "id": "ch02_s08_shuge.l40",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "调令。"
    },
    {
      "id": "ch02_s08_shuge.l41",
      "who": "narr",
      "kind": "aside",
      "text": "她展开委牒，唐简指给你看案号与签发处。"
    },
    {
      "id": "ch02_s08_shuge.l42",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "我只验原封，没在这里开过。"
    },
    {
      "id": "ch02_s08_shuge.l43",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "里头的私话……"
    },
    {
      "id": "ch02_s08_shuge.l44",
      "who": "tangjian",
      "expr": "guarded",
      "kind": "say",
      "text": "你说。"
    },
    {
      "id": "ch02_s08_shuge.l45",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "也要读？"
    },
    {
      "id": "ch02_s08_shuge.l46",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "调取没另分，怎么读得去席上问。"
    },
    {
      "id": "ch02_s08_shuge.l47",
      "who": "liqinghe",
      "expr": "guarded",
      "kind": "say",
      "text": "先记你的异议，看见了可不能算你答应。"
    },
    {
      "id": "ch02_s08_shuge.l48",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "记下。"
    },
    {
      "id": "ch02_s08_shuge.l49",
      "who": "narr",
      "kind": "aside",
      "text": "唐简在封簿旁写了一行，笺仍留在匣中。"
    },
    {
      "id": "ch02_s08_shuge.l50",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "许的俸钱先定，今日的脚程她已经走了。"
    },
    {
      "id": "ch02_s08_shuge.l51",
      "who": "narr",
      "kind": "aside",
      "text": "你将许静和的俸钱记在算筹旁。"
    }
  ],
  "choices": [
    {
      "id": "ch02_s08_shuge.cA",
      "text": "连往返按半日给俸",
      "effects": {
        "affinity.liqinghe": 3,
        "affinity.peizhaoye": 2,
        "flag.liqinghe_cost_check": true,
        "flag.nvguan_halfday_pay": true
      },
      "irreversible": false,
      "goto": "ch02_s09_shishe"
    },
    {
      "id": "ch02_s08_shuge.cB",
      "text": "按次给俸，往返另记",
      "effects": {
        "affinity.liqinghe": 3,
        "affinity.peizhaoye": 2,
        "flag.liqinghe_cost_check": true,
        "flag.nvguan_trip_pay": true
      },
      "irreversible": false,
      "goto": "ch02_s09_shishe"
    }
  ]
}
