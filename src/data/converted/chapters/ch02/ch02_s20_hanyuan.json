{
  "id": "ch02_s20_hanyuan",
  "chapter": 2,
  "act": 2,
  "scene": "hanyuan",
  "palette": "gold",
  "cast": [
    "wuze",
    "shenheng",
    "liqinghe",
    "hetaihou",
    "tangjian"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "比较两种非宗室提名办法，承担各自的门槛与成本",
  "lines": [
    {
      "id": "ch02_s20_hanyuan.l1",
      "who": "narr",
      "kind": "aside",
      "text": "你的手又停在含元殿的两份拟条之间。"
    },
    {
      "id": "ch02_s20_hanyuan.l2",
      "who": "narr",
      "kind": "aside",
      "text": "又过数日，两份拟条放在同一案上，留着一样宽的页边。"
    },
    {
      "id": "ch02_s20_hanyuan.l3",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "已经准许先收材料。收进候选的册子，要等新规颁下。"
    },
    {
      "id": "ch02_s20_hanyuan.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "今日先把荐谁的材料收来？"
    },
    {
      "id": "ch02_s20_hanyuan.l5",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "对，只议谁有资格受荐。收了材料，不是就得了位。"
    },
    {
      "id": "ch02_s20_hanyuan.l6",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "从前只许宗姓受荐，这一条要改。"
    },
    {
      "id": "ch02_s20_hanyuan.l7",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "那么荐书由谁查？"
    },
    {
      "id": "ch02_s20_hanyuan.l8",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不能只看谁肯署名。"
    },
    {
      "id": "ch02_s20_hanyuan.l9",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "甲法：三处一同署名，各查她办过的事，各答自己知道的。"
    },
    {
      "id": "ch02_s20_hanyuan.l10",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "可找不齐三处肯署名的人，连门都进不了。"
    },
    {
      "id": "ch02_s20_hanyuan.l11",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "是，不能写成人人都进来了。"
    },
    {
      "id": "ch02_s20_hanyuan.l12",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s20_hanyuan.l13",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "乙法：不必等人举荐，自己呈文，限期来答问，再查做过的事。"
    },
    {
      "id": "ch02_s20_hanyuan.l14",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "离得远的人，怎么赶来？"
    },
    {
      "id": "ch02_s20_hanyuan.l15",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "得给路费，也得留时日。"
    },
    {
      "id": "ch02_s20_hanyuan.l16",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "这笔钱从哪儿出？"
    },
    {
      "id": "ch02_s20_hanyuan.l17",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "还要人手收外地寄来的卷子。查得完，日子就得放长。"
    },
    {
      "id": "ch02_s20_hanyuan.l18",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "联署仍靠旧门第的人情；自己来答问，也得来得起。"
    },
    {
      "id": "ch02_s20_hanyuan.l19",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "来得起。"
    },
    {
      "id": "ch02_s20_hanyuan.l20",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "能等得起的人，又先坐到了案前。"
    },
    {
      "id": "ch02_s20_hanyuan.l21",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这些拦住人的难处，一并写上，别藏着。"
    },
    {
      "id": "ch02_s20_hanyuan.l22",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "宗室有旧供给可接，我仍主张先试任。"
    },
    {
      "id": "ch02_s20_hanyuan.l23",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你仍领宗室的供给。"
    },
    {
      "id": "ch02_s20_hanyuan.l24",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "钱从哪里来，谁没领到，也给我们看。"
    },
    {
      "id": "ch02_s20_hanyuan.l25",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "看，你经办的，也得照这个问。"
    },
    {
      "id": "ch02_s20_hanyuan.l26",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch02_s20_hanyuan.l27",
      "who": "narr",
      "kind": "aside",
      "text": "她把自家的支出册推到案中，没有递到你手边私看。"
    },
    {
      "id": "ch02_s20_hanyuan.l28",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "不能拿兵马替人举荐。有亲近往来、钱财牵连，都得说清。"
    },
    {
      "id": "ch02_s20_hanyuan.l29",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "两法都收反对的话。候选的人反对，也不能压着。"
    },
    {
      "id": "ch02_s20_hanyuan.l30",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "都收。"
    },
    {
      "id": "ch02_s20_hanyuan.l31",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我擅用阿荻的话，也要列。她的私话，不跟着卷子发。"
    },
    {
      "id": "ch02_s20_hanyuan.l32",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "先选怎么收，再说清要花多少、谁来办。"
    },
    {
      "id": "ch02_s20_hanyuan.l33",
      "who": "narr",
      "kind": "aside",
      "text": "两张拟条都没有落你的名，笔搁在正中。"
    },
    {
      "id": "ch02_s20_hanyuan.l34",
      "who": "narr",
      "kind": "aside",
      "text": "你拿起拟条之间的笔，准备署下试办之法。"
    }
  ],
  "choices": [
    {
      "id": "ch02_s20_hanyuan.cA",
      "text": "三处联署，列清避嫌与申辩办法",
      "effects": {
        "shi": 1,
        "flag.nomination_joint_review": true
      },
      "irreversible": false,
      "goto": "ch02_s21_nvguan"
    },
    {
      "id": "ch02_s20_hanyuan.cB",
      "text": "限期自行答问，列清路费与日期",
      "effects": {
        "ming": 1,
        "flag.nomination_open_questions": true
      },
      "irreversible": false,
      "goto": "ch02_s21_nvguan"
    }
  ]
}
