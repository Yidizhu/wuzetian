{
  "id": "ch02_s20_hanyuan",
  "chapter": 2,
  "act": 2,
  "scene": "hanyuan",
  "palette": "gold",
  "cast": [
    "wuze",
    "shenheng",
    "liqinghe",
    "hetaihou",
    "tangjian"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "比较两种非宗室提名办法，承担各自的门槛与成本",
  "lines": [
    {
      "id": "ch02_s20_hanyuan.l1",
      "who": "narr",
      "kind": "aside",
      "text": "你的手又停在含元殿的两份拟条之间。"
    },
    {
      "id": "ch02_s20_hanyuan.l2",
      "who": "narr",
      "kind": "aside",
      "text": "又过数日，两份拟条放在同一案上，留着一样宽的页边。"
    },
    {
      "id": "ch02_s20_hanyuan.l3",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "奉准试收材料，入候选册仍得等新条颁行。"
    },
    {
      "id": "ch02_s20_hanyuan.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "试收。"
    },
    {
      "id": "ch02_s20_hanyuan.l5",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "今日只议谁能受荐，别当作已经得了哪一席。"
    },
    {
      "id": "ch02_s20_hanyuan.l6",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "只许宗姓这行，先改掉。"
    },
    {
      "id": "ch02_s20_hanyuan.l7",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "改掉以后，谁来核荐书？"
    },
    {
      "id": "ch02_s20_hanyuan.l8",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "谁核……"
    },
    {
      "id": "ch02_s20_hanyuan.l9",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "甲法由三处联署，核履历与经办，各答所知。"
    },
    {
      "id": "ch02_s20_hanyuan.l10",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "找不到三处的，还是进不来。"
    },
    {
      "id": "ch02_s20_hanyuan.l11",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "是，不能写成人人都进来了。"
    },
    {
      "id": "ch02_s20_hanyuan.l12",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s20_hanyuan.l13",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "乙法限期试问，先收自呈，还得核实做过的事。"
    },
    {
      "id": "ch02_s20_hanyuan.l14",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "路远的——"
    },
    {
      "id": "ch02_s20_hanyuan.l15",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "得留旅费。"
    },
    {
      "id": "ch02_s20_hanyuan.l16",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "旅费。"
    },
    {
      "id": "ch02_s20_hanyuan.l17",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "还有寄卷人手，评期也长。"
    },
    {
      "id": "ch02_s20_hanyuan.l18",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "联署能结成旧门第的荐网；试问也得来得起。"
    },
    {
      "id": "ch02_s20_hanyuan.l19",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "来得起。"
    },
    {
      "id": "ch02_s20_hanyuan.l20",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "等得起的人，还会先占案前。"
    },
    {
      "id": "ch02_s20_hanyuan.l21",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "门槛都写出来，别只写不问宗姓。"
    },
    {
      "id": "ch02_s20_hanyuan.l22",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "宗室有旧供给可接，我仍主张先试任。"
    },
    {
      "id": "ch02_s20_hanyuan.l23",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "旧供给。"
    },
    {
      "id": "ch02_s20_hanyuan.l24",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "钱从哪来，谁没分到，也给我们看。"
    },
    {
      "id": "ch02_s20_hanyuan.l25",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "看，你经办的，也得照这个问。"
    },
    {
      "id": "ch02_s20_hanyuan.l26",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch02_s20_hanyuan.l27",
      "who": "narr",
      "kind": "aside",
      "text": "她把自家的支出册推到案中，没有递到你手边私看。"
    },
    {
      "id": "ch02_s20_hanyuan.l28",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "不得以兵代荐，往来利害各自申明。"
    },
    {
      "id": "ch02_s20_hanyuan.l29",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "两法都留异议，候选人反对的话也收。"
    },
    {
      "id": "ch02_s20_hanyuan.l30",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "都收。"
    },
    {
      "id": "ch02_s20_hanyuan.l31",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我的擅引也列，阿荻私话别随卷发。"
    },
    {
      "id": "ch02_s20_hanyuan.l32",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "先选试哪一法，再写清花多少钱、用谁的人手。"
    },
    {
      "id": "ch02_s20_hanyuan.l33",
      "who": "narr",
      "kind": "aside",
      "text": "两张拟条都没有落你的名，笔搁在正中。"
    },
    {
      "id": "ch02_s20_hanyuan.l34",
      "who": "narr",
      "kind": "aside",
      "text": "你拿起拟条之间的笔，准备署下试办之法。"
    }
  ],
  "choices": [
    {
      "id": "ch02_s20_hanyuan.cA",
      "text": "试联署核验，列回避与申辩",
      "effects": {
        "shi": 1,
        "flag.nomination_joint_review": true
      },
      "irreversible": false,
      "goto": "ch02_s21_nvguan"
    },
    {
      "id": "ch02_s20_hanyuan.cB",
      "text": "试限期问策，列旅费与评期",
      "effects": {
        "ming": 1,
        "flag.nomination_open_questions": true
      },
      "irreversible": false,
      "goto": "ch02_s21_nvguan"
    }
  ]
}
