{
  "id": "ch02_s06_yeting",
  "chapter": 2,
  "act": 2,
  "scene": "yeting",
  "palette": "ink",
  "cast": [
    "wuze",
    "adi",
    "songhuizhen",
    "tangjian"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "核准九件实际给付，辞出与欠款不再相互扣住",
  "lines": [
    {
      "id": "ch02_s06_yeting.l1",
      "who": "narr",
      "kind": "aside",
      "text": "唐简将两张窄纸摊开，铜钱隔着布囊碰了一声。"
    },
    {
      "id": "ch02_s06_yeting.l2",
      "when": {
        "flag.adi_verify_now": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "早上逐项认过，九件无误。"
    },
    {
      "id": "ch02_s06_yeting.l3",
      "when": {
        "flag.adi_verify_later": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "午后这一班我挪来了。先听我念。"
    },
    {
      "id": "ch02_s06_yeting.l4",
      "when": {
        "flag.adi_verify_later": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "她逐项念，阿荻改了一处日期，再听一遍才认。"
    },
    {
      "id": "ch02_s06_yeting.l5",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "九件，核准。另两件找各自的做工人。"
    },
    {
      "id": "ch02_s06_yeting.l6",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "这张是领钱的，那张呢？"
    },
    {
      "id": "ch02_s06_yeting.l7",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "辞出持凭。欠款还归你，不必住在这里等。"
    },
    {
      "id": "ch02_s06_yeting.l8",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "我今日还没说要走。"
    },
    {
      "id": "ch02_s06_yeting.l9",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "先给你。何日用，你自己定。"
    },
    {
      "id": "ch02_s06_yeting.l10",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "走了以后，上哪儿领？"
    },
    {
      "id": "ch02_s06_yeting.l11",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "西库留一联，我这里留一联，照纸上日期来领，不再叫她找原班人。"
    },
    {
      "id": "ch02_s06_yeting.l12",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我还须补什么？"
    },
    {
      "id": "ch02_s06_yeting.l13",
      "who": "adi",
      "expr": "guarded",
      "kind": "say",
      "text": "补你那张，不要往我的上面补。"
    },
    {
      "id": "ch02_s06_yeting.l14",
      "who": "narr",
      "kind": "aside",
      "text": "你把自己的认责纸往身前挪了挪。"
    },
    {
      "id": "ch02_s06_yeting.l15",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "旧项的款今日只到了六件，余三件要再催。"
    },
    {
      "id": "ch02_s06_yeting.l16",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "别说又等一道手续。哪一日？"
    },
    {
      "id": "ch02_s06_yeting.l17",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "今夜回报；不到，明晨由我持凭去问。"
    },
    {
      "id": "ch02_s06_yeting.l18",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "还有可暂垫的么？"
    },
    {
      "id": "ch02_s06_yeting.l19",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "东廊补栏的款已准暂支。栏未坏，只是旧，垫了钱便下旬再刷。"
    },
    {
      "id": "ch02_s06_yeting.l20",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "病舍饭药不动？"
    },
    {
      "id": "ch02_s06_yeting.l21",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "不动。两样都已准，等选哪一项。"
    },
    {
      "id": "ch02_s06_yeting.l22",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "今夜领三件也可。六件先给我，我数过再认，不在空纸上先署名。"
    },
    {
      "id": "ch02_s06_yeting.l23",
      "who": "narr",
      "kind": "aside",
      "text": "她解开布囊。宋移近碗托，让铜钱不滚到席缝里。"
    },
    {
      "id": "ch02_s06_yeting.l24",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "补栏的人也须早些知道，别让她们白来。"
    },
    {
      "id": "ch02_s06_yeting.l25",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "垫付就今日告知；催原项，就另记催款工时。"
    }
  ],
  "choices": [
    {
      "id": "ch02_s06_yeting.cA",
      "text": "暂垫补栏款，今日付清",
      "effects": {
        "shi": 1,
        "flag.adi_pay_advance": true
      },
      "irreversible": false,
      "goto": "ch02_s07_yuanye"
    },
    {
      "id": "ch02_s06_yeting.cB",
      "text": "先付六件，余款催原项",
      "effects": {
        "ming": 1,
        "flag.adi_pay_original": true
      },
      "irreversible": false,
      "goto": "ch02_s07_yuanye"
    }
  ]
}
