{
  "id": "ch02_s22_shuge",
  "chapter": 2,
  "act": 2,
  "scene": "shuge",
  "palette": "gold",
  "cast": [
    "wuze",
    "shenheng",
    "liqinghe",
    "tangjian",
    "wenqiao"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "留反对与经办缺口；温面对未被原谅，也主动约主角",
  "lines": [
    {
      "id": "ch02_s22_shuge.l1",
      "who": "narr",
      "kind": "aside",
      "text": "朱绳还在柳手里，你回书阁看批注。"
    },
    {
      "id": "ch02_s22_shuge.l2",
      "who": "narr",
      "kind": "aside",
      "text": "次日，案上多了来回批注。温荞把两摞抄件分开放稳。"
    },
    {
      "id": "ch02_s22_shuge.l3",
      "when": {
        "flag.nomination_joint_review": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "三处各核所知，有利害的另列，不准代核。"
    },
    {
      "id": "ch02_s22_shuge.l4",
      "when": {
        "flag.nomination_joint_review": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "代核不准。"
    },
    {
      "id": "ch02_s22_shuge.l5",
      "when": {
        "flag.nomination_joint_review": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "没荐署的申辩另收，眼下进不来，也照记。"
    },
    {
      "id": "ch02_s22_shuge.l6",
      "when": {
        "flag.nomination_open_questions": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "自呈已收，寄卷旅费从试办款支，延评十日。"
    },
    {
      "id": "ch02_s22_shuge.l7",
      "when": {
        "flag.nomination_open_questions": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "十日。"
    },
    {
      "id": "ch02_s22_shuge.l8",
      "when": {
        "flag.nomination_open_questions": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "补助未及所有远处，没受助的数也附上。"
    },
    {
      "id": "ch02_s22_shuge.l9",
      "when": {
        "flag.nvguan_halfday_pay": true
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "按半日付过，空余时辰也付，不扣许的俸。"
    },
    {
      "id": "ch02_s22_shuge.l10",
      "when": {
        "flag.nvguan_halfday_pay": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "空余也付。"
    },
    {
      "id": "ch02_s22_shuge.l11",
      "when": {
        "flag.nvguan_trip_pay": true
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "按次付过，另付记脚程的人手，不叫观里贴。"
    },
    {
      "id": "ch02_s22_shuge.l12",
      "when": {
        "flag.nvguan_trip_pay": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "另付了。"
    },
    {
      "id": "ch02_s22_shuge.l13",
      "when": {
        "flag.adi_pay_advance": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "原款已归垫项，刷栏仍在下旬，不催人抢回。"
    },
    {
      "id": "ch02_s22_shuge.l14",
      "when": {
        "flag.adi_pay_advance": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "照旧约。"
    },
    {
      "id": "ch02_s22_shuge.l15",
      "when": {
        "flag.adi_pay_original": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "阿荻已领催回的三件款，催款脚程也核过。"
    },
    {
      "id": "ch02_s22_shuge.l16",
      "when": {
        "flag.adi_pay_original": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "核过了。"
    },
    {
      "id": "ch02_s22_shuge.l17",
      "when": {
        "flag.letter_keep_sealed": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "原笺限阅，保管与查阅均列，只核公务摘录。"
    },
    {
      "id": "ch02_s22_shuge.l18",
      "when": {
        "flag.letter_keep_sealed": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "只核摘录。"
    },
    {
      "id": "ch02_s22_shuge.l19",
      "when": {
        "flag.letter_return_private": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "私笺退了，另请双方核认摘录，多一轮也记。"
    },
    {
      "id": "ch02_s22_shuge.l20",
      "when": {
        "flag.letter_return_private": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "多一轮。"
    },
    {
      "id": "ch02_s22_shuge.l21",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "反对两法的呢？"
    },
    {
      "id": "ch02_s22_shuge.l22",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "末册，拟只存底。"
    },
    {
      "id": "ch02_s22_shuge.l23",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "只存底？"
    },
    {
      "id": "ch02_s22_shuge.l24",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "一同送。"
    },
    {
      "id": "ch02_s22_shuge.l25",
      "who": "tangjian",
      "expr": "guarded",
      "kind": "say",
      "text": "一同？"
    },
    {
      "id": "ch02_s22_shuge.l26",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "不能让作决定的人，只听我们说可行。"
    },
    {
      "id": "ch02_s22_shuge.l27",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "宗室的缺口也送，我可没改成赞同你。"
    },
    {
      "id": "ch02_s22_shuge.l28",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "知道。"
    },
    {
      "id": "ch02_s22_shuge.l29",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我的擅引记在哪？"
    },
    {
      "id": "ch02_s22_shuge.l30",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "履历过失栏，改正了多少，另写多少。"
    },
    {
      "id": "ch02_s22_shuge.l31",
      "who": "narr",
      "kind": "aside",
      "text": "唐简写下受理人、复核日与答复期限，四人分别核过。"
    },
    {
      "id": "ch02_s22_shuge.l32",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "少一页，等我取。"
    },
    {
      "id": "ch02_s22_shuge.l33",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "等你。"
    },
    {
      "id": "ch02_s22_shuge.l34",
      "who": "narr",
      "kind": "aside",
      "text": "她从袖中摸出一张退回的短笺，认清以后，又塞回去。"
    },
    {
      "id": "ch02_s22_shuge.l35",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "她退来的？"
    },
    {
      "id": "ch02_s22_shuge.l36",
      "who": "wenqiao",
      "expr": "guarded",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch02_s22_shuge.l37",
      "who": "wenqiao",
      "expr": "guarded",
      "kind": "say",
      "text": "稿收了，别的不要。"
    },
    {
      "id": "ch02_s22_shuge.l38",
      "who": "wenqiao",
      "expr": "guarded",
      "kind": "say",
      "text": "歉话删了又写，连自己的字都认不出了。"
    },
    {
      "id": "ch02_s22_shuge.l39",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s22_shuge.l40",
      "who": "wenqiao",
      "expr": "guarded",
      "kind": "say",
      "text": "还是无处送，她不欠我一个收处。"
    },
    {
      "id": "ch02_s22_shuge.l41",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那就再——"
    },
    {
      "id": "ch02_s22_shuge.l42",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "不送。"
    },
    {
      "id": "ch02_s22_shuge.l43",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s22_shuge.l44",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "留着也嫌它吵，先放抽屉。"
    },
    {
      "id": "ch02_s22_shuge.l45",
      "who": "narr",
      "kind": "aside",
      "text": "她找到缺的公页交给唐简，退笺仍在自己袖中。"
    },
    {
      "id": "ch02_s22_shuge.l46",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "往门边站一点。"
    },
    {
      "id": "ch02_s22_shuge.l47",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "挡光了？"
    },
    {
      "id": "ch02_s22_shuge.l48",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "没有。"
    },
    {
      "id": "ch02_s22_shuge.l49",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "收完最后一摞，我想一抬头就看见你。"
    },
    {
      "id": "ch02_s22_shuge.l50",
      "who": "self",
      "kind": "inner",
      "text": "（我还在找她指的那道光。她说的是我。）"
    },
    {
      "id": "ch02_s22_shuge.l51",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "愿意就等，不愿也……"
    },
    {
      "id": "ch02_s22_shuge.l52",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你说。"
    },
    {
      "id": "ch02_s22_shuge.l53",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "别替我送退笺，我自己收。"
    },
    {
      "id": "ch02_s22_shuge.l54",
      "who": "narr",
      "kind": "aside",
      "text": "她抱起最后一摞纸，留下门边一人宽的空处。"
    },
    {
      "id": "ch02_s22_shuge.l55",
      "when": {
        "flag.chenghuan_accept_1": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "柳昨夜誊完送来，你的半日用来备齐了稿。"
    },
    {
      "id": "ch02_s22_shuge.l56",
      "when": {
        "flag.chenghuan_accept_1": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s22_shuge.l57",
      "when": {
        "flag.chenghuan_accept_1": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "她的缺试另记，不能从这里抹。"
    },
    {
      "id": "ch02_s22_shuge.l58",
      "when": {
        "flag.chenghuan_refuse_1": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "昨夜你自己誊，备稿延了半日，今日照延时收。"
    },
    {
      "id": "ch02_s22_shuge.l59",
      "when": {
        "flag.chenghuan_refuse_1": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "照延时。"
    },
    {
      "id": "ch02_s22_shuge.l60",
      "who": "narr",
      "kind": "aside",
      "text": "唐简把昨夜做过与今日待做的工时分开记下。"
    }
  ],
  "choices": [
    {
      "id": "ch02_s22_shuge.cA",
      "text": "我在门边等你",
      "effects": {},
      "irreversible": false,
      "goto": "ch02_s23_hanyuan"
    },
    {
      "id": "ch02_s22_shuge.cB",
      "text": "今日先走，你慢慢收",
      "effects": {},
      "irreversible": false,
      "goto": "ch02_s23_hanyuan"
    }
  ]
}
