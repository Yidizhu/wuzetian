{
  "id": "ch02_s22_shuge",
  "chapter": 2,
  "act": 2,
  "scene": "shuge",
  "palette": "gold",
  "cast": [
    "wuze",
    "shenheng",
    "liqinghe",
    "tangjian",
    "wenqiao"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "留反对与经办缺口；温面对未被原谅，也主动约主角",
  "lines": [
    {
      "id": "ch02_s22_shuge.l1",
      "who": "narr",
      "kind": "aside",
      "text": "朱绳还在柳手里，你回书阁看批注。"
    },
    {
      "id": "ch02_s22_shuge.l2",
      "who": "narr",
      "kind": "aside",
      "text": "次日，案上多了来回批注。温荞把两摞抄件分开放稳。"
    },
    {
      "id": "ch02_s22_shuge.l3",
      "when": {
        "flag.nomination_joint_review": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "三处各查自己知道的。亲近牵连另列，不能一处替另两处作保。"
    },
    {
      "id": "ch02_s22_shuge.l4",
      "when": {
        "flag.nomination_joint_review": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "代核不准。"
    },
    {
      "id": "ch02_s22_shuge.l5",
      "when": {
        "flag.nomination_joint_review": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "找不到官署肯荐的人，仍能申辩；但眼下确实还进不来。"
    },
    {
      "id": "ch02_s22_shuge.l6",
      "when": {
        "flag.nomination_open_questions": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "自己呈来的卷收了，寄卷和路费从试办的钱里出，评卷延后十日。"
    },
    {
      "id": "ch02_s22_shuge.l7",
      "when": {
        "flag.nomination_open_questions": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "十日。"
    },
    {
      "id": "ch02_s22_shuge.l8",
      "when": {
        "flag.nomination_open_questions": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "远来的人没能个个接济到，这一点也要报。"
    },
    {
      "id": "ch02_s22_shuge.l9",
      "when": {
        "flag.nvguan_halfday_pay": true
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "按半日付了。她空等的那段，也在这半日里。"
    },
    {
      "id": "ch02_s22_shuge.l10",
      "when": {
        "flag.nvguan_halfday_pay": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "空余也付。"
    },
    {
      "id": "ch02_s22_shuge.l11",
      "when": {
        "flag.nvguan_trip_pay": true
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "按次付过了。另请人记往返时辰的钱，也另付，没叫观里垫。"
    },
    {
      "id": "ch02_s22_shuge.l12",
      "when": {
        "flag.nvguan_trip_pay": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "另付了。"
    },
    {
      "id": "ch02_s22_shuge.l13",
      "when": {
        "flag.adi_pay_advance": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "原来欠款的钱已拨回，垫修栏的补上了。刷栏仍在下旬。"
    },
    {
      "id": "ch02_s22_shuge.l14",
      "when": {
        "flag.adi_pay_advance": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "既然答应了，就别再往后拖。"
    },
    {
      "id": "ch02_s22_shuge.l15",
      "when": {
        "flag.adi_pay_original": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "阿荻领到了余下三件的钱。催款来回的路，也查过了。"
    },
    {
      "id": "ch02_s22_shuge.l16",
      "when": {
        "flag.adi_pay_original": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "核过了。"
    },
    {
      "id": "ch02_s22_shuge.l17",
      "when": {
        "flag.letter_keep_sealed": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "整封限人查阅，谁保管、谁看过都记了。这里只查公务摘录。"
    },
    {
      "id": "ch02_s22_shuge.l18",
      "when": {
        "flag.letter_keep_sealed": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "只核摘录。"
    },
    {
      "id": "ch02_s22_shuge.l19",
      "when": {
        "flag.letter_return_private": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "双方对过公务摘录，私信退回了。往后要查，得再跑一趟。"
    },
    {
      "id": "ch02_s22_shuge.l20",
      "when": {
        "flag.letter_return_private": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "多一轮。"
    },
    {
      "id": "ch02_s22_shuge.l21",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "反对这两种办法的话，放在哪儿？"
    },
    {
      "id": "ch02_s22_shuge.l22",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "原拟抄到末册，留在署里。"
    },
    {
      "id": "ch02_s22_shuge.l23",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "只留底，不发给要作决定的人？"
    },
    {
      "id": "ch02_s22_shuge.l24",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "也送去，让她们看到。"
    },
    {
      "id": "ch02_s22_shuge.l25",
      "who": "tangjian",
      "expr": "guarded",
      "kind": "say",
      "text": "反对的话同样送？"
    },
    {
      "id": "ch02_s22_shuge.l26",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "是。不能送到案前的全是赞同。"
    },
    {
      "id": "ch02_s22_shuge.l27",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "宗室的缺口也送，我可没改成赞同你。"
    },
    {
      "id": "ch02_s22_shuge.l28",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "知道。"
    },
    {
      "id": "ch02_s22_shuge.l29",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我擅用阿荻私话的事，列在哪儿？"
    },
    {
      "id": "ch02_s22_shuge.l30",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "你过去的过失一栏。后来如何改正，另写，不能抵掉。"
    },
    {
      "id": "ch02_s22_shuge.l31",
      "who": "narr",
      "kind": "aside",
      "text": "唐写下谁收、哪日复查、几日内答复，四人各自对了一遍。"
    },
    {
      "id": "ch02_s22_shuge.l32",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "少一页，等我取。"
    },
    {
      "id": "ch02_s22_shuge.l33",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "等你。"
    },
    {
      "id": "ch02_s22_shuge.l34",
      "who": "narr",
      "kind": "aside",
      "text": "她从袖中摸出一张退回的短笺，认清以后，又塞回去。"
    },
    {
      "id": "ch02_s22_shuge.l35",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "她退来的？"
    },
    {
      "id": "ch02_s22_shuge.l36",
      "who": "wenqiao",
      "expr": "guarded",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch02_s22_shuge.l37",
      "who": "wenqiao",
      "expr": "guarded",
      "kind": "say",
      "text": "稿收了，别的不要。"
    },
    {
      "id": "ch02_s22_shuge.l38",
      "who": "wenqiao",
      "expr": "guarded",
      "kind": "say",
      "text": "歉话删了又写，连自己的字都认不出了。"
    },
    {
      "id": "ch02_s22_shuge.l39",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s22_shuge.l40",
      "who": "wenqiao",
      "expr": "guarded",
      "kind": "say",
      "text": "还是无处送，她不欠我一个收处。"
    },
    {
      "id": "ch02_s22_shuge.l41",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那就再——"
    },
    {
      "id": "ch02_s22_shuge.l42",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "不送。"
    },
    {
      "id": "ch02_s22_shuge.l43",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s22_shuge.l44",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "留着也嫌它吵，先放抽屉。"
    },
    {
      "id": "ch02_s22_shuge.l45",
      "who": "narr",
      "kind": "aside",
      "text": "她找到缺的公页交给唐简，退笺仍在自己袖中。"
    },
    {
      "id": "ch02_s22_shuge.l46",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "往门边站一点。"
    },
    {
      "id": "ch02_s22_shuge.l47",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "挡光了？"
    },
    {
      "id": "ch02_s22_shuge.l48",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "没有。"
    },
    {
      "id": "ch02_s22_shuge.l49",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "收完最后一摞，我想一抬头就看见你。"
    },
    {
      "id": "ch02_s22_shuge.l50",
      "who": "self",
      "kind": "inner",
      "text": "（我还在找她指的那道光。她说的是我。）"
    },
    {
      "id": "ch02_s22_shuge.l51",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "愿意就等，不愿也……"
    },
    {
      "id": "ch02_s22_shuge.l52",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你说。"
    },
    {
      "id": "ch02_s22_shuge.l53",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "别替我送退笺，我自己收。"
    },
    {
      "id": "ch02_s22_shuge.l54",
      "who": "narr",
      "kind": "aside",
      "text": "她抱起最后一摞纸，留下门边一人宽的空处。",
      "image": "e39_ch02_s22_l54"
    },
    {
      "id": "ch02_s22_shuge.l55",
      "when": {
        "flag.chenghuan_accept_1": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "承欢留下誊写，省了我半日。"
    },
    {
      "id": "ch02_s22_shuge.l56",
      "when": {
        "flag.chenghuan_accept_1": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch02_s22_shuge.l57",
      "when": {
        "flag.chenghuan_accept_1": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "她为此误了自己的考试，也记下了。"
    },
    {
      "id": "ch02_s22_shuge.l58",
      "when": {
        "flag.chenghuan_refuse_1": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "你自己誊写，多花半日。收稿也给你顺延了半日。"
    },
    {
      "id": "ch02_s22_shuge.l59",
      "when": {
        "flag.chenghuan_refuse_1": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那就按这个时辰交。"
    },
    {
      "id": "ch02_s22_shuge.l60",
      "who": "narr",
      "kind": "aside",
      "text": "唐简把昨夜做过与今日待做的工时分开记下。"
    }
  ],
  "choices": [
    {
      "id": "ch02_s22_shuge.cA",
      "text": "我在门边等你",
      "effects": {},
      "irreversible": false,
      "goto": "ch02_s23_hanyuan"
    },
    {
      "id": "ch02_s22_shuge.cB",
      "text": "今日先走，你慢慢收",
      "effects": {},
      "irreversible": false,
      "goto": "ch02_s23_hanyuan"
    }
  ]
}
