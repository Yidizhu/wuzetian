{
  "id": "ch03_s14_shuge",
  "chapter": 3,
  "act": 3,
  "scene": "shuge",
  "palette": "gold",
  "cast": [
    "wuze",
    "tangjian",
    "songhuizhen",
    "shenheng",
    "peizhaoye"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "兑现沈裴的合作边界，结工与交班各有接手，不以换身份两清",
  "lines": [
    {
      "id": "ch03_s14_shuge.l1",
      "who": "narr",
      "kind": "aside",
      "text": "扶过包袱的手空下来，你又去书阁查交班的事。"
    },
    {
      "id": "ch03_s14_shuge.l2",
      "who": "narr",
      "kind": "aside",
      "text": "裴从近营回来交凭据，靴边泥已干。宋搁下空匣，抖出一小片断竹签。"
    },
    {
      "id": "ch03_s14_shuge.l3",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "卷有人接了，欠的钱付了，才能签交清。"
    },
    {
      "id": "ch03_s14_shuge.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "没到手的，就还不能算完。"
    },
    {
      "id": "ch03_s14_shuge.l5",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "不能只交空匣。"
    },
    {
      "id": "ch03_s14_shuge.l6",
      "when": {
        "flag.enthroned": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "旧卷交回原署。我换了新印，也不能盖住原来谁署的名。"
    },
    {
      "id": "ch03_s14_shuge.l7",
      "when": {
        "flag.declined_crown": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "辞受的手续完了，今日交剩下的差事。重新推选的卷，不再经我。"
    },
    {
      "id": "ch03_s14_shuge.l8",
      "when": {
        "flag.liqinghe_won": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我的提案留着接着补，受托查的卷交回去，两样分开收。"
    },
    {
      "id": "ch03_s14_shuge.l9",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "撤我差事的文书，有回话了吗？"
    },
    {
      "id": "ch03_s14_shuge.l10",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "有，带给你了。"
    },
    {
      "id": "ch03_s14_shuge.l11",
      "who": "narr",
      "kind": "aside",
      "text": "你递过问撤差理由的回话，没有替沈改掉反对的话。"
    },
    {
      "id": "ch03_s14_shuge.l12",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "原署收下了重议的请求，请了别署的人来查。"
    },
    {
      "id": "ch03_s14_shuge.l13",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s14_shuge.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "旧差没当场还你，也没说你改口。"
    },
    {
      "id": "ch03_s14_shuge.l15",
      "who": "shenheng",
      "expr": "guarded",
      "kind": "say",
      "text": "写了谁负责，那先这样。"
    },
    {
      "id": "ch03_s14_shuge.l16",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch03_s14_shuge.l17",
      "when": {
        "flag.shen_ch03_sit": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "那日坐下，我以为你又要辩。"
    },
    {
      "id": "ch03_s14_shuge.l18",
      "when": {
        "flag.shen_ch03_sit": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "辩？"
    },
    {
      "id": "ch03_s14_shuge.l19",
      "when": {
        "flag.shen_ch03_sit": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "后来光移过去，真就只坐着。"
    },
    {
      "id": "ch03_s14_shuge.l20",
      "when": {
        "flag.shen_ch03_sit": true
      },
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "你的凳子有一角硌人。我换了两回脚。"
    },
    {
      "id": "ch03_s14_shuge.l21",
      "when": {
        "flag.shen_ch03_leave": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "那日你先走，也把文书带去问了。"
    },
    {
      "id": "ch03_s14_shuge.l22",
      "when": {
        "flag.shen_ch03_leave": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s14_shuge.l23",
      "when": {
        "flag.shen_ch03_leave": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "这份不用拿多坐一会儿换。"
    },
    {
      "id": "ch03_s14_shuge.l24",
      "when": {
        "flag.shen_ch03_leave": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我答应去问，就得去问。"
    },
    {
      "id": "ch03_s14_shuge.l25",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "名册带来了，没加军职。营里的人仍照常点卯。"
    },
    {
      "id": "ch03_s14_shuge.l26",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "给我看看。"
    },
    {
      "id": "ch03_s14_shuge.l27",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "没人被改作私下跟随你。"
    },
    {
      "id": "ch03_s14_shuge.l28",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "送回值守人。往后请你——"
    },
    {
      "id": "ch03_s14_shuge.l29",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "不能把他整班算上。"
    },
    {
      "id": "ch03_s14_shuge.l30",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "是。"
    },
    {
      "id": "ch03_s14_shuge.l31",
      "who": "peizhaoye",
      "expr": "open",
      "kind": "say",
      "text": "今日交完凭据，还有半日归我自己。"
    },
    {
      "id": "ch03_s14_shuge.l32",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "那半日不另派给你差事。"
    },
    {
      "id": "ch03_s14_shuge.l33",
      "who": "narr",
      "kind": "aside",
      "text": "宋把已带过两回班的凭据翻开。两名接班人各按了一枚印，第三栏仍空着。"
    },
    {
      "id": "ch03_s14_shuge.l34",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "两回就是两回。第三格……先空着。"
    },
    {
      "id": "ch03_s14_shuge.l35",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "第三回得另找人。"
    },
    {
      "id": "ch03_s14_shuge.l36",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "先问谁肯接，饭钱也说清。"
    },
    {
      "id": "ch03_s14_shuge.l37",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "原署另雇了，工价在背面，只签你做过的。"
    },
    {
      "id": "ch03_s14_shuge.l38",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch03_s14_shuge.l39",
      "when": {
        "flag.chenghuan_accept_2": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "柳值的三夜另查。补休和结清工钱的凭据，我亲手给她。"
    },
    {
      "id": "ch03_s14_shuge.l40",
      "when": {
        "flag.chenghuan_accept_2": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "交到她自己手里。"
    },
    {
      "id": "ch03_s14_shuge.l41",
      "when": {
        "flag.chenghuan_refuse_2": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "代班工钱清了，我花的半日也记了。她不欠我那三夜。"
    },
    {
      "id": "ch03_s14_shuge.l42",
      "when": {
        "flag.chenghuan_refuse_2": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "这一笔已结清。"
    },
    {
      "id": "ch03_s14_shuge.l43",
      "when": {
        "flag.chenghuan_accept_3": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "更正写好了，连你准许只列自己的话一起存，旧本不撤。"
    },
    {
      "id": "ch03_s14_shuge.l44",
      "when": {
        "flag.chenghuan_refuse_3": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "原来就并列她的名，不必补第二回。照原本给她报功的凭据。"
    },
    {
      "id": "ch03_s14_shuge.l45",
      "who": "narr",
      "kind": "aside",
      "text": "裴折好自己的凭据，沈取走撤差的回话。案上压在你名下的纸少了两份。"
    },
    {
      "id": "ch03_s14_shuge.l46",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "查完的今日签交清。归她自己的，亲手给她再说。"
    },
    {
      "id": "ch03_s14_shuge.l47",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch03_s14_shuge.l48",
      "who": "narr",
      "kind": "aside",
      "text": "你收好查完的纸，拿起要交给柳的凭据。"
    }
  ],
  "choices": [
    {
      "id": "ch03_s14_shuge.cA",
      "text": "签明交清，带走柳的凭据",
      "effects": {
        "affinity.shenheng": 3,
        "affinity.peizhaoye": 3
      },
      "irreversible": true,
      "goto": "ch03_s15_yeting"
    }
  ]
}
