{
  "id": "ch03_s12_hanyuan",
  "chapter": 3,
  "act": 3,
  "scene": "hanyuan",
  "palette": "gold",
  "cast": [
    "wuze",
    "liqinghe",
    "shenheng",
    "tangjian",
    "hetaihou"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "将答受、辞受或李获授分别落实为已完成的身份事实",
  "lines": [
    {
      "id": "ch03_s12_hanyuan.l1",
      "who": "narr",
      "kind": "aside",
      "text": "提案仍在手边，殿前两张席先撤了下去。"
    },
    {
      "id": "ch03_s12_hanyuan.l2",
      "who": "narr",
      "kind": "aside",
      "text": "殿前的席撤去两张，三席签过的原卷仍在案上。唐将新抄的受辞记录逐字核回。"
    },
    {
      "id": "ch03_s12_hanyuan.l3",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "口中答辞已录，与原议分别存留。"
    },
    {
      "id": "ch03_s12_hanyuan.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "分别存。"
    },
    {
      "id": "ch03_s12_hanyuan.l5",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "后来的交接，不能改先前胜负。"
    },
    {
      "id": "ch03_s12_hanyuan.l6",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "旧差、欠款都须另有接手，换位置账仍在。"
    },
    {
      "id": "ch03_s12_hanyuan.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "旧账……我会交。"
    },
    {
      "id": "ch03_s12_hanyuan.l8",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "旧账。"
    },
    {
      "id": "ch03_s12_hanyuan.l9",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "一项项——"
    },
    {
      "id": "ch03_s12_hanyuan.l10",
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "不要漏。"
    },
    {
      "id": "ch03_s12_hanyuan.l11",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "是。"
    },
    {
      "id": "ch03_s12_hanyuan.l12",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "试衣时，女史捧来赭黄，候你点头。旁边还搁着一匹绯。"
    },
    {
      "id": "ch03_s12_hanyuan.l13",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "绯。"
    },
    {
      "id": "ch03_s12_hanyuan.l14",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "三日后，你站到新席前，低头看见绯衣垂在阶上。"
    },
    {
      "id": "ch03_s12_hanyuan.l15",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "cg",
      "kind": "aside",
      "text": "wuze_shouwei"
    },
    {
      "id": "ch03_s12_hanyuan.l16",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "self",
      "kind": "inner",
      "text": "（先抬手。别让袖口压住。）"
    },
    {
      "id": "ch03_s12_hanyuan.l17",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "你的手臂抬在绯衣里，袖口的重量比试衣时沉。"
    },
    {
      "id": "ch03_s12_hanyuan.l18",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "制书按原名写妥，异议副本随交接卷送入。"
    },
    {
      "id": "ch03_s12_hanyuan.l19",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "异议。"
    },
    {
      "id": "ch03_s12_hanyuan.l20",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "不附在贺词里。"
    },
    {
      "id": "ch03_s12_hanyuan.l21",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "有说我不堪任的，也留着？"
    },
    {
      "id": "ch03_s12_hanyuan.l22",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "shenheng",
      "expr": "guarded",
      "kind": "say",
      "text": "有。"
    },
    {
      "id": "ch03_s12_hanyuan.l23",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "先放在我看得见的地方。"
    },
    {
      "id": "ch03_s12_hanyuan.l24",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch03_s12_hanyuan.l25",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "女皇起身，将印绶亲交到你手中。你行礼受下，转向阶下，群臣依次成礼。"
    },
    {
      "id": "ch03_s12_hanyuan.l26",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "{名}受位，礼成。"
    },
    {
      "id": "ch03_s12_hanyuan.l27",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "你坐下时，膝上的织纹绷直了。有人依新称谓呈卷，你伸出手，卷尾碰到袖缘。"
    },
    {
      "id": "ch03_s12_hanyuan.l28",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "两处照常轮值，撤未准扩办前我还来辩。"
    },
    {
      "id": "ch03_s12_hanyuan.l29",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "来。"
    },
    {
      "id": "ch03_s12_hanyuan.l30",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "先前的理由也带来。"
    },
    {
      "id": "ch03_s12_hanyuan.l31",
      "when": {
        "flag.ch03_accept_offer": true
      },
      "who": "self",
      "kind": "inner",
      "text": "（礼已经完了。我还在等下一声鼓。）"
    },
    {
      "id": "ch03_s12_hanyuan.l32",
      "when": {
        "flag.ch03_decline_offer": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "你将辞受牒摊开，末行仍是亲口答过的不受。唐把授位制书另收，没有撕去。"
    },
    {
      "id": "ch03_s12_hanyuan.l33",
      "when": {
        "flag.ch03_decline_offer": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "辞受奉准，两件同存，不能说未曾获授。"
    },
    {
      "id": "ch03_s12_hanyuan.l34",
      "when": {
        "flag.ch03_decline_offer": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "同存。"
    },
    {
      "id": "ch03_s12_hanyuan.l35",
      "when": {
        "flag.ch03_decline_offer": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "重推不用再等。我经手的卷交给谁？"
    },
    {
      "id": "ch03_s12_hanyuan.l36",
      "when": {
        "flag.ch03_decline_offer": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "原署收，三席重开荐期，陛下续理政务。"
    },
    {
      "id": "ch03_s12_hanyuan.l37",
      "when": {
        "flag.ch03_decline_offer": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "原署。"
    },
    {
      "id": "ch03_s12_hanyuan.l38",
      "when": {
        "flag.ch03_decline_offer": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "另定授位前不空位。"
    },
    {
      "id": "ch03_s12_hanyuan.l39",
      "when": {
        "flag.ch03_decline_offer": true
      },
      "who": "hetaihou",
      "expr": "default",
      "kind": "say",
      "text": "重推令今日发，李仍可参议，不能私拨给她。"
    },
    {
      "id": "ch03_s12_hanyuan.l40",
      "when": {
        "flag.ch03_decline_offer": true
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "我还递自己的案，不拿你的辞受添支持。"
    },
    {
      "id": "ch03_s12_hanyuan.l41",
      "when": {
        "flag.ch03_decline_offer": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch03_s12_hanyuan.l42",
      "when": {
        "flag.ch03_decline_offer": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "唐核完目录，署下收讫。你解下候选差牌，看着它落进匣里。"
    },
    {
      "id": "ch03_s12_hanyuan.l43",
      "when": {
        "flag.ch03_decline_offer": true
      },
      "who": "cg",
      "kind": "aside",
      "text": "wuze_juwei"
    },
    {
      "id": "ch03_s12_hanyuan.l44",
      "when": {
        "flag.ch03_decline_offer": true
      },
      "who": "self",
      "kind": "inner",
      "text": "（腰上少了一块。手还往挂牌的地方去。）"
    },
    {
      "id": "ch03_s12_hanyuan.l45",
      "when": {
        "flag.ch03_decline_offer": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "钱款还要亲交，收牌不算两清。"
    },
    {
      "id": "ch03_s12_hanyuan.l46",
      "when": {
        "flag.ch03_decline_offer": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "余项已另列单，照单续交。"
    },
    {
      "id": "ch03_s12_hanyuan.l47",
      "when": {
        "flag.ch03_decline_offer": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "另单。"
    },
    {
      "id": "ch03_s12_hanyuan.l48",
      "when": {
        "flag.ch03_offer_li": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "三日后的受位礼，你站在阶下。李令仪的衣袖垂到印绶前，她先向女皇行礼。"
    },
    {
      "id": "ch03_s12_hanyuan.l49",
      "when": {
        "flag.ch03_offer_li": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "女皇亲交印绶。李双手接住，依仪登席，阶下朝礼成列。"
    },
    {
      "id": "ch03_s12_hanyuan.l50",
      "when": {
        "flag.ch03_offer_li": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "李令仪受位，礼成。"
    },
    {
      "id": "ch03_s12_hanyuan.l51",
      "when": {
        "flag.ch03_offer_li": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "你跟着行完这一礼。起身时，提案的硬角硌着手掌。你把它换到另一只手。"
    },
    {
      "id": "ch03_s12_hanyuan.l52",
      "when": {
        "flag.ch03_offer_li": true
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "扩办案留议次，我仍要问{名}钱从哪出。"
    },
    {
      "id": "ch03_s12_hanyuan.l53",
      "when": {
        "flag.ch03_offer_li": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "钱从哪出。"
    },
    {
      "id": "ch03_s12_hanyuan.l54",
      "when": {
        "flag.ch03_offer_li": true
      },
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "我重算，不撤。"
    },
    {
      "id": "ch03_s12_hanyuan.l55",
      "when": {
        "flag.ch03_offer_li": true
      },
      "who": "liqinghe",
      "expr": "guarded",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch03_s12_hanyuan.l56",
      "when": {
        "flag.ch03_offer_li": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "照实记未获授位，原案续补，不写退让。"
    },
    {
      "id": "ch03_s12_hanyuan.l57",
      "when": {
        "flag.ch03_offer_li": true
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "也别写我劝她留下，后面的差须另问。"
    },
    {
      "id": "ch03_s12_hanyuan.l58",
      "when": {
        "flag.ch03_offer_li": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "另问。"
    },
    {
      "id": "ch03_s12_hanyuan.l59",
      "when": {
        "flag.ch03_offer_li": true
      },
      "who": "self",
      "kind": "inner",
      "text": "（她坐到那里了。我还得走下这几级阶。）"
    },
    {
      "id": "ch03_s12_hanyuan.l60",
      "who": "narr",
      "kind": "aside",
      "text": "午光穿过殿门，照到那块垫案脚的薄木片。案上的水碗仍旧放得平。"
    },
    {
      "id": "ch03_s12_hanyuan.l61",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "胜负落字了，那夜照实争的话没收回。"
    },
    {
      "id": "ch03_s12_hanyuan.l62",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我也没有。往后的话，往后亲口问。"
    },
    {
      "id": "ch03_s12_hanyuan.l63",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s12_hanyuan.l64",
      "who": "narr",
      "kind": "aside",
      "text": "你收好受辞存件，准备去交旧差。"
    }
  ],
  "dressing": "shouwei",
  "choices": [
    {
      "id": "ch03_s12_hanyuan.cA",
      "text": "收下新卷，去交清旧差",
      "require": {
        "flag.ch03_accept_offer": true
      },
      "effects": {
        "affinity.liqinghe": 3,
        "flag.enthroned": true,
        "flag.declined_crown": false,
        "flag.liqinghe_won": false
      },
      "irreversible": false,
      "goto": "ch03_s13_yeting"
    },
    {
      "id": "ch03_s12_hanyuan.cB",
      "text": "辞受已办，去交清余项",
      "require": {
        "flag.ch03_decline_offer": true
      },
      "effects": {
        "affinity.liqinghe": 3,
        "flag.declined_crown": true,
        "flag.enthroned": false,
        "flag.liqinghe_won": false
      },
      "irreversible": false,
      "goto": "ch03_s13_yeting"
    },
    {
      "id": "ch03_s12_hanyuan.cC",
      "text": "收好提案，去交清旧差",
      "require": {
        "flag.ch03_offer_li": true
      },
      "effects": {
        "affinity.liqinghe": 3,
        "flag.liqinghe_won": true,
        "flag.enthroned": false,
        "flag.declined_crown": false
      },
      "irreversible": false,
      "goto": "ch03_s13_yeting"
    }
  ]
}
