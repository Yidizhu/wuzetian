{
  "id": "ch03_s13_yeting",
  "chapter": 3,
  "act": 3,
  "scene": "yeting",
  "palette": "ink",
  "cast": [
    "wuze",
    "adi",
    "songhuizhen"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "阿荻自己选定去处，主角只归还证据，不索要谅解",
  "lines": [
    {
      "id": "ch03_s13_yeting.l1",
      "who": "narr",
      "kind": "aside",
      "text": "你收好殿上答话的存件，回掖庭看阿荻收针包。"
    },
    {
      "id": "ch03_s13_yeting.l2",
      "who": "narr",
      "kind": "aside",
      "text": "阿荻将针插进卷好的布里，数完又抽出一根。宋坐在窗下，替她拈掉包袱上的线头。"
    },
    {
      "id": "ch03_s13_yeting.l3",
      "when": {
        "flag.enthroned": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "受位礼后，你换过衣才来。门边有人要通报，阿荻正在咬断线，叫人等一等。"
    },
    {
      "id": "ch03_s13_yeting.l4",
      "when": {
        "flag.declined_crown": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "辞受那日，你从署里径直过来。阿荻看见空着的腰带，仍先将那根针收好。"
    },
    {
      "id": "ch03_s13_yeting.l5",
      "when": {
        "flag.liqinghe_won": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "李受位礼后，你把提案留在住处才来。阿荻腾出小凳，上头有一块未缝的布。"
    },
    {
      "id": "ch03_s13_yeting.l6",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那根不要了？"
    },
    {
      "id": "ch03_s13_yeting.l7",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "宋姐姐的，要还。"
    },
    {
      "id": "ch03_s13_yeting.l8",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "宋姐姐的。"
    },
    {
      "id": "ch03_s13_yeting.l9",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "包里还有一根。"
    },
    {
      "id": "ch03_s13_yeting.l10",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s13_yeting.l11",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "别叫我下次追到坊门口拿，我懒得绕。"
    },
    {
      "id": "ch03_s13_yeting.l12",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你找好了？"
    },
    {
      "id": "ch03_s13_yeting.l13",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s13_yeting.l14",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "坊里绣作，先做一月。"
    },
    {
      "id": "ch03_s13_yeting.l15",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "一月。"
    },
    {
      "id": "ch03_s13_yeting.l16",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "工钱、床位都问过。试缝自己送的。"
    },
    {
      "id": "ch03_s13_yeting.l17",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "何时走？"
    },
    {
      "id": "ch03_s13_yeting.l18",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "这旬白班交完。"
    },
    {
      "id": "ch03_s13_yeting.l19",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那还有这一旬的差要交。"
    },
    {
      "id": "ch03_s13_yeting.l20",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那铺——"
    },
    {
      "id": "ch03_s13_yeting.l21",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "别提前收。"
    },
    {
      "id": "ch03_s13_yeting.l22",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "外头办文书的人没催我搬。"
    },
    {
      "id": "ch03_s13_yeting.l23",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch03_s13_yeting.l24",
      "who": "narr",
      "kind": "aside",
      "text": "你把各处收到更正的凭据放在凳上。阿荻没伸手，先问是哪份。"
    },
    {
      "id": "ch03_s13_yeting.l25",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "九件的钱领足了。这是各处更正的回话，没抄你的私话。"
    },
    {
      "id": "ch03_s13_yeting.l26",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "改了什么，念给我听。"
    },
    {
      "id": "ch03_s13_yeting.l27",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "慢些，我听着。"
    },
    {
      "id": "ch03_s13_yeting.l28",
      "who": "narr",
      "kind": "aside",
      "text": "你念到擅用私话由你担责。阿荻压平桌边翻卷的布，让你接着念。"
    },
    {
      "id": "ch03_s13_yeting.l29",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "下面列着哪些地方收到了更正。"
    },
    {
      "id": "ch03_s13_yeting.l30",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s13_yeting.l31",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你可留一份，也可另找人，查我改得对不对。"
    },
    {
      "id": "ch03_s13_yeting.l32",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "我要留。"
    },
    {
      "id": "ch03_s13_yeting.l33",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch03_s13_yeting.l34",
      "who": "self",
      "kind": "inner",
      "text": "（她收了。下一句……别问。）"
    },
    {
      "id": "ch03_s13_yeting.l35",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "纸放布里，针另包，戳破又得抄。"
    },
    {
      "id": "ch03_s13_yeting.l36",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "针另包。"
    },
    {
      "id": "ch03_s13_yeting.l37",
      "who": "narr",
      "kind": "aside",
      "text": "阿荻取出第二根借来的针，递到宋掌心。你扶住要滑下凳面的布，没有替她打结。"
    },
    {
      "id": "ch03_s13_yeting.l38",
      "who": "adi",
      "expr": "open",
      "kind": "say",
      "text": "对，就扶那里。还没包完。"
    }
  ],
  "goto": "ch03_s14_shuge"
}
