{
  "id": "ch03_s03_yeting",
  "chapter": 3,
  "act": 3,
  "scene": "yeting",
  "palette": "ink",
  "cast": [
    "wuze",
    "liuchenghuan",
    "tangjian"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "柳取消自己的休假代答三夜，主角在知情后选择是否使用",
  "lines": [
    {
      "id": "ch03_s03_yeting.l1",
      "when": {
        "flag.shen_ch03_sit": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "方才你和沈坐到斜影越过桌角。她没有翻那卷，你也没有再辩。"
    },
    {
      "id": "ch03_s03_yeting.l2",
      "when": {
        "flag.shen_ch03_leave": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "方才沈将撤差牒交到你手里，只送到门边。你下了阶，她便回屋收卷。"
    },
    {
      "id": "ch03_s03_yeting.l3",
      "who": "narr",
      "kind": "aside",
      "text": "柳从热水里提出布巾，晾在盆沿。朱绳束着一叠排好的夜班单。"
    },
    {
      "id": "ch03_s03_yeting.l4",
      "who": "liuchenghuan",
      "expr": "open",
      "kind": "say",
      "text": "干的一头留给你。"
    },
    {
      "id": "ch03_s03_yeting.l5",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s03_yeting.l6",
      "who": "liuchenghuan",
      "expr": "open",
      "kind": "say",
      "text": "擦完就歇。今夜的数对过了。"
    },
    {
      "id": "ch03_s03_yeting.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "你今晚不是休？"
    },
    {
      "id": "ch03_s03_yeting.l8",
      "who": "liuchenghuan",
      "expr": "default",
      "kind": "say",
      "text": "改到后头也一样。"
    },
    {
      "id": "ch03_s03_yeting.l9",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "原来准你的休假，挪掉了？"
    },
    {
      "id": "ch03_s03_yeting.l10",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "她答应连值三夜，每日一班，没超一日的限数。"
    },
    {
      "id": "ch03_s03_yeting.l11",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "三夜——"
    },
    {
      "id": "ch03_s03_yeting.l12",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "可原来准的三日休，划掉了。"
    },
    {
      "id": "ch03_s03_yeting.l13",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch03_s03_yeting.l14",
      "who": "narr",
      "kind": "aside",
      "text": "唐把休假凭据从班单下面抽出来，三格空白对着你。"
    },
    {
      "id": "ch03_s03_yeting.l15",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "休假要去哪儿？"
    },
    {
      "id": "ch03_s03_yeting.l16",
      "who": "liuchenghuan",
      "expr": "open",
      "kind": "say",
      "text": "你在这里，还去哪里。"
    },
    {
      "id": "ch03_s03_yeting.l17",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "不必写去处。"
    },
    {
      "id": "ch03_s03_yeting.l18",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "是。"
    },
    {
      "id": "ch03_s03_yeting.l19",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "她不接这三班，就另雇两人。工钱从备议的钱里出。"
    },
    {
      "id": "ch03_s03_yeting.l20",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "能补齐？"
    },
    {
      "id": "ch03_s03_yeting.l21",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "人手找到了。"
    },
    {
      "id": "ch03_s03_yeting.l22",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "两人都报了要多少工钱。"
    },
    {
      "id": "ch03_s03_yeting.l23",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s03_yeting.l24",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "你还得花半日交旧卷，教她们认你改过的记号。"
    },
    {
      "id": "ch03_s03_yeting.l25",
      "who": "liuchenghuan",
      "expr": "default",
      "kind": "say",
      "text": "那半日……留给你。"
    },
    {
      "id": "ch03_s03_yeting.l26",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "连重新教人的半日，你也想替我省。"
    },
    {
      "id": "ch03_s03_yeting.l27",
      "who": "liuchenghuan",
      "expr": "default",
      "kind": "say",
      "text": "这几册改过哪笔，我都认得。"
    },
    {
      "id": "ch03_s03_yeting.l28",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "换别人，我又得从头教。"
    },
    {
      "id": "ch03_s03_yeting.l29",
      "who": "self",
      "kind": "inner",
      "text": "（我确实不想再教一遍。三夜，连那半日也能拿去备议。）"
    },
    {
      "id": "ch03_s03_yeting.l30",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "三日休是你让出来的，不能写成本就该你值班。"
    },
    {
      "id": "ch03_s03_yeting.l31",
      "who": "liuchenghuan",
      "expr": "open",
      "kind": "say",
      "text": "写你觉得妥当的就好。"
    },
    {
      "id": "ch03_s03_yeting.l32",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch03_s03_yeting.l33",
      "who": "narr",
      "kind": "aside",
      "text": "她把温布巾递来。你掌心还冻着，握住后没有马上松开。"
    },
    {
      "id": "ch03_s03_yeting.l34",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "接了你的三日休，我省钱，也多出备议时辰。"
    },
    {
      "id": "ch03_s03_yeting.l35",
      "who": "liuchenghuan",
      "expr": "default",
      "kind": "say",
      "text": "你要的就是我要的。"
    },
    {
      "id": "ch03_s03_yeting.l36",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "承欢。"
    },
    {
      "id": "ch03_s03_yeting.l37",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "原来准休的凭据留下。代了几班照实写，那三日休不能抹掉。"
    },
    {
      "id": "ch03_s03_yeting.l38",
      "who": "narr",
      "kind": "aside",
      "text": "布巾上的热气散了。柳仍托着盆，等你擦另一只手。"
    }
  ],
  "choices": [
    {
      "id": "ch03_s03_yeting.cA",
      "text": "接下三夜，记清她原有的休假",
      "effects": {
        "shi": 1,
        "xin": -1,
        "flag.chenghuan_accept_2": true
      },
      "irreversible": false,
      "goto": "ch03_s04_yuanye"
    },
    {
      "id": "ch03_s03_yeting.cB",
      "text": "请另两人代班，我付钱并交班",
      "effects": {
        "flag.chenghuan_refuse_2": true
      },
      "irreversible": false,
      "goto": "ch03_s04_yuanye"
    }
  ]
}
