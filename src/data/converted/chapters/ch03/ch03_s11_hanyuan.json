        "flag.ch03_plan_budget": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "两处轮值已开，{名}新代递缓了。"
    },
    {
      "id": "ch03_s11_hanyuan.l52",
      "when": {
        "flag.ch03_plan_full": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "可及项支持李令仪。"
    },
    {
      "id": "ch03_s11_hanyuan.l53",
      "when": {
        "flag.ch03_plan_full": true
      },
      "who": "liqinghe",
