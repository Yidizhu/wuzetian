      "id": "ch03_s11_hanyuan.l48",
      "when": {
        "flag.ch03_plan_access": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "代递收了首件，李案远处代递尚未开。"
    },
