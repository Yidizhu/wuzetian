      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "财政。"
    },
    {
      "id": "ch03_s11_hanyuan.l41",
      "when": {
        "flag.ch03_plan_full": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "两处能续，{名}的六处现款开不了。"
    },
    {
      "id": "ch03_s11_hanyuan.l42",
      "who": "narr",
      "kind": "aside",
      "text": "别署录事取出昨日收件的回执。上面的掌印有一枚压得歪，已经当面补认。"
    },
    {
      "id": "ch03_s11_hanyuan.l43",
      "when": {
        "flag.ch03_plan_pair": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "可及项支持{名}。"
    },
    {
      "id": "ch03_s11_hanyuan.l44",
      "when": {
        "flag.ch03_plan_pair": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "可及项。"
    },
    {
      "id": "ch03_s11_hanyuan.l45",
      "when": {
        "flag.ch03_plan_pair": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "两处能自递、代递，李案仍止于轮值。"
    },
    {
      "id": "ch03_s11_hanyuan.l46",
      "when": {
        "flag.ch03_plan_access": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "可及项支持{名}。"
    },
    {
      "id": "ch03_s11_hanyuan.l47",
      "when": {
        "flag.ch03_plan_access": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
