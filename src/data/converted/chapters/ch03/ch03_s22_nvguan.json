{
  "id": "ch03_s22_nvguan",
  "chapter": 3,
  "act": 3,
  "scene": "nvguan",
  "palette": "ink",
  "cast": [
    "wuze",
    "xujinghe",
    "wenqiao"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "观中的三回教读已照自己的约定办过，主角只能付自己的那份",
  "lines": [
    {
      "id": "ch03_s22_nvguan.l1",
      "who": "narr",
      "kind": "aside",
      "text": "回到观中侧屋，你把手边的矮凳让开。"
    },
    {
      "id": "ch03_s22_nvguan.l2",
      "who": "narr",
      "kind": "aside",
      "text": "观中侧屋还没收桌。温端起半盆洗笔水，许把挡路的矮凳拖到墙边。"
    },
    {
      "id": "ch03_s22_nvguan.l3",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "替我开着门。"
    },
    {
      "id": "ch03_s22_nvguan.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s22_nvguan.l5",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "泼上门槛，明日又问哪来黑脚印。"
    },
    {
      "id": "ch03_s22_nvguan.l6",
      "who": "narr",
      "kind": "aside",
      "text": "你抵住门，看她把水端出去。桌上三张练字纸叠着，各有一行名字。"
    },
    {
      "id": "ch03_s22_nvguan.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "三回都上过了？"
    },
    {
      "id": "ch03_s22_nvguan.l8",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "两人，三回。药屋照旧，没添桌。"
    },
    {
      "id": "ch03_s22_nvguan.l9",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "三回。"
    },
    {
      "id": "ch03_s22_nvguan.l10",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "初回认名字，末回肯写了，歪的也自己拿走。"
    },
    {
      "id": "ch03_s22_nvguan.l11",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "自己拿走。"
    },
    {
      "id": "ch03_s22_nvguan.l12",
      "when": {
        "flag.ch03_consider_school": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "先看课怎么开，今日不领人来占屋。"
    },
    {
      "id": "ch03_s22_nvguan.l13",
      "when": {
        "flag.ch03_consider_road": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "路晚些另问，这几张纸先留住我了。"
    },
    {
      "id": "ch03_s22_nvguan.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "还缺什么？"
    },
    {
      "id": "ch03_s22_nvguan.l15",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "嗯……"
    },
    {
      "id": "ch03_s22_nvguan.l16",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "下回的纸。老师另约，不能再替她填三回。"
    },
    {
      "id": "ch03_s22_nvguan.l17",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "新槽还没钱做，这两日回纸坊。"
    },
    {
      "id": "ch03_s22_nvguan.l18",
      "who": "narr",
      "kind": "aside",
      "text": "记忆里，温荞在纸槽前抬起竹帘，水从帘角滴下。"
    },
    {
      "id": "ch03_s22_nvguan.l19",
      "who": "cg",
      "kind": "aside",
      "text": "wenqiao_1_chaozhi"
    },
    {
      "id": "ch03_s22_nvguan.l20",
      "who": "self",
      "kind": "inner",
      "text": "（那双手还得浸水。我却先来问她哪天有空。）"
    },
    {
      "id": "ch03_s22_nvguan.l21",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "纸坊。"
    },
    {
      "id": "ch03_s22_nvguan.l22",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "你要开课，别照抄我的空日子。"
    },
    {
      "id": "ch03_s22_nvguan.l23",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch03_s22_nvguan.l24",
      "when": {
        "flag.enthroned": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "宫里新课另议，今日不拿我的名添凳子。"
    },
    {
      "id": "ch03_s22_nvguan.l25",
      "when": {
        "flag.declined_crown": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不用留间屋，等我领一件大事。"
    },
    {
      "id": "ch03_s22_nvguan.l26",
      "when": {
        "flag.liqinghe_won": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "真办就另找人，不能连师生一起搬。"
    },
    {
      "id": "ch03_s22_nvguan.l27",
      "who": "narr",
      "kind": "aside",
      "text": "温回屋时，盆底还沾着黑水。她把盆倒扣在石上，甩甩发凉的手。"
    },
    {
      "id": "ch03_s22_nvguan.l28",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我自己买……一刀纸。"
    },
    {
      "id": "ch03_s22_nvguan.l29",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "一刀？"
    },
    {
      "id": "ch03_s22_nvguan.l30",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "够这两人下回——"
    },
    {
      "id": "ch03_s22_nvguan.l31",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "够纸。"
    },
    {
      "id": "ch03_s22_nvguan.l32",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "够纸。"
    },
    {
      "id": "ch03_s22_nvguan.l33",
      "who": "xujinghe",
      "expr": "default",
      "kind": "say",
      "text": "不能替她们答下回都来。"
    },
    {
      "id": "ch03_s22_nvguan.l34",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "是。"
    },
    {
      "id": "ch03_s22_nvguan.l35",
      "who": "wenqiao",
      "expr": "default",
      "kind": "say",
      "text": "要题你的名字么？"
    },
    {
      "id": "ch03_s22_nvguan.l36",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "记付纸钱的人，别题在他们写的那面。"
    },
    {
      "id": "ch03_s22_nvguan.l37",
      "who": "wenqiao",
      "expr": "open",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch03_s22_nvguan.l38",
      "who": "narr",
      "kind": "aside",
      "text": "许将纸价写在小账边，旁边留着学字人下回来不来的空格。"
    },
    {
      "id": "ch03_s22_nvguan.l39",
      "who": "narr",
      "kind": "aside",
      "text": "你付下自己买纸的钱，把收据收进袖里。"
    }
  ],
  "choices": [
    {
      "id": "ch03_s22_nvguan.cA",
      "text": "按价买纸，下回另问她们",
      "effects": {},
      "irreversible": false,
      "goto": "ch03_s23_yeting"
    }
  ]
}
