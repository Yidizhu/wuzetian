{
  "id": "ch03_s06_shuge",
  "chapter": 3,
  "act": 3,
  "scene": "shuge",
  "palette": "gold",
  "cast": [
    "wuze",
    "liuchenghuan",
    "tangjian"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "主角第三次面对柳主动让出的实绩署名，接受者须知道自己得了什么",
  "lines": [
    {
      "id": "ch03_s06_shuge.l1",
      "when": {
        "flag.wen_ch03_sing": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "昨夜你错入了一拍，温跟着错了半句。到第三遍，你们才一同收住尾音。",
      "image": "e39_ch03_s06_l1"
    },
    {
      "id": "ch03_s06_shuge.l2",
      "when": {
        "flag.wen_ch03_leave": true
      },
      "who": "narr",
      "kind": "aside",
      "text": "昨夜你走出巷口，合唱才起。温没有追出来，低音从开着的窗里送出。"
    },
    {
      "id": "ch03_s06_shuge.l3",
      "who": "narr",
      "kind": "aside",
      "text": "三夜过后，柳抱来一册清单。晨光照到她袖口，墨干成了硬边。"
    },
    {
      "id": "ch03_s06_shuge.l4",
      "when": {
        "flag.chenghuan_accept_2": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "三夜的卷她都查了。原来的休假凭据留着，省的工钱还在账上。"
    },
    {
      "id": "ch03_s06_shuge.l5",
      "when": {
        "flag.chenghuan_accept_2": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不能说她没损失什么。"
    },
    {
      "id": "ch03_s06_shuge.l6",
      "when": {
        "flag.chenghuan_refuse_2": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "另雇两人的钱付了。你花了半日交班，她休满三日。"
    },
    {
      "id": "ch03_s06_shuge.l7",
      "when": {
        "flag.chenghuan_refuse_2": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这三日没再叫她回来吧。"
    },
    {
      "id": "ch03_s06_shuge.l8",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这一册是新核的？"
    },
    {
      "id": "ch03_s06_shuge.l9",
      "who": "liuchenghuan",
      "expr": "open",
      "kind": "say",
      "text": "交班单前核的。"
    },
    {
      "id": "ch03_s06_shuge.l10",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s06_shuge.l11",
      "who": "liuchenghuan",
      "expr": "open",
      "kind": "say",
      "text": "两份履历抄重了。我找过本人，已经分开。"
    },
    {
      "id": "ch03_s06_shuge.l12",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "底簿有她和本人的署名，可对外的简录只写了你。"
    },
    {
      "id": "ch03_s06_shuge.l13",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "只有我？"
    },
    {
      "id": "ch03_s06_shuge.l14",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "谁让删的？"
    },
    {
      "id": "ch03_s06_shuge.l15",
      "who": "liuchenghuan",
      "expr": "default",
      "kind": "say",
      "text": "你上去答，写你就够了。"
    },
    {
      "id": "ch03_s06_shuge.l16",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch03_s06_shuge.l17",
      "who": "narr",
      "kind": "aside",
      "text": "柳翻到被订住的内页，指尖压着自己的经手签。公开的摘要上没有这一行。"
    },
    {
      "id": "ch03_s06_shuge.l18",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "只写我，人家会以为错处是我找出来的。"
    },
    {
      "id": "ch03_s06_shuge.l19",
      "who": "liuchenghuan",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch03_s06_shuge.l20",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "往后你凭什么报自己做过的事？"
    },
    {
      "id": "ch03_s06_shuge.l21",
      "who": "liuchenghuan",
      "expr": "open",
      "kind": "say",
      "text": "到时你记得就好。"
    },
    {
      "id": "ch03_s06_shuge.l22",
      "who": "wuze",
      "expr": "open",
      "kind": "say",
      "text": "只有我记得，不够。"
    },
    {
      "id": "ch03_s06_shuge.l23",
      "who": "tangjian",
      "expr": "guarded",
      "kind": "say",
      "text": "简录还没送。可以照她的意思，只记你总管此事。"
    },
    {
      "id": "ch03_s06_shuge.l24",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "那就——"
    },
    {
      "id": "ch03_s06_shuge.l25",
      "who": "tangjian",
      "expr": "guarded",
      "kind": "say",
      "text": "但底簿上谁做的，不能改。"
    },
    {
      "id": "ch03_s06_shuge.l26",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "她在底簿的名字要留着。"
    },
    {
      "id": "ch03_s06_shuge.l27",
      "who": "tangjian",
      "expr": "guarded",
      "kind": "say",
      "text": "也不能说无人经手。"
    },
    {
      "id": "ch03_s06_shuge.l28",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "是。"
    },
    {
      "id": "ch03_s06_shuge.l29",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "简录不写她，她往后报功怎么办？"
    },
    {
      "id": "ch03_s06_shuge.l30",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "就得再调底簿来证明，多等一轮。"
    },
    {
      "id": "ch03_s06_shuge.l31",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "报功还得多等这一轮。"
    },
    {
      "id": "ch03_s06_shuge.l32",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "现在把她也写上，她拿这份简录就能去报，不必再等。"
    },
    {
      "id": "ch03_s06_shuge.l33",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch03_s06_shuge.l34",
      "who": "self",
      "kind": "inner",
      "text": "（一册看下来，全是我的经办。我想把它直接合上。）"
    },
    {
      "id": "ch03_s06_shuge.l35",
      "who": "liuchenghuan",
      "expr": "default",
      "kind": "say",
      "text": "你若觉得……就不用另问了。"
    },
    {
      "id": "ch03_s06_shuge.l36",
      "who": "wuze",
      "expr": "guarded",
      "kind": "say",
      "text": "我知道是你做的。收下也不能说不知道。"
    },
    {
      "id": "ch03_s06_shuge.l37",
      "who": "liuchenghuan",
      "expr": "guarded",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch03_s06_shuge.l38",
      "who": "liuchenghuan",
      "expr": "open",
      "kind": "say",
      "text": "知道就够了。"
    },
    {
      "id": "ch03_s06_shuge.l39",
      "who": "narr",
      "kind": "aside",
      "text": "唐搁下一支笔。柳将笔尖朝向你，自己退到朱绳束着的旧稿旁。"
    },
    {
      "id": "ch03_s06_shuge.l40",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "你总管、她查出错处，可以并列。但不能说这两处是你亲自查的。"
    },
    {
      "id": "ch03_s06_shuge.l41",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "都写清楚，是哪两处。"
    },
    {
      "id": "ch03_s06_shuge.l42",
      "who": "narr",
      "kind": "aside",
      "text": "你把写着她姓名的凭据，摆到总管一栏旁，等着署名。"
    }
  ],
  "choices": [
    {
      "id": "ch03_s06_shuge.cA",
      "text": "简录只列我，底簿留她的名",
      "effects": {
        "shi": 1,
        "xin": -1,
        "flag.chenghuan_accept_3": true
      },
      "irreversible": true,
      "goto": "ch03_s07_yeting"
    },
    {
      "id": "ch03_s06_shuge.cB",
      "text": "并列她做的事，我只署总管",
      "effects": {
        "flag.chenghuan_refuse_3": true
      },
      "irreversible": true,
      "goto": "ch03_s07_yeting"
    }
  ]
}
