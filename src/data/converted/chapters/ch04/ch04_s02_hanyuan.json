{
  "id": "ch04_s02_hanyuan",
  "chapter": 4,
  "act": 4,
  "scene": "hanyuan",
  "palette": "gold",
  "cast": [
    "wuze",
    "liqinghe",
    "shenheng",
    "tangjian",
    "songhuizhen"
  ],
  "weightless": false,
  "leavesLetter": [],
  "purpose": "受理结契照料来件，并选择自己异议的存处",
  "lines": [
    {
      "id": "ch04_s02_hanyuan.l1",
      "who": "narr",
      "kind": "aside",
      "text": "笔收好后，你沿龙尾道走到含元殿。"
    },
    {
      "id": "ch04_s02_hanyuan.l2",
      "who": "narr",
      "kind": "aside",
      "text": "龙尾道的风吹到殿门，远处入席的脚步一声比一声散。"
    },
    {
      "id": "ch04_s02_hanyuan.l3",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "病人写明要谁来照料，病舍却不认那张凭据，耽误了一回取药。"
    },
    {
      "id": "ch04_s02_hanyuan.l4",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "药已经迟了一回。"
    },
    {
      "id": "ch04_s02_hanyuan.l5",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "人现在还在门外？"
    },
    {
      "id": "ch04_s02_hanyuan.l6",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "在，两边有人守着，没叫她独等。"
    },
    {
      "id": "ch04_s02_hanyuan.l7",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch04_s02_hanyuan.l8",
      "who": "narr",
      "kind": "aside",
      "text": "观议席有人说：“结契的妇人招来虹气。”"
    },
    {
      "id": "ch04_s02_hanyuan.l9",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "今晚那服药，谁递给她？"
    },
    {
      "id": "ch04_s02_hanyuan.l10",
      "who": "narr",
      "kind": "aside",
      "text": "唐简用手压住来件，纸角在风里拍了两下。"
    },
    {
      "id": "ch04_s02_hanyuan.l11",
      "when": {
        "ming": {
          "gte": 6
        }
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "你说过先看清等多久，登记等几日也照实写。"
    },
    {
      "id": "ch04_s02_hanyuan.l12",
      "when": {
        "ming": {
          "gte": 6
        }
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "别只写准了，却还让人空等。"
    },
    {
      "id": "ch04_s02_hanyuan.l13",
      "when": {
        "ming": {
          "lt": 6
        }
      },
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "登记要等几日？谁来办，也写上，别只说准了。"
    },
    {
      "id": "ch04_s02_hanyuan.l14",
      "when": {
        "ming": {
          "lt": 6
        }
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "谁办这件，先写清楚。"
    },
    {
      "id": "ch04_s02_hanyuan.l15",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "先照病者签的凭送药。"
    },
    {
      "id": "ch04_s02_hanyuan.l16",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "先查她指定照料人的那张凭据。"
    },
    {
      "id": "ch04_s02_hanyuan.l17",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "新法……另议，不能让今晚的人等。"
    },
    {
      "id": "ch04_s02_hanyuan.l18",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "原来就准代领，可以凭旧例查办。先送药，另把经过报上来。"
    },
    {
      "id": "ch04_s02_hanyuan.l19",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "先办。"
    },
    {
      "id": "ch04_s02_hanyuan.l20",
      "when": {
        "flag.enthroned": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "还有一份反对你新署用人的话。"
    },
    {
      "id": "ch04_s02_hanyuan.l21",
      "when": {
        "flag.enthroned": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "拿来，我——"
    },
    {
      "id": "ch04_s02_hanyuan.l22",
      "when": {
        "flag.enthroned": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "先看她问的。"
    },
    {
      "id": "ch04_s02_hanyuan.l23",
      "when": {
        "flag.enthroned": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "把她原来怎么问的给我看。"
    },
    {
      "id": "ch04_s02_hanyuan.l24",
      "when": {
        "flag.enthroned": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "她问：换了官职名字，是不是仍只有你身边的人能过问。"
    },
    {
      "id": "ch04_s02_hanyuan.l25",
      "when": {
        "flag.enthroned": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch04_s02_hanyuan.l26",
      "when": {
        "flag.enthroned": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "有人提议，只登你的答复，把她反对的话另收起来。"
    },
    {
      "id": "ch04_s02_hanyuan.l27",
      "when": {
        "flag.enthroned": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "只看答复，不知她问过什么。"
    },
    {
      "id": "ch04_s02_hanyuan.l28",
      "when": {
        "flag.enthroned": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "是。"
    },
    {
      "id": "ch04_s02_hanyuan.l29",
      "when": {
        "flag.enthroned": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "一起存，就得逐条答。三日答不完，要明记延期。"
    },
    {
      "id": "ch04_s02_hanyuan.l30",
      "when": {
        "flag.enthroned": true
      },
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "反对的话移出去，只另收原稿，后来翻议录的人就不知道她问过什么。"
    },
    {
      "id": "ch04_s02_hanyuan.l31",
      "when": {
        "flag.enthroned": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "也看不出我到底有没有答。"
    },
    {
      "id": "ch04_s02_hanyuan.l32",
      "when": {
        "flag.declined_crown": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "你交的是自己的意见，不能替如今在位的人作批复。"
    },
    {
      "id": "ch04_s02_hanyuan.l33",
      "when": {
        "flag.declined_crown": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我再——"
    },
    {
      "id": "ch04_s02_hanyuan.l34",
      "when": {
        "flag.declined_crown": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "先把你自己的话说清楚。"
    },
    {
      "id": "ch04_s02_hanyuan.l35",
      "when": {
        "flag.declined_crown": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch04_s02_hanyuan.l36",
      "when": {
        "flag.liqinghe_won": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "你反对的照收，署你的名。李令仪怎么答，另列。"
    },
    {
      "id": "ch04_s02_hanyuan.l37",
      "when": {
        "flag.liqinghe_won": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我的——"
    },
    {
      "id": "ch04_s02_hanyuan.l38",
      "when": {
        "flag.liqinghe_won": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "也一样收。"
    },
    {
      "id": "ch04_s02_hanyuan.l39",
      "when": {
        "flag.liqinghe_won": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch04_s02_hanyuan.l40",
      "who": "empty",
      "kind": "aside",
      "text": "帷幔下摆离地半寸，光从底下穿过，落在空着的砖面上。",
      "image": "e39_ch04_s02_l40"
    },
    {
      "id": "ch04_s02_hanyuan.l41",
      "who": "narr",
      "kind": "aside",
      "text": "宋把取药的凭收好，没有留下来等一场掌声。"
    }
  ],
  "dressing": "gongyi",
  "choices": [
    {
      "id": "ch04_s02_hanyuan.cA",
      "text": "把反对原话与我的答复一起存",
      "require": {
        "flag.enthroned": true
      },
      "effects": {
        "flag.ch04_dissent_keep_order": true,
        "flag.ch04_dissent_remove_order": false
      },
      "irreversible": false,
      "goto": "ch04_s03_shuge"
    },
    {
      "id": "ch04_s02_hanyuan.cB",
      "text": "议录只留我答的，反对原话另存",
      "require": {
        "flag.enthroned": true
      },
      "effects": {
        "flag.ch04_dissent_keep_order": false,
        "flag.ch04_dissent_remove_order": true
      },
      "irreversible": false,
      "goto": "ch04_s03_shuge"
    },
    {
      "id": "ch04_s02_hanyuan.cC",
      "text": "交自己的意见，取一份留存",
      "require": {
        "flag.enthroned": false
      },
      "effects": {},
      "irreversible": false,
      "goto": "ch04_s08_shuge"
    }
  ]
}
