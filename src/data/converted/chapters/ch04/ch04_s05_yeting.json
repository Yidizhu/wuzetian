{
  "id": "ch04_s05_yeting",
  "chapter": 4,
  "act": 4,
  "scene": "yeting",
  "palette": "ink",
  "cast": [
    "wuze",
    "tangjian",
    "songhuizhen",
    "adi",
    "shenheng",
    "peizhaoye",
    "wenqiao",
    "liqinghe"
  ],
  "require": {
    "flag.enthroned": true
  },
  "weightless": false,
  "leavesLetter": [],
  "purpose": "付清这批劳动并展示复核如何实际运行",
  "lines": [
    {
      "id": "ch04_s05_yeting.l1",
      "who": "narr",
      "kind": "aside",
      "text": "照料凭据的办法颁下了，你到掖庭查钱是否到了本人手里。"
    },
    {
      "id": "ch04_s05_yeting.l2",
      "who": "narr",
      "kind": "aside",
      "text": "数日后，掖庭晾起洗过的布，湿气贴着廊柱。阿荻把钱一枚枚分开。"
    },
    {
      "id": "ch04_s05_yeting.l3",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "够了，我收。"
    },
    {
      "id": "ch04_s05_yeting.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "亲手点过就好。"
    },
    {
      "id": "ch04_s05_yeting.l5",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "还留这边做么？"
    },
    {
      "id": "ch04_s05_yeting.l6",
      "who": "adi",
      "expr": "default",
      "kind": "say",
      "text": "那边定了，今日只领钱。"
    },
    {
      "id": "ch04_s05_yeting.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不另算你今日来做工。"
    },
    {
      "id": "ch04_s05_yeting.l8",
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "还赶得上饭，别拿稿叫她顺路。"
    },
    {
      "id": "ch04_s05_yeting.l9",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "代班、查旧欠款和观里的工钱，各有领到的凭据。没付的另列。"
    },
    {
      "id": "ch04_s05_yeting.l10",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "没付的不能写成结清。"
    },
    {
      "id": "ch04_s05_yeting.l11",
      "who": "narr",
      "kind": "aside",
      "text": "阿荻提起自己的布包，走到门口，又回身拿走漏下的针。"
    },
    {
      "id": "ch04_s05_yeting.l12",
      "when": {
        "flag.ch04_contract_registration": true
      },
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "两人一起入册的来件，官署收了。我这第二个名字，等她自己答。"
    },
    {
      "id": "ch04_s05_yeting.l13",
      "when": {
        "flag.ch04_contract_registration": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "别让旁人替填。"
    },
    {
      "id": "ch04_s05_yeting.l14",
      "when": {
        "flag.ch04_separate_authorization": true
      },
      "who": "songhuizhen",
      "expr": "default",
      "kind": "say",
      "text": "我给的照料凭据，官署收了。她肯给哪些，另由她定，我不代签。"
    },
    {
      "id": "ch04_s05_yeting.l15",
      "when": {
        "flag.ch04_separate_authorization": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "等她自己来。"
    },
    {
      "id": "ch04_s05_yeting.l16",
      "when": {
        "flag.ch04_dissent_retained": true,
        "flag.ch04_originals_retained": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "她获准查原案，找出了漏字。更正已附上，谁答的也署了名。"
    },
    {
      "id": "ch04_s05_yeting.l17",
      "when": {
        "flag.ch04_dissent_retained": true,
        "flag.ch04_originals_retained": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "把改前改后放在一起。"
    },
    {
      "id": "ch04_s05_yeting.l18",
      "when": {
        "flag.ch04_dissent_retained": true,
        "flag.ch04_originals_retained": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "原摘要也留，叫人知道改哪笔。"
    },
    {
      "id": "ch04_s05_yeting.l19",
      "when": {
        "flag.ch04_dissent_retained": false
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "议录里只找得到你的答复。多付查卷的钱，也补不回这里缺的原问。"
    },
    {
      "id": "ch04_s05_yeting.l20",
      "when": {
        "flag.ch04_dissent_retained": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "是我准许移出的。"
    },
    {
      "id": "ch04_s05_yeting.l21",
      "when": {
        "flag.ch04_dissent_retained": true,
        "flag.ch04_originals_retained": false
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "反对的话还在，可原稿烧了。只能记漏过字，不能再验原来的笔迹。"
    },
    {
      "id": "ch04_s05_yeting.l22",
      "when": {
        "flag.ch04_dissent_retained": true,
        "flag.ch04_originals_retained": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "只能留着这个缺处。"
    }
  ],
  "goto": "ch04_s05p_shuge"
}
