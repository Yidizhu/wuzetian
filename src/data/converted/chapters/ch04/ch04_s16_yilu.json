{
  "id": "ch04_s16_yilu",
  "chapter": 4,
  "act": 4,
  "scene": "yilu",
  "palette": "ink",
  "cast": [
    "wuze",
    "peizhaoye"
  ],
  "require": {
    "flag.road_agreement": true
  },
  "weightless": false,
  "leavesLetter": [],
  "purpose": "在真实差程中相见，按各自归期离开",
  "lines": [
    {
      "id": "ch04_s16_yilu.l1",
      "who": "narr",
      "kind": "aside",
      "text": "旬日后驿旁起了风，树下的尘打在靴上，裴蹲着倒出鞋里的细砂。"
    },
    {
      "id": "ch04_s16_yilu.l2",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "还没倒完？"
    },
    {
      "id": "ch04_s16_yilu.l3",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "有一粒不肯走。"
    },
    {
      "id": "ch04_s16_yilu.l4",
      "who": "narr",
      "kind": "aside",
      "text": "她敲敲靴跟，你坐在自己的行囊上，翻出粮户那张凭。"
    },
    {
      "id": "ch04_s16_yilu.l5",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "这笔垫的钱，军里认么？"
    },
    {
      "id": "ch04_s16_yilu.l6",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "认借过。谁叫她先垫的，另问。"
    },
    {
      "id": "ch04_s16_yilu.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "已领栏空着，她说至今没拿到。不能见你这里写了支出，就叫她回去等。"
    },
    {
      "id": "ch04_s16_yilu.l8",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "把支出经手抄给她。我也追，不能把我追过了当她已经领过。"
    },
    {
      "id": "ch04_s16_yilu.l9",
      "who": "narr",
      "kind": "aside",
      "text": "你将原凭收好，裴把空靴口递过来，让你看那粒砂。"
    },
    {
      "id": "ch04_s16_yilu.l10",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "出来了。"
    },
    {
      "id": "ch04_s16_yilu.l11",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "那就穿。"
    },
    {
      "id": "ch04_s16_yilu.l12",
      "who": "narr",
      "kind": "aside",
      "text": "你笑着将靴推回她膝边，没有替她把整段路穿好。"
    },
    {
      "id": "ch04_s16_yilu.l13",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "归期呢？"
    },
    {
      "id": "ch04_s16_yilu.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "一月满便回京，休整的日子也照约领。我不等你那边打完这一段再问。"
    },
    {
      "id": "ch04_s16_yilu.l15",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "我还在路上。信照驿程寄，晚了也别赶着补回那一夜。"
    },
    {
      "id": "ch04_s16_yilu.l16",
      "who": "narr",
      "kind": "aside",
      "text": "到了约定归日，你带着核过与仍待核的两摞凭，沿自己的差程回京。"
    }
  ],
  "dressing": "yipang",
  "goto": "ch04_s17_nvguan"
}
