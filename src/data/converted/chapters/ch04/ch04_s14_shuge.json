{
  "id": "ch04_s14_shuge",
  "chapter": 4,
  "act": 4,
  "scene": "shuge",
  "palette": "ink",
  "cast": [
    "wuze",
    "tangjian",
    "peizhaoye"
  ],
  "require": {
    "flag.liqinghe_won": true
  },
  "weightless": false,
  "leavesLetter": [],
  "purpose": "夜间核定独立差程与归期",
  "lines": [
    {
      "id": "ch04_s14_shuge.l1",
      "who": "narr",
      "kind": "aside",
      "text": "手边的纸收妥后，当夜你在书阁问差牒。"
    },
    {
      "id": "ch04_s14_shuge.l2",
      "who": "narr",
      "kind": "aside",
      "text": "书阁夜灯照着刚递来的差牒，窗下冷，裴把湿靴留在席外。"
    },
    {
      "id": "ch04_s14_shuge.l3",
      "when": {
        "flag.ch03_consider_road": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "独立差程按一月核俸给了，归期在前。"
    },
    {
      "id": "ch04_s14_shuge.l4",
      "when": {
        "flag.ch03_consider_road": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "一月。"
    },
    {
      "id": "ch04_s14_shuge.l5",
      "when": {
        "flag.ch03_consider_road": false
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "先看一月俸给，再看归期。"
    },
    {
      "id": "ch04_s14_shuge.l6",
      "when": {
        "flag.ch03_consider_road": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "归期。"
    },
    {
      "id": "ch04_s14_shuge.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "凭什么收我？"
    },
    {
      "id": "ch04_s14_shuge.l8",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "公开收人，经办、错办都核了，一月试差。"
    },
    {
      "id": "ch04_s14_shuge.l9",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "错办也核了。"
    },
    {
      "id": "ch04_s14_shuge.l10",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "不借荐名改职。"
    },
    {
      "id": "ch04_s14_shuge.l11",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "我只核交接，不从军里给你位置。"
    },
    {
      "id": "ch04_s14_shuge.l12",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "交接。"
    },
    {
      "id": "ch04_s14_shuge.l13",
      "who": "narr",
      "kind": "aside",
      "text": "唐用指背压住归期，纸的硬边擦过你掌心。"
    },
    {
      "id": "ch04_s14_shuge.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "核不清的，我——"
    },
    {
      "id": "ch04_s14_shuge.l15",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "照报未核。"
    },
    {
      "id": "ch04_s14_shuge.l16",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "未核。"
    },
    {
      "id": "ch04_s14_shuge.l17",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "带回原凭，不能减未领，也不能添已领。"
    },
    {
      "id": "ch04_s14_shuge.l18",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "车先走，我另一路，照你的归期回，别等我叫。"
    },
    {
      "id": "ch04_s14_shuge.l19",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch04_s14_shuge.l20",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "路费先领？"
    },
    {
      "id": "ch04_s14_shuge.l21",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "明早领，另给月俸凭，少一项就别走。"
    },
    {
      "id": "ch04_s14_shuge.l22",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "少一项。"
    },
    {
      "id": "ch04_s14_shuge.l23",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "不能出了门再求人垫。"
    },
    {
      "id": "ch04_s14_shuge.l24",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "一月后……回京歇几日。"
    },
    {
      "id": "ch04_s14_shuge.l25",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "写上，别写等我方便。"
    },
    {
      "id": "ch04_s14_shuge.l26",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch04_s14_shuge.l27",
      "who": "narr",
      "kind": "aside",
      "text": "你把归期读了第二遍，将那一行折在最外面。"
    }
  ],
  "choices": [
    {
      "id": "ch04_s14_shuge.cA",
      "text": "接这一月的差，明早领款",
      "effects": {
        "flag.ch04_road_contract": true
      },
      "irreversible": false,
      "goto": "ch04_s15_yilu"
    },
    {
      "id": "ch04_s14_shuge.cB",
      "text": "这回不接，归期的纸我留着",
      "effects": {
        "flag.ch04_road_contract": false
      },
      "irreversible": false,
      "goto": "ch04_s10_yuanye"
    }
  ]
}
