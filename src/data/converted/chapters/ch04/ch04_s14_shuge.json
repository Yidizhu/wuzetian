{
  "id": "ch04_s14_shuge",
  "chapter": 4,
  "act": 4,
  "scene": "shuge",
  "palette": "ink",
  "cast": [
    "wuze",
    "tangjian",
    "peizhaoye"
  ],
  "require": {
    "flag.liqinghe_won": true
  },
  "weightless": false,
  "leavesLetter": [],
  "purpose": "夜间核定独立差程与归期",
  "lines": [
    {
      "id": "ch04_s14_shuge.l1",
      "who": "narr",
      "kind": "aside",
      "text": "手边的纸收妥，当夜你到书阁问那份外出查粮的差事。"
    },
    {
      "id": "ch04_s14_shuge.l2",
      "who": "narr",
      "kind": "aside",
      "text": "书阁夜灯照着刚送来的差事文书。窗下冷，裴把湿靴留在席外。"
    },
    {
      "id": "ch04_s14_shuge.l3",
      "when": {
        "flag.ch03_consider_road": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "你问的那份差，俸钱按一月算好了。先看何时回来。"
    },
    {
      "id": "ch04_s14_shuge.l4",
      "when": {
        "flag.ch03_consider_road": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "只接这一月。"
    },
    {
      "id": "ch04_s14_shuge.l5",
      "when": {
        "flag.ch03_consider_road": false
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "先看这一月有多少俸钱，再看何时回来。"
    },
    {
      "id": "ch04_s14_shuge.l6",
      "when": {
        "flag.ch03_consider_road": false
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "回来的日子得先定。"
    },
    {
      "id": "ch04_s14_shuge.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "凭什么收我？"
    },
    {
      "id": "ch04_s14_shuge.l8",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "这回公开招人。你办过的、办错的都查了，先试做一月。"
    },
    {
      "id": "ch04_s14_shuge.l9",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "没把错办的藏起来。"
    },
    {
      "id": "ch04_s14_shuge.l10",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "也没借谁举荐，替你换个官职。"
    },
    {
      "id": "ch04_s14_shuge.l11",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "我只核交接，不从军里给你位置。"
    },
    {
      "id": "ch04_s14_shuge.l12",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我的差事，另外来领。"
    },
    {
      "id": "ch04_s14_shuge.l13",
      "who": "narr",
      "kind": "aside",
      "text": "唐用指背压住归期，纸的硬边擦过你掌心。"
    },
    {
      "id": "ch04_s14_shuge.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "核不清的，我——"
    },
    {
      "id": "ch04_s14_shuge.l15",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "没查清就报没查清。"
    },
    {
      "id": "ch04_s14_shuge.l16",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不能先写齐了。"
    },
    {
      "id": "ch04_s14_shuge.l17",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "原始凭据带回来。没领到的不能划掉，也不能替她填成领了。"
    },
    {
      "id": "ch04_s14_shuge.l18",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "车先走，我另一路，照你的归期回，别等我叫。"
    },
    {
      "id": "ch04_s14_shuge.l19",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch04_s14_shuge.l20",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "路费先领？"
    },
    {
      "id": "ch04_s14_shuge.l21",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "明早领。另给领月俸的凭据，少一样都别走。"
    },
    {
      "id": "ch04_s14_shuge.l22",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "两样到手再动身。"
    },
    {
      "id": "ch04_s14_shuge.l23",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "不能出了门再求人垫。"
    },
    {
      "id": "ch04_s14_shuge.l24",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "一月后……回京歇几日。"
    },
    {
      "id": "ch04_s14_shuge.l25",
      "who": "peizhaoye",
      "expr": "default",
      "kind": "say",
      "text": "写上，别写等我方便。"
    },
    {
      "id": "ch04_s14_shuge.l26",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch04_s14_shuge.l27",
      "who": "narr",
      "kind": "aside",
      "text": "你把归期读了第二遍，将那一行折在最外面。"
    }
  ],
  "choices": [
    {
      "id": "ch04_s14_shuge.cA",
      "text": "接这一月的差，明早领款",
      "effects": {
        "flag.ch04_road_contract": true
      },
      "irreversible": false,
      "goto": "ch04_s15_yilu"
    },
    {
      "id": "ch04_s14_shuge.cB",
      "text": "这回不接，归期的纸我留着",
      "effects": {
        "flag.ch04_road_contract": false
      },
      "irreversible": false,
      "goto": "ch04_s10_yuanye"
    }
  ]
}
