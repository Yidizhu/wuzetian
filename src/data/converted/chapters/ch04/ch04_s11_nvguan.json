      "goto": "ch04_s12_nvguan"
    },
    {
      "id": "ch04_s11_nvguan.cB",
      "text": "这回先不接",
      "effects": {
        "flag.ch04_school_contract": false
      },
      "irreversible": false,
      "goto": "ch04_s10_yuanye"
    },
    {
      "id": "ch04_s11_nvguan.cC",
      "text": "追问无人来时怎样付钱",
      "require": {
        "cai": {
          "gte": 6
        },
