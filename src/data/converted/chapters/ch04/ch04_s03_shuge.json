{
  "id": "ch04_s03_shuge",
  "chapter": 4,
  "act": 4,
  "scene": "shuge",
  "palette": "gold",
  "cast": [
    "wuze",
    "shenheng",
    "tangjian"
  ],
  "require": {
    "flag.enthroned": true
  },
  "weightless": false,
  "leavesLetter": [],
  "purpose": "兑现异议处置，决定原案归存或不可恢复的焚毁",
  "lines": [
    {
      "id": "ch04_s03_shuge.l1",
      "who": "narr",
      "kind": "aside",
      "text": "宋收走取药凭之后，你回书阁看原案。"
    },
    {
      "id": "ch04_s03_shuge.l2",
      "who": "narr",
      "kind": "aside",
      "text": "书阁窗纸透着午后光，麻纸在两人之间卷起毛边。"
    },
    {
      "id": "ch04_s03_shuge.l3",
      "when": {
        "flag.ch04_dissent_keep_order": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "反对原话附进议录了，谁收的也署了名。三日办不完，要书面告知延期。"
    },
    {
      "id": "ch04_s03_shuge.l4",
      "when": {
        "flag.ch04_dissent_keep_order": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "到期没答，不能就不出声了。"
    },
    {
      "id": "ch04_s03_shuge.l5",
      "when": {
        "flag.ch04_dissent_remove_order": true
      },
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "照你定的，议录只留答复，反对原稿另收。记明是你准许移出的。"
    },
    {
      "id": "ch04_s03_shuge.l6",
      "when": {
        "flag.ch04_dissent_remove_order": true
      },
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我准的。"
    },
    {
      "id": "ch04_s03_shuge.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "原案呢？"
    },
    {
      "id": "ch04_s03_shuge.l8",
      "who": "narr",
      "kind": "aside",
      "text": "沈将摘要往旁边推，让出底下的一页。"
    },
    {
      "id": "ch04_s03_shuge.l9",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "这里只抄她认了经手。后面还写着：不认替我定过的事。"
    },
    {
      "id": "ch04_s03_shuge.l10",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "后面还有八个字。"
    },
    {
      "id": "ch04_s03_shuge.l11",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "那八字不在摘要里。"
    },
    {
      "id": "ch04_s03_shuge.l12",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "不在。"
    },
    {
      "id": "ch04_s03_shuge.l13",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "全留，就得付看守、查卷的工钱。谁许看、每回谁拿过，都要记。"
    },
    {
      "id": "ch04_s03_shuge.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch04_s03_shuge.l15",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "只存摘要，会快……"
    },
    {
      "id": "ch04_s03_shuge.l16",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "会。"
    },
    {
      "id": "ch04_s03_shuge.l17",
      "who": "narr",
      "kind": "aside",
      "text": "她将缺了八字的那一处摊平，没有把手交给你。"
    },
    {
      "id": "ch04_s03_shuge.l18",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "烧了就只剩我记得，记性不能替所有人作证。"
    },
    {
      "id": "ch04_s03_shuge.l19",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "但纸上的原字，再也对不到了。"
    },
    {
      "id": "ch04_s03_shuge.l20",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "已经抄出的呢？"
    },
    {
      "id": "ch04_s03_shuge.l21",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "抄件能留下，错漏也会留下。原稿烧了，不能保证补得回来。"
    },
    {
      "id": "ch04_s03_shuge.l22",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我能——"
    },
    {
      "id": "ch04_s03_shuge.l23",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "我反对。"
    },
    {
      "id": "ch04_s03_shuge.l24",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch04_s03_shuge.l25",
      "who": "shenheng",
      "expr": "default",
      "kind": "say",
      "text": "真烧了，我交清差事辞署，也不把留下的抄件当全本查。"
    },
    {
      "id": "ch04_s03_shuge.l26",
      "who": "self",
      "kind": "inner",
      "text": "（快。干净。她把那八个字又露出来。）"
    },
    {
      "id": "ch04_s03_shuge.l27",
      "who": "narr",
      "kind": "aside",
      "text": "罩灯没有挪近纸。唐在门边等你亲口说定。"
    },
    {
      "id": "ch04_s03_shuge.l28",
      "who": "narr",
      "kind": "aside",
      "text": "你看沈衡按着那页纸，罩灯还在原处，门边露着唐的衣角。",
      "image": "wuze_huian"
    },
    {
      "id": "ch04_s03_shuge.l29",
      "who": "self",
      "kind": "inner",
      "text": "（她的手还压着。我却先看了灯。）"
    }
  ],
  "choices": [
    {
      "id": "ch04_s03_shuge.cA",
      "text": "保存原件，按准许的范围查阅",
