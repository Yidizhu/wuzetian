{
  "id": "ch04_s07_hanyuan",
  "chapter": 4,
  "act": 4,
  "scene": "hanyuan",
  "palette": "gold",
  "cast": [
    "wuze",
    "tangjian",
    "liqinghe"
  ],
  "require": {
    "flag.enthroned": true
  },
  "weightless": false,
  "leavesLetter": [],
  "purpose": "把下一轮提名交多方或收在一人手里",
  "lines": [
    {
      "id": "ch04_s07_hanyuan.l1",
      "who": "narr",
      "kind": "aside",
      "text": "灯油熬过一夜，早朝你又走上龙尾道。"
    },
    {
      "id": "ch04_s07_hanyuan.l2",
      "who": "narr",
      "kind": "aside",
      "text": "早朝的风吹过龙尾道，殿门外两份荐牒用同一块石压着。"
    },
    {
      "id": "ch04_s07_hanyuan.l3",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "定下一轮从哪儿收荐。"
    },
    {
      "id": "ch04_s07_hanyuan.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "下一轮。"
    },
    {
      "id": "ch04_s07_hanyuan.l5",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "门外是哪两份？"
    },
    {
      "id": "ch04_s07_hanyuan.l6",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "一份旧署荐名，一份外郡来，核验齐了。"
    },
    {
      "id": "ch04_s07_hanyuan.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "外郡。"
    },
    {
      "id": "ch04_s07_hanyuan.l8",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "没求过你私允。"
    },
    {
      "id": "ch04_s07_hanyuan.l9",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "多处能荐，就得留核验、回避、异议的时辰。"
    },
    {
      "id": "ch04_s07_hanyuan.l10",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch04_s07_hanyuan.l11",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "不能准了却没人收件。"
    },
    {
      "id": "ch04_s07_hanyuan.l12",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "人工从扩办款——"
    },
    {
      "id": "ch04_s07_hanyuan.l13",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "列过了。"
    },
    {
      "id": "ch04_s07_hanyuan.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "列过。"
    },
    {
      "id": "ch04_s07_hanyuan.l15",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "多方能荐就少开一署，先付核验人。"
    },
    {
      "id": "ch04_s07_hanyuan.l16",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "全由你荐是快些，外郡那人却连递的由头都没了。"
    },
    {
      "id": "ch04_s07_hanyuan.l17",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch04_s07_hanyuan.l18",
      "who": "narr",
      "kind": "aside",
      "text": "她把自己的名字从荐牒旁挪开，只留那份没求过私允的纸。"
    },
    {
      "id": "ch04_s07_hanyuan.l19",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我也可以……亲自荐她。"
    },
    {
      "id": "ch04_s07_hanyuan.l20",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "这回可以，下一回不能都靠你记得这一个。"
    },
    {
      "id": "ch04_s07_hanyuan.l21",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "下一回。"
    },
    {
      "id": "ch04_s07_hanyuan.l22",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "两法拟全了，颁行后照条收退，不能只写不问宗姓。"
    },
    {
      "id": "ch04_s07_hanyuan.l23",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch04_s07_hanyuan.l24",
      "who": "self",
      "kind": "inner",
      "text": "（把这一份挑进来，很容易。）"
    },
    {
      "id": "ch04_s07_hanyuan.l25",
      "who": "narr",
      "kind": "aside",
      "text": "你扶住案角，石下的两张纸一齐抖动。"
    },
    {
      "id": "ch04_s07_hanyuan.l26",
      "who": "narr",
      "kind": "aside",
      "text": "你将荐牒留在案上，等着答下一轮。"
    }
  ],
  "dressing": "gongyi",
  "choices": [
    {
      "id": "ch04_s07_hanyuan.cA",
      "text": "颁行多方提名与异议办法",
