{
  "id": "ch04_s07_hanyuan",
  "chapter": 4,
  "act": 4,
  "scene": "hanyuan",
  "palette": "gold",
  "cast": [
    "wuze",
    "tangjian",
    "liqinghe"
  ],
  "require": {
    "flag.enthroned": true
  },
  "weightless": false,
  "leavesLetter": [],
  "purpose": "把下一轮提名交多方或收在一人手里",
  "lines": [
    {
      "id": "ch04_s07_hanyuan.l1",
      "who": "narr",
      "kind": "aside",
      "text": "灯油熬过一夜，早朝你又走上龙尾道。"
    },
    {
      "id": "ch04_s07_hanyuan.l2",
      "who": "narr",
      "kind": "aside",
      "text": "早朝的风吹过龙尾道。殿门外，两份举荐的文书用同一块石压着。",
      "image": "e39_ch04_s07_l2"
    },
    {
      "id": "ch04_s07_hanyuan.l3",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "下一轮要从哪些地方收荐书，得定下来。"
    },
    {
      "id": "ch04_s07_hanyuan.l4",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不能只管我们这一回。"
    },
    {
      "id": "ch04_s07_hanyuan.l5",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "门外是哪两份？"
    },
    {
      "id": "ch04_s07_hanyuan.l6",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "一份是原来官署荐的，一份从外郡来，都查验齐了。"
    },
    {
      "id": "ch04_s07_hanyuan.l7",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "外郡那位，可曾找人来求？"
    },
    {
      "id": "ch04_s07_hanyuan.l8",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "没求过你私允。"
    },
    {
      "id": "ch04_s07_hanyuan.l9",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "让多处都能荐人，就得留足时辰，查凭据、避亲故，也听反对的话。"
    },
    {
      "id": "ch04_s07_hanyuan.l10",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "嗯。"
    },
    {
      "id": "ch04_s07_hanyuan.l11",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "不能准了却没人收件。"
    },
    {
      "id": "ch04_s07_hanyuan.l12",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "人工从扩办款——"
    },
    {
      "id": "ch04_s07_hanyuan.l13",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "列过了。"
    },
    {
      "id": "ch04_s07_hanyuan.l14",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "够用么？"
    },
    {
      "id": "ch04_s07_hanyuan.l15",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "若许多处荐人，就少开一处新署，把钱先付给查证的人。"
    },
    {
      "id": "ch04_s07_hanyuan.l16",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "只许你荐，确实快。可外郡那人，连递这份荐书的资格都没了。"
    },
    {
      "id": "ch04_s07_hanyuan.l17",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "……"
    },
    {
      "id": "ch04_s07_hanyuan.l18",
      "who": "narr",
      "kind": "aside",
      "text": "她把自己的名字从荐牒旁挪开，只留那份没求过私允的纸。"
    },
    {
      "id": "ch04_s07_hanyuan.l19",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "我也可以……亲自荐她。"
    },
    {
      "id": "ch04_s07_hanyuan.l20",
      "who": "liqinghe",
      "expr": "default",
      "kind": "say",
      "text": "这回可以，下一回不能都靠你记得这一个。"
    },
    {
      "id": "ch04_s07_hanyuan.l21",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "不能都等我记得。"
    },
    {
      "id": "ch04_s07_hanyuan.l22",
      "who": "tangjian",
      "expr": "default",
      "kind": "say",
      "text": "两种办法都拟好了。颁下后收谁、退谁，都照办，不能只说不限宗姓。"
    },
    {
      "id": "ch04_s07_hanyuan.l23",
      "who": "wuze",
      "expr": "default",
      "kind": "say",
      "text": "好。"
    },
    {
      "id": "ch04_s07_hanyuan.l24",
      "who": "self",
      "kind": "inner",
      "text": "（把这一份挑进来，很容易。）"
    },
    {
      "id": "ch04_s07_hanyuan.l25",
      "who": "narr",
      "kind": "aside",
      "text": "你扶住案角，石下的两张纸一齐抖动。"
    },
    {
      "id": "ch04_s07_hanyuan.l26",
      "who": "narr",
      "kind": "aside",
      "text": "你把荐书留在案上，等着决定下一轮从哪里收人。"
    }
  ],
  "dressing": "gongyi",
  "choices": [
    {
      "id": "ch04_s07_hanyuan.cA",
      "text": "许多处荐人，并收反对的话",
      "effects": {
        "flag.ch04_nomination_open_order": true,
        "flag.ch04_nomination_closed_order": false
      },
      "irreversible": false,
      "goto": "ch04_s17_nvguan"
    },
    {
      "id": "ch04_s07_hanyuan.cB",
      "text": "只许在位者荐人",
      "effects": {
        "flag.ch04_nomination_open_order": false,
        "flag.ch04_nomination_closed_order": true
      },
      "irreversible": false,
      "goto": "ch04_s17_nvguan"
    }
  ]
}
