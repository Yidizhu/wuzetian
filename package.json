{
  "name": "wuzetian",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run validate && npm test && npm run smoke && tsc --noEmit && vite build && npm run check:bundle",
    "preview": "vite preview --host",
    "validate": "node --experimental-strip-types tools/validate-story.ts",
    "validate:demo": "node --experimental-strip-types tools/validate-story.ts tools/fixtures/broken",
    "graph": "node --experimental-strip-types tools/story-graph.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:engine": "node --experimental-strip-types --test tests/engine.test.ts tests/savecode.test.ts tests/chapterend.test.ts tests/tap.test.ts tests/cues.test.ts",
    "build:artifact": "npm run build && node --experimental-strip-types tools/build-artifact.ts",
    "build:3d": "node --experimental-strip-types tools/build-3d.ts",
    "build:adult": "node --experimental-strip-types tools/build-adult.ts",
    "smoke": "node --experimental-strip-types tools/smoke-chapter.ts",
    "smoke:converted": "node --experimental-strip-types tools/smoke-chapter.ts converted",
    "build:web": "npm run validate && npm run test:engine && npm run smoke && tsc --noEmit && vite build && npm run check:bundle",
    "check:bundle": "node --experimental-strip-types tools/check-bundle.ts"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "three": "^0.170.0",
    "zod": "^3.25.76"
  }
}
