  "body": {
    "surface": "（占位信）门房今日换了人。你上回记下的那一位，调去了西边的库房。若要再看，须早些去。",
    "poem": { "ref": "xuetao_chan", "line": "声声似相接，各在一枝栖。" },
    "poemMeans": "她愿意继续相应，不要求对方先移到自己的枝上",
    "blank": "（她没写为什么要告诉我。库房的门是她管的。她把钥匙的事空着，等我自己去问。）"
  },
  "sheMayNotReply": { "affinity.shenheng": { "lt": 2 } },
