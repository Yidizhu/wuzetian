  "replies": {
    "plain": [
      { "id": "a", "text": "我明日去。钥匙的事，当面问你。", "effects": { "affinity.shenheng": 2 }, "reaction": "她把钥匙放在案角，没有递过来。" },
      { "id": "b", "text": "先谢你。库房的事我另有法子。", "effects": { "xin": 1 }, "reaction": "她没有再提库房。" },
      { "id": "c", "text": "不必告诉我这些。", "effects": { "affinity.shenheng": -1 }, "reaction": "此后她只写公文体。" }
